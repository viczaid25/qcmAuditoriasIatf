@page "/auditores/nuevo"
@page "/auditores/{auditorId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Catalogos
@using qcmAuditoriasIatf.Models.External
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="auditor-editor-loading">
        <div class="auditor-editor-skeleton auditor-editor-skeleton-hero"></div>
        <div class="auditor-editor-metrics">
            <div class="auditor-editor-skeleton auditor-editor-skeleton-card"></div>
            <div class="auditor-editor-skeleton auditor-editor-skeleton-card"></div>
            <div class="auditor-editor-skeleton auditor-editor-skeleton-card"></div>
            <div class="auditor-editor-skeleton auditor-editor-skeleton-card"></div>
        </div>
        <div class="auditor-editor-skeleton auditor-editor-skeleton-panel"></div>
        <div class="auditor-editor-skeleton auditor-editor-skeleton-panel"></div>
    </div>
}
else
{
    <div class="auditor-editor-page">
        <section class="editor-hero">
            <div>
                <span class="editor-kicker">Catálogo de auditores</span>
                <h1>@TituloPantalla</h1>

                <div class="editor-meta">
                    <span class="meta-chip">
                        Modo:
                        <strong>@(EsEdicion ? "Edición" : "Alta")</strong>
                    </span>

                    <span class="meta-chip">
                        Tipo:
                        <strong>@(string.IsNullOrWhiteSpace(vm.Tipo) ? "Sin capturar" : vm.Tipo)</strong>
                    </span>

                    <span class="meta-chip">
                        Estatus:
                        <strong>@(vm.Activo ? "Activo" : "Inactivo")</strong>
                    </span>

                    <span class="meta-chip">
                        Vinculado AD:
                        <strong>@(vm.MeaxUserId.HasValue ? "Sí" : "No")</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Registra nuevos auditores, observadores o personal en entrenamiento y, si aplica,
                    precarga sus datos desde <b>meax_all_user</b>.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button"
                        class="hero-btn"
                        @onclick='() => Nav.NavigateTo("auditores")'>
                    Volver al catálogo
                </button>
            </div>
        </section>

        <section class="auditor-editor-metrics">
            <div class="metric-card">
                <div class="metric-label">Tipo seleccionado</div>
                <div class="metric-value metric-text">@vm.Tipo</div>
                <div class="metric-note">Rol actual del registro</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">PC Login</div>
                <div class="metric-value metric-text">
                    @(string.IsNullOrWhiteSpace(vm.PcLoginId) ? "Sin capturar" : vm.PcLoginId)
                </div>
                <div class="metric-note">Identificador en red</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Correo</div>
                <div class="metric-value metric-text">
                    @(string.IsNullOrWhiteSpace(vm.Email) ? "Sin capturar" : vm.Email)
                </div>
                <div class="metric-note">Correo asociado</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Fuente</div>
                <div class="metric-value metric-text">
                    @(meaxUser is null ? "Manual" : "meax_all_user")
                </div>
                <div class="metric-note">Origen de los datos cargados</div>
            </div>
        </section>

        <div class="editor-grid">
            <section class="panel-card panel-main">
                <div class="panel-head">
                    <div>
                        <h2>Precargar desde meax_all_user</h2>
                        <p class="panel-subtitle">
                            Busca por PC Login ID, correo o nombre para traer información del usuario y llenar el formulario.
                        </p>
                    </div>

                    <span class="panel-badge">Máx. 25 resultados</span>
                </div>

                <EditForm Model="lookupVm" OnValidSubmit="BuscarUsuario">
                    <DataAnnotationsValidator />

                    <div class="row g-3 align-items-end">
                        <div class="col-lg-9">
                            <label class="form-label">Buscar usuario</label>
                            <InputText class="mo-form-control"
                                       @bind-Value="lookupVm.Query"
                                       placeholder="Ej. DM45207, nombre o correo" />
                            <div class="field-help">
                                Puedes buscar por <b>PC Login ID</b>, <b>Email</b> o <b>Nombre</b>.
                            </div>
                        </div>

                        <div class="col-lg-3">
                            <button type="submit" class="mo-btn mo-btn-primary w-100" disabled="@buscando">
                                @(buscando ? "Buscando..." : "Buscar")
                            </button>
                        </div>
                    </div>
                </EditForm>

                @if (resultados.Count > 0)
                {
                    <div class="results-wrap">
                        <div class="results-head">
                            Resultados encontrados: <b>@resultados.Count</b>
                        </div>

                        <div class="mo-table-wrap" data-mo-table data-page-size="10">
                            <table class="mo-table">
                                <thead>
                                    <tr>
                                        <th>PC Login</th>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th>Departamento</th>
                                        <th>Puesto</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                    <tr class="mo-table-filter-row">
                                        <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="4" placeholder="Filtrar…"></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in resultados)
                                    {
                                        <tr>
                                            <td>
                                                <span class="login-pill">@u.pc_login_id</span>
                                            </td>
                                            <td>
                                                <div class="cell-title">@(string.IsNullOrWhiteSpace(u.username) ? "Sin nombre" : u.username)</div>
                                            </td>
                                            <td>
                                                <div class="cell-subtitle">@(string.IsNullOrWhiteSpace(u.email) ? "Sin correo" : u.email)</div>
                                            </td>
                                            <td>
                                                @(string.IsNullOrWhiteSpace(u.department) ? u.dep_2 : u.department)
                                            </td>
                                            <td>
                                                @(string.IsNullOrWhiteSpace(u.position) ? "Sin puesto" : u.position)
                                            </td>
                                            <td class="text-end">
                                                <button type="button"
                                                        class="table-btn table-btn-success"
                                                        @onclick="() => SeleccionarUsuario(u)">
                                                    Usar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mo-table-pagination" data-mo-pagination></div>
                    </div>
                }
            </section>

            <section class="panel-card panel-side">
                <div class="panel-head">
                    <div>
                        <h2>Resumen</h2>
                        <p class="panel-subtitle">Información actual del registro que vas a guardar.</p>
                    </div>
                </div>

                <div class="summary-stack">
                    <div class="summary-item">
                        <span>Nombre</span>
                        <strong>@(string.IsNullOrWhiteSpace(vm.Nombre) ? "Sin capturar" : vm.Nombre)</strong>
                    </div>

                    <div class="summary-item">
                        <span>Tipo</span>
                        <strong>@vm.Tipo</strong>
                    </div>

                    <div class="summary-item">
                        <span>Departamento</span>
                        <strong>@(string.IsNullOrWhiteSpace(vm.Departamento) ? "Sin capturar" : vm.Departamento)</strong>
                    </div>

                    <div class="summary-item">
                        <span>Función</span>
                        <strong>@(string.IsNullOrWhiteSpace(vm.Funcion) ? "Sin capturar" : vm.Funcion)</strong>
                    </div>

                    <div class="summary-item">
                        <span>Email</span>
                        <strong>@(string.IsNullOrWhiteSpace(vm.Email) ? "Sin capturar" : vm.Email)</strong>
                    </div>

                    <div class="summary-item">
                        <span>PC Login ID</span>
                        <strong>@(string.IsNullOrWhiteSpace(vm.PcLoginId) ? "Sin capturar" : vm.PcLoginId)</strong>
                    </div>

                    <div class="summary-item">
                        <span>Estatus</span>
                        <strong>@(vm.Activo ? "Activo" : "Inactivo")</strong>
                    </div>
                </div>

                @if (meaxUser is not null)
                {
                    <div class="linked-user-card">
                        <div class="linked-user-label">Usuario seleccionado de AD</div>
                        <div class="linked-user-name">@GetNombreUsuario(meaxUser)</div>
                        <div class="linked-user-login">@meaxUser.pc_login_id</div>

                        <div class="linked-user-meta">
                            @(string.IsNullOrWhiteSpace(meaxUser.department) ? meaxUser.dep_2 : meaxUser.department)
                            @if (!string.IsNullOrWhiteSpace(meaxUser.position))
                            {
                                <span> | @meaxUser.position</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(meaxUser.email))
                        {
                            <div class="linked-user-meta">@meaxUser.email</div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state compact">
                        Aún no has seleccionado un usuario desde <b>meax_all_user</b>. Puedes capturar todo manualmente.
                    </div>
                }
            </section>
        </div>

        <EditForm Model="vm" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Datos del auditor</h2>
                        <p class="panel-subtitle">Captura o ajusta la información que quedará guardada en el catálogo.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <InputText class="mo-form-control" @bind-Value="vm.Nombre" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tipo</label>
                        <InputSelect class="mo-form-select" @bind-Value="vm.Tipo">
                            <option value="Auditor">Auditor</option>
                            <option value="Entrenamiento">Auditor en entrenamiento</option>
                            <option value="Observador">Observador</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Departamento</label>
                        <InputText class="mo-form-control" @bind-Value="vm.Departamento" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Función</label>
                        <InputText class="mo-form-control" @bind-Value="vm.Funcion" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="mo-form-control" @bind-Value="vm.Email" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">PC Login ID</label>
                        <InputText class="mo-form-control" @bind-Value="vm.PcLoginId" />
                    </div>

                    <div class="col-md-4">
                        <div class="status-check">
                            <InputCheckbox class="form-check-input" @bind-Value="vm.Activo" />
                            <label class="form-check-label">Activo</label>
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel-card action-panel">
                <div class="action-panel-inner">
                    <div>
                        <h2>Confirmación</h2>
                        <p class="panel-subtitle mb-0">
                            Guarda los cambios para actualizar el catálogo de auditores.
                        </p>
                    </div>

                    <div class="action-buttons">
                        <button class="mo-btn mo-btn-primary mo-btn-lg"
                                type="submit"
                                disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>

                        <button class="mo-btn mo-btn-secondary-outline mo-btn-lg"
                                type="button"
                                @onclick='() => Nav.NavigateTo("auditores")'
                                disabled="@guardando">
                            Volver
                        </button>
                    </div>
                </div>
            </section>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? auditorId { get; set; }

    private bool cargando = true;
    private bool guardando;
    private bool buscando;
    private string? errorMsg;

    private MeaxAllUser? meaxUser;
    private List<MeaxAllUser> resultados = new();

    private LookupVm lookupVm = new();
    private Vm vm = new();

    private bool EsEdicion => auditorId is not null;
    private string TituloPantalla => EsEdicion ? $"Editar auditor #{auditorId}" : "Nuevo auditor";

    private class LookupVm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Query { get; set; }
    }

    private class Vm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Nombre { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string Tipo { get; set; } = "Auditor";

        public string? Departamento { get; set; }
        public string? Funcion { get; set; }
        public string? Email { get; set; }
        public string? PcLoginId { get; set; }
        public bool Activo { get; set; } = true;

        public int? MeaxUserId { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;

        lookupVm = new();
        vm = new();
        resultados = new();
        meaxUser = null;

        try
        {
            if (auditorId is not null)
            {
                var a = await Db.Auditores
                    .AsNoTracking()
                    .FirstOrDefaultAsync(x => x.AuditorId == auditorId.Value);

                if (a is not null)
                {
                    vm.Nombre = a.Nombre;
                    vm.Tipo = a.Tipo;
                    vm.Departamento = a.Departamento;
                    vm.Funcion = a.Funcion;
                    vm.Email = a.Email;
                    vm.PcLoginId = a.PcLoginId;
                    vm.Activo = a.Activo;
                    vm.MeaxUserId = a.MeaxUserId;

                    lookupVm.Query = a.PcLoginId ?? a.Email ?? a.Nombre;

                    if (a.MeaxUserId.HasValue)
                    {
                        meaxUser = await Db.MeaxAllUsers
                            .AsNoTracking()
                            .FirstOrDefaultAsync(x => x.id == a.MeaxUserId.Value);
                    }
                }
                else
                {
                    errorMsg = "No se encontró el auditor solicitado.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarUsuario()
    {
        if (buscando) return;

        buscando = true;
        errorMsg = null;
        meaxUser = null;
        resultados.Clear();

        try
        {
            var q = (lookupVm.Query ?? "").Trim();

            if (string.IsNullOrWhiteSpace(q))
            {
                errorMsg = "Captura PC Login ID, Email o Nombre para buscar.";
                return;
            }

            resultados = await Db.MeaxAllUsers
                .AsNoTracking()
                .Where(u =>
                    u.pc_login_id.Contains(q) ||
                    (u.email != null && u.email.Contains(q)) ||
                    (u.username != null && u.username.Contains(q)))
                .OrderBy(u => u.username)
                .Take(25)
                .ToListAsync();

            if (resultados.Count == 0)
            {
                errorMsg = "No se encontró en meax_all_user.";
                return;
            }

            if (resultados.Count == 1)
            {
                SeleccionarUsuario(resultados[0]);
            }
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            buscando = false;
        }
    }

    private void SeleccionarUsuario(MeaxAllUser u)
    {
        meaxUser = u;
        lookupVm.Query = u.pc_login_id ?? u.email ?? u.username;

        vm.MeaxUserId = u.id;
        vm.Nombre = u.username ?? vm.Nombre;
        vm.Email = u.email ?? vm.Email;
        vm.Departamento = u.department ?? u.dep_2 ?? vm.Departamento;
        vm.Funcion = u.position ?? vm.Funcion;
        vm.PcLoginId = u.pc_login_id ?? vm.PcLoginId;
    }

    private async Task Guardar()
    {
        if (guardando) return;

        guardando = true;
        errorMsg = null;

        try
        {
            Auditor entity;

            if (auditorId is null)
            {
                entity = new Auditor();
                Db.Auditores.Add(entity);
            }
            else
            {
                entity = await Db.Auditores.FirstOrDefaultAsync(x => x.AuditorId == auditorId.Value)
                         ?? new Auditor();

                if (entity.AuditorId == 0)
                    Db.Auditores.Add(entity);
            }

            entity.Nombre = vm.Nombre.Trim();
            entity.Tipo = vm.Tipo;
            entity.Departamento = string.IsNullOrWhiteSpace(vm.Departamento) ? null : vm.Departamento.Trim();
            entity.Funcion = string.IsNullOrWhiteSpace(vm.Funcion) ? null : vm.Funcion.Trim();
            entity.Email = string.IsNullOrWhiteSpace(vm.Email) ? null : vm.Email.Trim();
            entity.PcLoginId = string.IsNullOrWhiteSpace(vm.PcLoginId) ? null : vm.PcLoginId.Trim();
            entity.MeaxUserId = vm.MeaxUserId;
            entity.Activo = vm.Activo;

            await Db.SaveChangesAsync();
            Nav.NavigateTo("auditores");
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private static string GetNombreUsuario(MeaxAllUser u) =>
        string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username!;
}