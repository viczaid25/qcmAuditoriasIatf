@page "/auditores"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Catalogos
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger" style="white-space:pre-wrap">@errorMsg</div>
}

@if (cargando)
{
    <div class="auditores-loading">
        <div class="auditores-skeleton auditores-skeleton-hero"></div>
        <div class="auditores-metrics">
            <div class="auditores-skeleton auditores-skeleton-card"></div>
            <div class="auditores-skeleton auditores-skeleton-card"></div>
            <div class="auditores-skeleton auditores-skeleton-card"></div>
            <div class="auditores-skeleton auditores-skeleton-card"></div>
        </div>
        <div class="auditores-skeleton auditores-skeleton-filters"></div>
        <div class="auditores-skeleton auditores-skeleton-table"></div>
    </div>
}
else
{
    <div class="auditores-page">
        <section class="auditores-hero">
            <div>
                <span class="auditores-kicker">Catálogo</span>
                <h1>Auditores</h1>

                <div class="auditores-meta">
                    <span class="meta-chip">
                        Total: <strong>@lista.Count</strong>
                    </span>

                    <span class="meta-chip">
                        Tipos: <strong>@TiposDisponibles.Count()</strong>
                    </span>

                    <span class="meta-chip">
                        Con PC Login: <strong>@lista.Count(x => !string.IsNullOrWhiteSpace(x.PcLoginId))</strong>
                    </span>

                    <span class="meta-chip">
                        Mostrando: <strong>@AuditoresFiltrados.Count()</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Administra el catálogo de auditores, observadores y personal en entrenamiento.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button"
                        class="hero-btn primary"
                        @onclick='() => Nav.NavigateTo("auditores/nuevo")'>
                    Nuevo auditor
                </button>
            </div>
        </section>

        @if (auditorPendienteEliminar is not null)
        {
            <div class="confirm-modal-backdrop">
                <section class="panel-card danger-panel confirm-modal-dialog">
                    <div class="panel-head">
                        <div>
                            <h2>Confirmar eliminación</h2>
                            <p class="panel-subtitle">
                                Esta acción eliminará el auditor del catálogo.
                            </p>
                        </div>

                        <span class="panel-badge danger">Pendiente</span>
                    </div>

                    <div class="confirm-box">
                        <div class="confirm-name">@auditorPendienteEliminar.Nombre</div>

                        <div class="confirm-meta">
                            <span>Tipo: <strong>@auditorPendienteEliminar.Tipo</strong></span>
                            <span>PC Login: <strong>@(string.IsNullOrWhiteSpace(auditorPendienteEliminar.PcLoginId) ? "Sin capturar" : auditorPendienteEliminar.PcLoginId)</strong></span>
                        </div>

                        <div class="confirm-warning">
                            Confirma solo si realmente deseas quitar este registro del catálogo.
                        </div>

                        <div class="confirm-actions">
                            <button type="button"
                                    class="mo-btn mo-btn-secondary-outline"
                                    @onclick="CancelarEliminar"
                                    disabled="@eliminando">
                                Cancelar
                            </button>

                            <button type="button"
                                    class="mo-btn mo-btn-danger"
                                    @onclick="EliminarAuditor"
                                    disabled="@eliminando">
                                @(eliminando ? "Eliminando..." : "Eliminar auditor")
                            </button>
                        </div>
                    </div>
                </section>
            </div>
        }

        <section class="auditores-metrics">
            <div class="metric-card">
                <div class="metric-label">Auditores</div>
                <div class="metric-value">@lista.Count(x => string.Equals(x.Tipo, "Auditor", StringComparison.OrdinalIgnoreCase))</div>
                <div class="metric-note">Perfil principal</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Entrenamiento</div>
                <div class="metric-value">@lista.Count(x => string.Equals(x.Tipo, "Entrenamiento", StringComparison.OrdinalIgnoreCase))</div>
                <div class="metric-note">En formación</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Observadores</div>
                <div class="metric-value">@lista.Count(x => string.Equals(x.Tipo, "Observador", StringComparison.OrdinalIgnoreCase))</div>
                <div class="metric-note">Apoyo en auditoría</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Con PC Login</div>
                <div class="metric-value">@lista.Count(x => !string.IsNullOrWhiteSpace(x.PcLoginId))</div>
                <div class="metric-note">Identificados en sistema</div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Filtros</h2>
                    <p class="panel-subtitle">Busca por nombre, correo, login, departamento o función.</p>
                </div>

                <span class="panel-badge">@AuditoresFiltrados.Count() resultado(s)</span>
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Buscar</label>
                    <input class="mo-form-control"
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           placeholder="Nombre, email, login, departamento..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Tipo</label>
                    <InputSelect class="mo-form-select" @bind-Value="tipoSeleccionado">
                        <option value="">-- Todos --</option>
                        @foreach (var tipo in TiposDisponibles)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="button"
                            class="mo-btn mo-btn-secondary-outline w-100"
                            @onclick="LimpiarFiltros">
                        Limpiar
                    </button>
                </div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Bandeja de auditores</h2>
                    <p class="panel-subtitle">Agrupados por tipo de auditor.</p>
                </div>

                <span class="panel-badge">@AuditoresFiltrados.Count() registro(s)</span>
            </div>

            @if (!AuditoresAgrupados.Any())
            {
                <div class="empty-state compact">
                    No hay auditores para los filtros seleccionados.
                </div>
            }
            else
            {
                @foreach (var grupo in AuditoresAgrupados)
                {
                    <div class="group-block" @key="grupo.Key">
                        <div class="panel-head group-head">
                            <div>
                                <h2>@grupo.Key</h2>
                                <p class="panel-subtitle">@DescripcionTipo(grupo.Key)</p>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <span class="tipo-pill @GetTipoClass(grupo.Key)">
                                    @grupo.Key
                                </span>
                                <span class="panel-badge">@grupo.Count() registro(s)</span>
                            </div>
                        </div>

                        <div class="mo-table-wrap" data-mo-table data-page-size="10">
                            <table class="mo-table">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Departamento</th>
                                        <th>Función</th>
                                        <th>PC Login</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                    <tr class="mo-table-filter-row">
                                        <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="Filtrar…"></th>
                                        <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="Filtrar…"></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in grupo.OrderBy(x => x.Nombre))
                                    {
                                        <tr @key="a.AuditorId">
                                            <td>
                                                <div class="cell-title">@a.Nombre</div>

                                                @if (!string.IsNullOrWhiteSpace(a.Email))
                                                {
                                                    <div class="cell-subtitle">@a.Email</div>
                                                }
                                            </td>

                                            <td>
                                                @if (string.IsNullOrWhiteSpace(a.Departamento))
                                                {
                                                    <span class="empty-inline">Sin capturar</span>
                                                }
                                                else
                                                {
                                                    <span>@a.Departamento</span>
                                                }
                                            </td>

                                            <td>
                                                @if (string.IsNullOrWhiteSpace(a.Funcion))
                                                {
                                                    <span class="empty-inline">Sin capturar</span>
                                                }
                                                else
                                                {
                                                    <span>@a.Funcion</span>
                                                }
                                            </td>

                                            <td>
                                                @if (string.IsNullOrWhiteSpace(a.PcLoginId))
                                                {
                                                    <span class="empty-inline">Sin PC Login</span>
                                                }
                                                else
                                                {
                                                    <span class="login-pill">@a.PcLoginId</span>
                                                }
                                            </td>

                                            <td class="text-end">
                                                <div class="action-stack">
                                                    <button type="button"
                                                            class="table-btn"
                                                            @onclick='() => Nav.NavigateTo($"auditores/{a.AuditorId}")'>
                                                        Editar
                                                    </button>

                                                    <button type="button"
                                                            class="table-btn table-btn-danger"
                                                            @onclick="() => PrepararEliminar(a)">
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mo-table-pagination" data-mo-pagination></div>
                    </div>
                }
            }
        </section>
    </div>
}

@code {
    private bool cargando = true;
    private bool eliminando;
    private string? errorMsg;

    private string textoBusqueda = "";
    private string tipoSeleccionado = "";

    private Auditor? auditorPendienteEliminar;
    private List<Auditor> lista = new();

    private IEnumerable<string> TiposDisponibles =>
        lista.Select(x => x.Tipo)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => OrdenTipo(x))
            .ThenBy(x => x);

    private IEnumerable<Auditor> AuditoresFiltrados =>
        lista
            .Where(CumpleFiltroBusqueda)
            .Where(CumpleFiltroTipo)
            .OrderBy(x => OrdenTipo(x.Tipo))
            .ThenBy(x => x.Nombre);

    private IEnumerable<IGrouping<string, Auditor>> AuditoresAgrupados =>
        AuditoresFiltrados
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Tipo) ? "Sin tipo" : x.Tipo.Trim())
            .OrderBy(x => OrdenTipo(x.Key))
            .ThenBy(x => x.Key);

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            lista = await Db.Auditores
                .AsNoTracking()
                .OrderBy(x => x.Tipo)
                .ThenBy(x => x.Nombre)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private bool CumpleFiltroBusqueda(Auditor a)
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
            return true;

        var texto = textoBusqueda.Trim();

        return (a.Nombre?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Email?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.PcLoginId?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Departamento?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Funcion?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.Tipo?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool CumpleFiltroTipo(Auditor a)
    {
        if (string.IsNullOrWhiteSpace(tipoSeleccionado))
            return true;

        return string.Equals(a.Tipo, tipoSeleccionado, StringComparison.OrdinalIgnoreCase);
    }

    private void LimpiarFiltros()
    {
        textoBusqueda = "";
        tipoSeleccionado = "";
    }

    private void PrepararEliminar(Auditor auditor)
    {
        auditorPendienteEliminar = auditor;
        errorMsg = null;
    }

    private void CancelarEliminar()
    {
        auditorPendienteEliminar = null;
    }

    private async Task EliminarAuditor()
    {
        if (auditorPendienteEliminar is null || eliminando)
            return;

        eliminando = true;
        errorMsg = null;

        try
        {
            var entity = await Db.Auditores
                .FirstOrDefaultAsync(x => x.AuditorId == auditorPendienteEliminar.AuditorId);

            if (entity is null)
            {
                errorMsg = "No se encontró el auditor a eliminar.";
                return;
            }

            Db.Auditores.Remove(entity);
            await Db.SaveChangesAsync();

            lista.RemoveAll(x => x.AuditorId == entity.AuditorId);
            auditorPendienteEliminar = null;
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            eliminando = false;
        }
    }

    private static int OrdenTipo(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "auditor")
            return 1;

        if (valor.Contains("entrenamiento"))
            return 2;

        if (valor.Contains("observador"))
            return 3;

        return 99;
    }

    private static string DescripcionTipo(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "auditor")
            return "Perfil principal de auditoría.";

        if (valor.Contains("entrenamiento"))
            return "Personal en formación dentro del equipo auditor.";

        if (valor.Contains("observador"))
            return "Personal de apoyo u observación.";

        return "Tipo no clasificado.";
    }

    private static string GetTipoClass(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor.Contains("observador"))
            return "observador";

        if (valor.Contains("entrenamiento"))
            return "training";

        return "auditor";
    }
}