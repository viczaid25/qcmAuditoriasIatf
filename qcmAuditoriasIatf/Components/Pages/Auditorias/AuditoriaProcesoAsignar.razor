@page "/auditorias/{auditoriaId:int}/procesos/agregar"
@page "/auditorias/{auditoriaId:int}/procesos/{auditoriaProcesoId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Auditorias
@using qcmAuditoriasIatf.Models.Catalogos
@using qcmAuditoriasIatf.Models.External
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="asignacion-loading">
        <div class="asignacion-skeleton asignacion-skeleton-hero"></div>
        <div class="asignacion-grid">
            <div class="asignacion-skeleton asignacion-skeleton-form"></div>
            <div class="asignacion-skeleton asignacion-skeleton-side"></div>
        </div>
    </div>
}
else if (auditoria is null || (!EsNuevo && ap is null))
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">No se encontró el proceso de auditoría</div>
            <div class="empty-text">
                Verifica el proceso seleccionado o vuelve al detalle de la auditoría.
            </div>

            <button type="button" class="hero-btn primary mt-3" @onclick="Volver">
                Volver
            </button>
        </div>
    </section>
}
else
{
    <div class="asignacion-page">
        <section class="asignacion-hero">
            <div>
                <span class="asignacion-kicker">Planeación de proceso</span>
                <h1>@(EsNuevo ? "Agregar proceso a la auditoría" : "Asignar equipo auditor")</h1>

                <div class="hero-meta">
                    <span class="meta-chip">
                        Auditoría:
                        <strong>#@auditoriaId</strong>
                    </span>

                    <span class="meta-chip">
                        Rango:
                        <strong>@TextoRangoAuditoria</strong>
                    </span>

                    @if (!EsNuevo)
                    {
                        <span class="meta-chip">
                            Proceso:
                            <strong>@(ap?.Proceso?.Codigo ?? "Sin código")</strong>
                        </span>

                        @if (ap?.UnidadNegocio is not null)
                        {
                            <span class="meta-chip">
                                Unidad:
                                <strong>@ap.UnidadNegocio.Codigo</strong>
                            </span>
                        }
                        else
                        {
                            <span class="meta-chip">Sin unidad de negocio</span>
                        }
                    }
                </div>

                <p class="hero-text">
                    @(EsNuevo
                        ? "Selecciona el proceso a agregar y define su equipo auditor y fecha programada."
                        : "Define el equipo auditor, la fecha programada del proceso y la línea aplicable dentro del rango de la auditoría.")
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn primary" @onclick="Volver">
                    Volver al detalle
                </button>
            </div>
        </section>

        <EditForm Model="vm" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="asignacion-grid">
                <section class="panel-card panel-main">
                    <div class="panel-head">
                        <div>
                            <h2>Equipo auditor y programación</h2>
                            <p class="panel-subtitle">Completa los responsables y la fecha en que se ejecutará este proceso.</p>
                        </div>
                    </div>

                    <div class="row g-3">
                        @if (EsNuevo)
                        {
                            <div class="col-12">
                                <label class="form-label">Proceso a agregar</label>

                                <InputSelect class="mo-form-select" @bind-Value="procesoIdSeleccionado">
                                    <option value="0">-- Selecciona --</option>
                                    @foreach (var p in procesosDisponibles)
                                    {
                                        <option value="@p.ProcesoId">@p.Codigo - @p.Nombre</option>
                                    }
                                </InputSelect>

                                @if (procesosDisponibles.Count == 0)
                                {
                                    <div class="field-help">Todos los procesos activos ya están incluidos en esta auditoría.</div>
                                }
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="form-label">Auditor principal</label>

                            <InputSelect class="mo-form-select" @bind-Value="vm.AuditorAsignadoId">
                                <option value="">-- Selecciona --</option>
                                @foreach (var a in auditoresDisponibles)
                                {
                                    <option value="@GetAuditorKey(a)">
                                        @GetAuditorDisplay(a)
                                    </option>
                                }
                            </InputSelect>

                            <div class="field-help">
                                Se cargan auditores <b>activos</b> de tipo Auditor o Entrenamiento.
                            </div>

                            @if (AuditorPrincipalSeleccionado is not null)
                            {
                                <div class="selection-note">
                                    @GetAuditorMeta(AuditorPrincipalSeleccionado)
                                </div>
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Segundo auditor</label>

                            <InputSelect class="mo-form-select" @bind-Value="vm.SegundoAuditorId">
                                <option value="">-- Opcional --</option>
                                @foreach (var a in auditoresDisponibles)
                                {
                                    <option value="@GetAuditorKey(a)">
                                        @GetAuditorDisplay(a)
                                    </option>
                                }
                            </InputSelect>

                            <div class="field-help">
                                Opcional. Usa el mismo catálogo de auditores activos.
                            </div>

                            @if (SegundoAuditorSeleccionado is not null)
                            {
                                <div class="selection-note">
                                    @GetAuditorMeta(SegundoAuditorSeleccionado)
                                </div>
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Observador</label>

                            <InputSelect class="mo-form-select" @bind-Value="vm.ObservadorId">
                                <option value="">-- Opcional --</option>
                                @foreach (var o in observadoresDisponibles)
                                {
                                    <option value="@GetAuditorKey(o)">
                                        @GetAuditorDisplay(o)
                                    </option>
                                }
                            </InputSelect>

                            <div class="field-help">
                                Se cargan observadores <b>activos</b>.
                            </div>

                            @if (ObservadorSeleccionado is not null)
                            {
                                <div class="selection-note">
                                    @GetAuditorMeta(ObservadorSeleccionado)
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fecha programada del proceso</label>
                            <InputDate class="mo-form-control"
                                       @bind-Value="vm.FechaProgramada"
                                       min="@FechaMin"
                                       max="@FechaMax" />

                            <div class="field-help">
                                Debe estar dentro del rango de la auditoría:
                                <b>@FechaMin</b> a <b>@FechaMax</b>.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Línea</label>
                            <InputText class="mo-form-control"
                                       @bind-Value="vm.LineaNombre"
                                       disabled="@(!requiereLinea)" />

                            @if (!requiereLinea)
                            {
                                <div class="field-help">No aplica para este proceso porque no tiene unidad de negocio.</div>
                            }
                            else
                            {
                                <div class="field-help">Obligatorio cuando el proceso requiere unidad de negocio.</div>
                            }
                        </div>
                    </div>
                </section>

                <section class="panel-card panel-side">
                    <div class="panel-head">
                        <div>
                            <h2>Resumen actual</h2>
                            <p class="panel-subtitle">Vista rápida de la planeación del proceso.</p>
                        </div>
                    </div>

                    <div class="summary-grid">
                        <div class="summary-item">
                            <span>Proceso</span>
                            <strong>@TextoProceso</strong>
                        </div>

                        <div class="summary-item">
                            <span>Unidad</span>
                            <strong>@TextoUnidad</strong>
                        </div>

                        <div class="summary-item">
                            <span>Fecha programada</span>
                            <strong>@TextoFechaProgramada</strong>
                        </div>

                        <div class="summary-item">
                            <span>Línea</span>
                            <strong>@TextoLinea</strong>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="mini-label">Equipo seleccionado</div>

                    <div class="person-card @(string.IsNullOrWhiteSpace(vm.AuditorAsignadoId) ? "empty" : "")">
                        <div class="person-role">Auditor principal</div>
                        <div class="person-name">@GetPersonaResumen(vm.AuditorAsignadoId, AuditorPrincipalSeleccionado)</div>
                        @if (AuditorPrincipalSeleccionado is not null)
                        {
                            <div class="person-meta">@GetAuditorMeta(AuditorPrincipalSeleccionado)</div>
                        }
                    </div>

                    <div class="person-card @(string.IsNullOrWhiteSpace(vm.SegundoAuditorId) ? "empty" : "")">
                        <div class="person-role">Segundo auditor</div>
                        <div class="person-name">@GetPersonaResumen(vm.SegundoAuditorId, SegundoAuditorSeleccionado, "No asignado")</div>
                        @if (SegundoAuditorSeleccionado is not null)
                        {
                            <div class="person-meta">@GetAuditorMeta(SegundoAuditorSeleccionado)</div>
                        }
                    </div>

                    <div class="person-card @(string.IsNullOrWhiteSpace(vm.ObservadorId) ? "empty" : "")">
                        <div class="person-role">Observador</div>
                        <div class="person-name">@GetPersonaResumen(vm.ObservadorId, ObservadorSeleccionado, "No asignado")</div>
                        @if (ObservadorSeleccionado is not null)
                        {
                            <div class="person-meta">@GetAuditorMeta(ObservadorSeleccionado)</div>
                        }
                    </div>

                    <div class="notice-box">
                        Una misma persona no puede ocupar más de un rol dentro del mismo proceso.
                    </div>
                </section>
            </div>

            <section class="panel-card action-panel">
                <div class="action-panel-inner">
                    <div>
                        <h2>Guardar cambios</h2>
                        <p class="panel-subtitle mb-0">
                            Al guardar se actualizará el equipo auditor, la fecha programada y, si aplica, la línea del proceso.
                        </p>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="mo-btn mo-btn-primary mo-btn-lg" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>

                        <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-lg" @onclick="Volver" disabled="@guardando">
                            Cancelar
                        </button>
                    </div>
                </div>
            </section>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int auditoriaId { get; set; }
    [Parameter] public int? auditoriaProcesoId { get; set; }

    private bool EsNuevo => !auditoriaProcesoId.HasValue;

    private bool cargando = true;
    private bool guardando;
    private string? errorMsg;

    private Auditoria? auditoria;
    private AuditoriaProceso? ap;
    private bool requiereLinea;

    private List<Proceso> procesosDisponibles = new();
    private int procesoIdSeleccionado;

    private List<Auditor> auditoresDisponibles = new();
    private List<Auditor> observadoresDisponibles = new();
    private readonly Dictionary<string, MeaxAllUser> usuariosDirectorio = new(StringComparer.OrdinalIgnoreCase);

    private Vm vm = new();

    private string FechaMin => auditoria?.FechaInicio.ToString("yyyy-MM-dd") ?? "";
    private string FechaMax => auditoria?.FechaFin.ToString("yyyy-MM-dd") ?? "";

    private Auditor? AuditorPrincipalSeleccionado =>
        auditoresDisponibles.FirstOrDefault(x => GetAuditorKey(x) == vm.AuditorAsignadoId);

    private Auditor? SegundoAuditorSeleccionado =>
        auditoresDisponibles.FirstOrDefault(x => GetAuditorKey(x) == vm.SegundoAuditorId);

    private Auditor? ObservadorSeleccionado =>
        observadoresDisponibles.FirstOrDefault(x => GetAuditorKey(x) == vm.ObservadorId);

    private string TextoRangoAuditoria =>
        auditoria is null
            ? "Sin rango"
            : $"{auditoria.FechaInicio:yyyy-MM-dd} a {auditoria.FechaFin:yyyy-MM-dd}";

    private string TextoProceso
    {
        get
        {
            if (EsNuevo)
            {
                var seleccionado = procesosDisponibles.FirstOrDefault(p => p.ProcesoId == procesoIdSeleccionado);
                return seleccionado is null ? "Sin proceso seleccionado" : $"{seleccionado.Codigo} - {seleccionado.Nombre}";
            }

            return ap?.Proceso is null
                ? "Sin proceso"
                : $"{ap.Proceso.Codigo} - {ap.Proceso.Nombre}";
        }
    }

    private string TextoUnidad =>
        ap?.UnidadNegocio is null
            ? "No aplica"
            : $"{ap.UnidadNegocio.Codigo} - {ap.UnidadNegocio.Nombre}";

    private string TextoFechaProgramada =>
        vm.FechaProgramada.HasValue ? vm.FechaProgramada.Value.ToString("yyyy-MM-dd") : "Pendiente";

    private string TextoLinea =>
        !requiereLinea
            ? "No aplica"
            : string.IsNullOrWhiteSpace(vm.LineaNombre) ? "Pendiente" : vm.LineaNombre!;

    private class Vm
    {
        public string? AuditorAsignadoId { get; set; }
        public string? SegundoAuditorId { get; set; }
        public string? ObservadorId { get; set; }
        public string? LineaNombre { get; set; }
        public DateTime? FechaProgramada { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;

        auditoria = await Db.Auditorias
            .FirstOrDefaultAsync(a => a.AuditoriaId == auditoriaId);

        auditoresDisponibles = await Db.Auditores
            .Where(a => a.Activo && (a.Tipo == "Auditor" || a.Tipo == "Entrenamiento"))
            .OrderBy(a => a.Nombre)
            .ToListAsync();

        observadoresDisponibles = await Db.Auditores
            .Where(a => a.Activo && a.Tipo == "Observador")
            .OrderBy(a => a.Nombre)
            .ToListAsync();

        await CargarUsuariosDirectorio();

        if (EsNuevo)
        {
            var procesoIdsExistentes = await Db.AuditoriaProcesos
                .Where(x => x.AuditoriaId == auditoriaId)
                .Select(x => x.ProcesoId)
                .ToListAsync();

            procesosDisponibles = await Db.Procesos
                .Where(p => p.Activo && !procesoIdsExistentes.Contains(p.ProcesoId))
                .OrderBy(p => p.Codigo)
                .ToListAsync();

            vm.FechaProgramada = auditoria?.FechaInicio;
        }
        else
        {
            ap = await Db.AuditoriaProcesos
                .Include(x => x.Proceso)
                .Include(x => x.UnidadNegocio)
                .FirstOrDefaultAsync(x => x.AuditoriaProcesoId == auditoriaProcesoId && x.AuditoriaId == auditoriaId);

            if (ap is not null)
            {
                vm.AuditorAsignadoId = ap.AuditorAsignadoId;
                vm.SegundoAuditorId = ap.SegundoAuditorId;
                vm.ObservadorId = ap.ObservadorId;
                vm.LineaNombre = ap.LineaNombre;
                vm.FechaProgramada = ap.FechaProgramada ?? auditoria?.FechaInicio;

                requiereLinea = ap.UnidadNegocioId is not null;
                if (!requiereLinea)
                    vm.LineaNombre = null;
            }
        }

        cargando = false;
    }

    private async Task CargarUsuariosDirectorio()
    {
        usuariosDirectorio.Clear();

        var logins = auditoresDisponibles
            .Concat(observadoresDisponibles)
            .Select(x => x.PcLoginId?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (logins.Count == 0)
            return;

        var usuarios = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x => logins.Contains(x.pc_login_id))
            .ToListAsync();

        foreach (var u in usuarios)
        {
            if (!string.IsNullOrWhiteSpace(u.pc_login_id))
                usuariosDirectorio[u.pc_login_id.Trim()] = u;
        }
    }

    private MeaxAllUser? GetUsuarioDirectorio(string? loginId)
    {
        if (string.IsNullOrWhiteSpace(loginId))
            return null;

        usuariosDirectorio.TryGetValue(loginId.Trim(), out var usuario);
        return usuario;
    }

    private string GetAuditorKey(Auditor a)
        => string.IsNullOrWhiteSpace(a.PcLoginId) ? a.Nombre : a.PcLoginId;

    private string GetNombrePreferido(Auditor a)
    {
        var usuario = GetUsuarioDirectorio(a.PcLoginId);

        if (!string.IsNullOrWhiteSpace(usuario?.username))
            return usuario.username!;

        return a.Nombre;
    }

    private string GetDepartamentoPreferido(Auditor a)
    {
        var usuario = GetUsuarioDirectorio(a.PcLoginId);

        if (!string.IsNullOrWhiteSpace(a.Departamento))
            return a.Departamento!;

        if (!string.IsNullOrWhiteSpace(usuario?.department))
            return usuario.department!;

        return "—";
    }

    private string GetFuncionPreferida(Auditor a)
    {
        var usuario = GetUsuarioDirectorio(a.PcLoginId);

        if (!string.IsNullOrWhiteSpace(a.Funcion))
            return a.Funcion!;

        if (!string.IsNullOrWhiteSpace(usuario?.position))
            return usuario.position!;

        return "—";
    }

    private string GetCorreoPreferido(Auditor a)
    {
        var usuario = GetUsuarioDirectorio(a.PcLoginId);

        if (!string.IsNullOrWhiteSpace(a.Email))
            return a.Email!;

        if (!string.IsNullOrWhiteSpace(usuario?.email))
            return usuario.email!;

        return "Sin correo";
    }

    private string GetAuditorDisplay(Auditor a)
    {
        var nombre = GetNombrePreferido(a);

        if (!string.IsNullOrWhiteSpace(a.PcLoginId) &&
            !string.Equals(nombre.Trim(), a.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return $"{nombre} ({a.PcLoginId}) - {a.Tipo}";
        }

        return $"{nombre} - {a.Tipo}";
    }

    private string GetAuditorMeta(Auditor? a)
    {
        if (a is null)
            return string.Empty;

        var parts = new List<string>();

        var depto = GetDepartamentoPreferido(a);
        var funcion = GetFuncionPreferida(a);
        var correo = GetCorreoPreferido(a);

        if (depto != "—")
            parts.Add(depto);

        if (funcion != "—")
            parts.Add(funcion);

        if (correo != "Sin correo")
            parts.Add(correo);

        return parts.Count == 0 ? "Sin información adicional." : string.Join(" | ", parts);
    }

    private string GetPersonaResumen(string? key, Auditor? persona, string fallback = "Sin asignar")
    {
        if (persona is not null)
        {
            var nombre = GetNombrePreferido(persona);

            if (!string.IsNullOrWhiteSpace(persona.PcLoginId) &&
                !string.Equals(nombre.Trim(), persona.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                return $"{nombre} ({persona.PcLoginId})";
            }

            return nombre;
        }

        if (string.IsNullOrWhiteSpace(key))
            return fallback;

        var usuario = GetUsuarioDirectorio(key);
        if (usuario is not null)
        {
            var nombre = string.IsNullOrWhiteSpace(usuario.username) ? usuario.pc_login_id : usuario.username!;

            if (!string.IsNullOrWhiteSpace(usuario.pc_login_id) &&
                !string.Equals(nombre.Trim(), usuario.pc_login_id.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                return $"{nombre} ({usuario.pc_login_id})";
            }

            return nombre;
        }

        return key;
    }

    private void SeleccionarAuditorPrincipal(Auditor a)
        => vm.AuditorAsignadoId = GetAuditorKey(a);

    private void SeleccionarSegundoAuditor(Auditor a)
        => vm.SegundoAuditorId = GetAuditorKey(a);

    private void SeleccionarObservador(Auditor a)
        => vm.ObservadorId = GetAuditorKey(a);

    private async Task Guardar()
    {
        if (guardando) return;
        errorMsg = null;

        if (EsNuevo && procesoIdSeleccionado <= 0)
        {
            errorMsg = "Selecciona el proceso que quieres agregar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(vm.AuditorAsignadoId))
        {
            errorMsg = "El auditor principal es obligatorio.";
            return;
        }

        if (!vm.FechaProgramada.HasValue)
        {
            errorMsg = "La fecha programada del proceso es obligatoria.";
            return;
        }

        if (auditoria is not null &&
            (vm.FechaProgramada.Value.Date < auditoria.FechaInicio.Date ||
             vm.FechaProgramada.Value.Date > auditoria.FechaFin.Date))
        {
            errorMsg = "La fecha programada del proceso debe estar dentro del rango de la auditoría.";
            return;
        }

        if (requiereLinea && string.IsNullOrWhiteSpace(vm.LineaNombre))
        {
            errorMsg = "La línea es obligatoria cuando hay Unidad de Negocio.";
            return;
        }

        var roles = new[]
        {
            vm.AuditorAsignadoId?.Trim(),
            vm.SegundoAuditorId?.Trim(),
            vm.ObservadorId?.Trim()
        }
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();

        if (roles.Count != roles.Distinct(StringComparer.OrdinalIgnoreCase).Count())
        {
            errorMsg = "No puedes asignar la misma persona como auditor principal, segundo auditor u observador.";
            return;
        }

        guardando = true;

        try
        {
            AuditoriaProceso? entity;

            if (EsNuevo)
            {
                var procesoSeleccionado = await Db.Procesos
                    .FirstOrDefaultAsync(p => p.ProcesoId == procesoIdSeleccionado);

                if (procesoSeleccionado is null)
                {
                    errorMsg = "El proceso seleccionado ya no está disponible.";
                    return;
                }

                entity = new AuditoriaProceso
                {
                    AuditoriaId = auditoriaId,
                    ProcesoId = procesoSeleccionado.ProcesoId,
                    UnidadNegocioId = null
                };

                Db.AuditoriaProcesos.Add(entity);
            }
            else
            {
                entity = await Db.AuditoriaProcesos
                    .FirstOrDefaultAsync(x => x.AuditoriaProcesoId == auditoriaProcesoId && x.AuditoriaId == auditoriaId);

                if (entity is null)
                {
                    errorMsg = "No se encontró el registro a actualizar.";
                    return;
                }
            }

            entity.AuditorAsignadoId = vm.AuditorAsignadoId?.Trim();
            entity.SegundoAuditorId = string.IsNullOrWhiteSpace(vm.SegundoAuditorId) ? null : vm.SegundoAuditorId.Trim();
            entity.ObservadorId = string.IsNullOrWhiteSpace(vm.ObservadorId) ? null : vm.ObservadorId.Trim();
            entity.FechaProgramada = vm.FechaProgramada.Value.Date;

            if (entity.UnidadNegocioId is null)
                entity.LineaNombre = null;
            else
                entity.LineaNombre = vm.LineaNombre?.Trim();

            await Db.SaveChangesAsync();

            var procesoId = entity.ProcesoId;
            var auditoriaProcesoIdGuardado = entity.AuditoriaProcesoId;

            var preguntasIds = await Db.ChecklistPreguntas
                .Where(p => p.ProcesoId == procesoId && p.Activo)
                .Select(p => p.PreguntaId)
                .ToListAsync();

            var existentesIds = await Db.AuditoriaChecklists
                .Where(x => x.AuditoriaProcesoId == auditoriaProcesoIdGuardado)
                .Select(x => x.PreguntaId)
                .ToListAsync();

            var existentesSet = existentesIds.ToHashSet();

            var auditorId = string.IsNullOrWhiteSpace(entity.AuditorAsignadoId) ? "sistema" : entity.AuditorAsignadoId;

            var faltantes = preguntasIds
                .Where(pid => !existentesSet.Contains(pid))
                .Select(pid => new AuditoriaChecklist
                {
                    AuditoriaProcesoId = auditoriaProcesoIdGuardado,
                    PreguntaId = pid,
                    Cumple = "Pendiente",
                    AuditorId = auditorId!,
                    FechaRegistro = DateTime.Now
                })
                .ToList();

            if (faltantes.Count > 0)
            {
                Db.AuditoriaChecklists.AddRange(faltantes);
                await Db.SaveChangesAsync();
            }

            Nav.NavigateTo($"auditorias/{auditoriaId}");
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver() => Nav.NavigateTo($"auditorias/{auditoriaId}");
}