@page "/auditorias/nueva"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Auditorias
@using qcmAuditoriasIatf.Models.Catalogos
@using qcmAuditoriasIatf.Models.External
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="nueva-loading">
        <div class="nueva-skeleton nueva-skeleton-hero"></div>
        <div class="nueva-skeleton nueva-skeleton-form"></div>
        <div class="nueva-skeleton nueva-skeleton-table"></div>
    </div>
}
else
{
    var procesosGenerales = ProcesosGenerales.ToList();
    var procesosProduccion = ProcesosProduccion.ToList();

    <div class="nueva-page">
        <section class="nueva-hero">
            <div>
                <span class="nueva-kicker">Planeación de auditoría</span>
                <h1>Nueva auditoría</h1>

                <div class="hero-meta">
                    <span class="meta-chip">
                        Procesos disponibles:
                        <strong>@totalProcesosDisponibles</strong>
                    </span>

                    <span class="meta-chip">
                        Seleccionados:
                        <strong>@totalProcesosSeleccionados</strong>
                    </span>

                    <span class="meta-chip">
                        Producción por unidad:
                        <strong>@totalProduccionSeleccionada</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Define los datos generales de la auditoría y captura el contexto de cada proceso antes de guardar.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn" @onclick="Cancelar" disabled="@guardando">
                    Cancelar
                </button>
            </div>
        </section>

        <EditForm Model="model" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Datos de la auditoría</h2>
                        <p class="panel-subtitle">Captura la información principal antes de generar los procesos.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Fecha inicio</label>
                        <InputDate class="mo-form-control" @bind-Value="model.FechaInicio" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Fecha fin</label>
                        <InputDate class="mo-form-control" @bind-Value="model.FechaFin" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tipo</label>
                        <InputSelect class="mo-form-select" @bind-Value="model.TipoAuditoria">
                            <option value="Interna">Interna</option>
                            <option value="Externa">Externa</option>
                            <option value="Cliente">Cliente</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Estatus</label>
                        <InputSelect class="mo-form-select" @bind-Value="model.Estatus">
                            <option value="Planeada">Planeada</option>
                            <option value="En Proceso">En Proceso</option>
                            <option value="Cerrada">Cerrada</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Auditor líder</label>
                        <InputSelect class="mo-form-select" @bind-Value="model.AuditorLiderId">
                            <option value="">-- Selecciona auditor líder --</option>
                            @foreach (var a in auditoresDisponibles)
                            {
                                <option value="@GetAuditorKey(a)">
                                    @GetAuditorDisplay(a)
                                </option>
                            }
                        </InputSelect>

                        @if (AuditorLiderSeleccionado is not null)
                        {
                            <div class="field-help">
                                Depto: <b>@AuditorLiderSeleccionado.Departamento</b>
                                @if (!string.IsNullOrWhiteSpace(AuditorLiderSeleccionado.Funcion))
                                {
                                    <span> | Función: <b>@AuditorLiderSeleccionado.Funcion</b></span>
                                }
                                @if (!string.IsNullOrWhiteSpace(AuditorLiderSeleccionado.Email))
                                {
                                    <span> | Email: <b>@AuditorLiderSeleccionado.Email</b></span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="field-help">
                                Selecciona un auditor activo del catálogo.
                            </div>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label">Objetivo</label>
                        <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.Objetivo" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Alcance</label>
                        <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.Alcance" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Criterios</label>
                        <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.Criterios" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Métodos</label>
                        <InputTextArea class="mo-form-control" rows="3" @bind-Value="model.Metodos" />
                    </div>
                </div>
            </section>

            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Procesos a crear</h2>
                        <p class="panel-subtitle">
                            Selecciona los procesos, asigna la persona a auditar y captura el contexto necesario.
                        </p>
                    </div>

                    <span class="panel-badge">@totalProcesosSeleccionados seleccionado(s)</span>
                </div>

                <div class="toolbar-actions">
                    <button type="button" class="table-btn table-btn-primary" @onclick="SeleccionarTodos">
                        Seleccionar todos
                    </button>

                    <button type="button" class="table-btn" @onclick="DeseleccionarTodos">
                        Limpiar selección
                    </button>

                    <button type="button" class="table-btn" @onclick="ExpandirSeleccionados">
                        Expandir seleccionados
                    </button>

                    <button type="button" class="table-btn" @onclick="ColapsarTodos">
                        Colapsar todos
                    </button>
                </div>

                <div class="notice-box mt-3">
                    Solo se crearán los procesos marcados. Para procesos de producción puedes agregar varias líneas; se generará un registro por cada línea capturada.
                </div>

                @if (procesosDisponibles.Count == 0)
                {
                    <div class="empty-state compact mt-3">
                        No hay procesos disponibles para crear.
                    </div>
                }
                else
                {
                    <div class="process-groups mt-3">
                        @if (procesosGenerales.Count > 0)
                        {
                            <section class="process-group-card">
                                <div class="group-head">
                                    <div>
                                        <div class="group-title-row">
                                            <h3>Procesos generales</h3>
                                            <span class="type-pill standard">Proceso general</span>
                                        </div>

                                        <p class="group-text">
                                            Procesos que generan un solo registro y no requieren unidad de negocio ni líneas.
                                        </p>

                                        <div class="group-meta">
                                            <span class="summary-chip">Disponibles: @procesosGenerales.Count</span>
                                            <span class="summary-chip">Seleccionados: @procesosGenerales.Count(x => x.Seleccionado)</span>
                                        </div>
                                    </div>

                                    <div class="group-actions">
                                        <button type="button" class="table-btn" @onclick="() => SeleccionarGrupo(false, true)">
                                            Seleccionar grupo
                                        </button>

                                        <button type="button" class="table-btn" @onclick="() => SeleccionarGrupo(false, false)">
                                            Limpiar grupo
                                        </button>

                                        <button type="button" class="table-btn" @onclick="() => ExpandirGrupo(false)">
                                            Expandir grupo
                                        </button>

                                        <button type="button" class="table-btn" @onclick="() => ColapsarGrupo(false)">
                                            Colapsar grupo
                                        </button>
                                    </div>
                                </div>

                                <div class="process-list compact">
                                    @foreach (var p in procesosGenerales)
                                    {

                                        <article class="process-card compact @(p.Seleccionado ? "selected" : "") @(EstaExpandido(p) ? "expanded" : "")" @key="p.Llave">
                                            <div class="process-summary">
                                                <div class="process-summary-left">
                                                    <input class="form-check-input process-check"
                                                           type="checkbox"
                                                           checked="@p.Seleccionado"
                                                           @onchange="e => CambiarSeleccion(p, e)" />

                                                    <div class="process-summary-copy">
                                                        <div class="cell-title">@p.Codigo - @p.Nombre</div>
                                                        <div class="cell-subtitle">Proceso general</div>

                                                        <div class="process-summary-meta">
                                                            <span class="summary-chip">Registro: 1</span>

                                                            @if (!string.IsNullOrWhiteSpace(p.AuditadoId))
                                                            {
                                                                <span class="summary-chip">Auditado: @GetAuditadoTexto(p)</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <button type="button"
                                                        class="collapse-btn"
                                                        @onclick="() => ToggleExpandido(p)">
                                                    @(EstaExpandido(p) ? "Ocultar" : "Capturar")
                                                </button>
                                            </div>

                                            @if (EstaExpandido(p))
                                            {
                                                <div class="process-card-body">
                                                    <div class="auditado-section">
                                                        <label class="form-label">Persona a auditar</label>

                                                        <div class="auditado-combo">
                                                            <div class="auditado-combo-head">
                                                                <input class="mo-form-control auditado-search-input"
                                                                       value="@p.AuditadoBusqueda"
                                                                       @oninput="@(e => BuscarAuditadoEnProceso(p, e))"
                                                                       @onfocus="@(() => MostrarOpcionesAuditado(p))"
                                                                       placeholder="Buscar por nombre, login o correo..." />

                                                                <button type="button"
                                                                        class="auditado-toggle-btn"
                                                                        @onclick="@(() => ToggleOpcionesAuditado(p))">
                                                                    <span>▾</span>
                                                                </button>
                                                            </div>

                                                            @if (p.MostrarAuditadoOpciones)
                                                            {
                                                                var opcionesAuditado = ObtenerAuditadosFiltrados(p).ToList();

                                                                <div class="auditado-dropdown">
                                                                    @if (opcionesAuditado.Count == 0)
                                                                    {
                                                                        <div class="auditado-empty">Sin resultados.</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var u in opcionesAuditado)
                                                                        {
                                                                            <button type="button"
                                                                                    class="auditado-option"
                                                                                    @onclick="@(() => SeleccionarAuditado(p, u))">
                                                                                <div class="auditado-option-title">@GetAuditadoOptionTitle(u)</div>
                                                                                <div class="auditado-option-meta">@GetAuditadoOptionMeta(u)</div>
                                                                            </button>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </div>

                                                        @{
                                                            var auditadoIds = ObtenerAuditadoIds(p);
                                                        }
                                                        @if (auditadoIds.Count > 0)
                                                        {
                                                            <div class="auditado-chips">
                                                                @foreach (var loginId in auditadoIds)
                                                                {
                                                                    <span class="auditado-chip" @key="loginId">
                                                                        @GetNombreAuditado(loginId)
                                                                        <button type="button"
                                                                                class="auditado-chip-remove"
                                                                                @onclick="@(() => QuitarAuditado(p, loginId))">
                                                                            ×
                                                                        </button>
                                                                    </span>
                                                                }

                                                                @if (auditadoIds.Count > 1)
                                                                {
                                                                    <button type="button"
                                                                            class="auditado-clear-btn"
                                                                            @onclick="@(() => LimpiarAuditado(p))">
                                                                        Limpiar todos
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="process-note">
                                                        <span>Se creará como proceso general.</span>
                                                    </div>

                                                    <div class="process-fields-grid">
                                                        <div class="field-span-2">
                                                            <label class="form-label">Reclamos</label>
                                                            <InputTextArea class="mo-form-control" rows="3" @bind-Value="p.ReclamosAuditoriasPasadas" />
                                                        </div>

                                                        <div class="field-span-2">
                                                            <label class="form-label">Resultados de auditorías internas</label>
                                                            <InputTextArea class="mo-form-control" rows="3" @bind-Value="p.ResultadosAuditoriasInternasPrevias" />
                                                        </div>

                                                        <div class="field-span-2">
                                                            <label class="form-label">Seguimiento de acciones correctivas IATF</label>
                                                            <InputTextArea class="mo-form-control" rows="3" @bind-Value="p.SeguimientoAccionesCorrectivasIatf" />
                                                        </div>

                                                        <div>
                                                            <label class="form-label">Cláusulas de IATF con TOP 3 NCM</label>
                                                            <InputTextArea class="mo-form-control" rows="3" @bind-Value="p.ClausulasIatfTop3NcmMayoresPasadas" />
                                                        </div>

                                                        <div>
                                                            <label class="form-label">Cláusulas de IATF con TOP 3 NCm</label>
                                                            <InputTextArea class="mo-form-control" rows="3" @bind-Value="p.ClausulasIatfTop3NcmMenoresPasadas" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }

                        @if (procesosProduccion.Count > 0)
                        {
                            <section class="process-group-card">
                                <div class="group-head">
                                    <div>
                                        <div class="group-title-row">
                                            <h3>Producción / unidad</h3>
                                            <span class="type-pill production">Producción / Unidad</span>
                                        </div>

                                        <p class="group-text">
                                            Procesos ligados a unidad de negocio. Puedes capturar varias líneas y se generará un registro por cada línea válida.
                                        </p>

                                        <div class="group-meta">
                                            <span class="summary-chip">Disponibles: @procesosProduccion.Count</span>
                                            <span class="summary-chip">Seleccionados: @procesosProduccion.Count(x => x.Seleccionado)</span>
                                        </div>
                                    </div>

                                    <div class="group-actions">
                                        <button type="button" class="table-btn" @onclick="() => SeleccionarGrupo(true, true)">
                                            Seleccionar grupo
                                        </button>

                                        <button type="button" class="table-btn" @onclick="() => SeleccionarGrupo(true, false)">
                                            Limpiar grupo
                                        </button>

                                        <button type="button" class="table-btn" @onclick="() => ExpandirGrupo(true)">
                                            Expandir grupo
                                        </button>

                                        <button type="button" class="table-btn" @onclick="() => ColapsarGrupo(true)">
                                            Colapsar grupo
                                        </button>
                                    </div>
                                </div>

                                <div class="process-list compact">
                                    @foreach (var p in procesosProduccion)
                                    {

                                        <article class="process-card compact @(p.Seleccionado ? "selected" : "") @(EstaExpandido(p) ? "expanded" : "")" @key="p.Llave">
                                            <div class="process-summary">
                                                <div class="process-summary-left">
                                                    <input class="form-check-input process-check"
                                                           type="checkbox"
                                                           checked="@p.Seleccionado"
                                                           @onchange="e => CambiarSeleccion(p, e)" />

                                                    <div class="process-summary-copy">
                                                        <div class="cell-title">@p.Codigo - @p.Nombre</div>
                                                        <div class="cell-subtitle">Unidad: @p.UnidadCodigo - @p.UnidadNombre</div>

                                                        <div class="process-summary-meta">
                                                            <span class="summary-chip">Registros: @GetTotalRegistros(p)</span>
                                                            <span class="summary-chip">Líneas: @GetLineasValidas(p)</span>

                                                            @if (!string.IsNullOrWhiteSpace(p.AuditadoId))
                                                            {
                                                                <span class="summary-chip">Auditado: @GetAuditadoTexto(p)</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <button type="button"
                                                        class="collapse-btn"
                                                        @onclick="() => ToggleExpandido(p)">
                                                    @(EstaExpandido(p) ? "Ocultar" : "Capturar")
                                                </button>
                                            </div>

                                            @if (EstaExpandido(p))
                                            {
                                                <div class="process-card-body">
                                                    <div class="auditado-section">
                                                        <label class="form-label">Persona a auditar</label>

                                                        <div class="auditado-combo">
                                                            <div class="auditado-combo-head">
                                                                <input class="mo-form-control auditado-search-input"
                                                                       value="@p.AuditadoBusqueda"
                                                                       @oninput="@(e => BuscarAuditadoEnProceso(p, e))"
                                                                       @onfocus="@(() => MostrarOpcionesAuditado(p))"
                                                                       placeholder="Buscar por nombre, login o correo..." />

                                                                <button type="button"
                                                                        class="auditado-toggle-btn"
                                                                        @onclick="@(() => ToggleOpcionesAuditado(p))">
                                                                    <span>▾</span>
                                                                </button>
                                                            </div>

                                                            @if (p.MostrarAuditadoOpciones)
                                                            {
                                                                var opcionesAuditado = ObtenerAuditadosFiltrados(p).ToList();

                                                                <div class="auditado-dropdown">
                                                                    @if (opcionesAuditado.Count == 0)
                                                                    {
                                                                        <div class="auditado-empty">Sin resultados.</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        @foreach (var u in opcionesAuditado)
                                                                        {
                                                                            <button type="button"
                                                                                    class="auditado-option"
                                                                                    @onclick="@(() => SeleccionarAuditado(p, u))">
                                                                                <div class="auditado-option-title">@GetAuditadoOptionTitle(u)</div>
                                                                                <div class="auditado-option-meta">@GetAuditadoOptionMeta(u)</div>
                                                                            </button>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </div>

                                                        @{
                                                            var auditadoIds = ObtenerAuditadoIds(p);
                                                        }
                                                        @if (auditadoIds.Count > 0)
                                                        {
                                                            <div class="auditado-chips">
                                                                @foreach (var loginId in auditadoIds)
                                                                {
                                                                    <span class="auditado-chip" @key="loginId">
                                                                        @GetNombreAuditado(loginId)
                                                                        <button type="button"
                                                                                class="auditado-chip-remove"
                                                                                @onclick="@(() => QuitarAuditado(p, loginId))">
                                                                            ×
                                                                        </button>
                                                                    </span>
                                                                }

                                                                @if (auditadoIds.Count > 1)
                                                                {
                                                                    <button type="button"
                                                                            class="auditado-clear-btn"
                                                                            @onclick="@(() => LimpiarAuditado(p))">
                                                                        Limpiar todos
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="lines-section">
                                                        <div class="lines-header">
                                                            <label class="form-label mb-0">Líneas de producción</label>
                                                            <button type="button"
                                                                    class="line-add-btn"
                                                                    @onclick="() => AgregarLinea(p)">
                                                                + Agregar línea
                                                            </button>
                                                        </div>

                                                        <div class="lines-hint">
                                                            Se creará un registro de proceso por cada línea con nombre. Si no capturas ninguna se generará un registro sin línea asignada.
                                                        </div>

                                                        <div class="lines-list">
                                                            @foreach (var linea in p.Lineas)
                                                            {
                                                                <div class="line-card" @key="linea">
                                                                    <div class="line-item">
                                                                        <input class="mo-form-control line-input"
                                                                               placeholder="Ej. Alt 1, Alt GX, Línea A..."
                                                                               @bind="linea.Nombre" />

                                                                        @if (p.Lineas.Count > 1)
                                                                        {
                                                                            <button type="button"
                                                                                    class="line-remove-btn"
                                                                                    @onclick="() => RemoverLinea(p, linea)">
                                                                                ×
                                                                            </button>
                                                                        }
                                                                    </div>

                                                                    <div class="process-fields-grid">
                                                                        <div class="field-span-2">
                                                                            <label class="form-label">Reclamos</label>
                                                                            <InputTextArea class="mo-form-control" rows="2" @bind-Value="linea.ReclamosAuditoriasPasadas" />
                                                                        </div>

                                                                        <div class="field-span-2">
                                                                            <label class="form-label">Resultados de auditorías internas previas</label>
                                                                            <InputTextArea class="mo-form-control" rows="2" @bind-Value="linea.ResultadosAuditoriasInternasPrevias" />
                                                                        </div>

                                                                        <div class="field-span-2">
                                                                            <label class="form-label">Seguimiento de acciones correctivas IATF</label>
                                                                            <InputTextArea class="mo-form-control" rows="2" @bind-Value="linea.SeguimientoAccionesCorrectivasIatf" />
                                                                        </div>

                                                                        <div>
                                                                            <label class="form-label">Cláusulas de IATF con TOP 3 NCM</label>
                                                                            <InputTextArea class="mo-form-control" rows="2" @bind-Value="linea.ClausulasIatfTop3NcmMayoresPasadas" />
                                                                        </div>

                                                                        <div>
                                                                            <label class="form-label">Cláusulas de IATF con TOP 3 NCm</label>
                                                                            <InputTextArea class="mo-form-control" rows="2" @bind-Value="linea.ClausulasIatfTop3NcmMenoresPasadas" />
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <div class="process-note">
                                                        @{
                                                            var lineasValidas = GetLineasValidas(p);
                                                        }

                                                        @if (lineasValidas == 0)
                                                        {
                                                            <span>Se creará 1 registro sin línea asignada (se puede editar después).</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Se crearán <b>@lineasValidas</b> registro(s) con las líneas capturadas.</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            </section>

            <section class="panel-card action-panel">
                <div class="action-panel-inner">
                    <div>
                        <h2>Confirmación</h2>
                        <p class="panel-subtitle mb-0">
                            Al guardar, se creará la auditoría y solo los procesos seleccionados con su contexto capturado.
                        </p>
                    </div>

                    <div class="action-buttons">
                        <button type="submit" class="mo-btn mo-btn-primary mo-btn-lg" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar auditoría")
                        </button>

                        <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-lg" @onclick="Cancelar" disabled="@guardando">
                            Cancelar
                        </button>
                    </div>
                </div>
            </section>
        </EditForm>
    </div>
}

@code {
    private Auditoria model = new()
    {
        FechaInicio = DateTime.Today,
        FechaFin = DateTime.Today,
        TipoAuditoria = "Interna",
        Estatus = "Planeada",
        AuditorLiderId = "",
        Objetivo = "",
        Alcance = "",
        Criterios = "",
        Metodos = ""
    };

    private bool cargando = true;
    private bool guardando;
    private string? errorMsg;

    private readonly HashSet<string> procesosExpandidos = new();

    private List<Auditor> auditoresDisponibles = new();
    private List<ProcesoSeleccionVm> procesosDisponibles = new();
    private List<MeaxAllUser> meaxUsers = new();

    private int totalProcesosDisponibles => procesosDisponibles.Count;
    private int totalProcesosSeleccionados => procesosDisponibles.Count(x => x.Seleccionado);
    private int totalProduccionSeleccionada => procesosDisponibles.Count(x => x.Seleccionado && x.UnidadNegocioId.HasValue);

    private IEnumerable<ProcesoSeleccionVm> ProcesosOrdenados =>
        procesosDisponibles
            .OrderBy(x => x.EsProduccion ? 1 : 0)
            .ThenBy(x => x.Codigo)
            .ThenBy(x => x.UnidadCodigo)
            .ThenBy(x => x.UnidadNombre);

    private IEnumerable<ProcesoSeleccionVm> ProcesosGenerales =>
        ProcesosOrdenados.Where(x => !x.EsProduccion);

    private IEnumerable<ProcesoSeleccionVm> ProcesosProduccion =>
        ProcesosOrdenados.Where(x => x.EsProduccion);

    private Auditor? AuditorLiderSeleccionado =>
        auditoresDisponibles.FirstOrDefault(x => GetAuditorKey(x) == model.AuditorLiderId);

    private class LineaVm
    {
        public string Nombre { get; set; } = "";

        public string? ReclamosAuditoriasPasadas { get; set; }
        public string? ResultadosAuditoriasInternasPrevias { get; set; }
        public string? SeguimientoAccionesCorrectivasIatf { get; set; }
        public string? ClausulasIatfTop3NcmMayoresPasadas { get; set; }
        public string? ClausulasIatfTop3NcmMenoresPasadas { get; set; }
    }

    private class ProcesoRefVm
    {
        public int ProcesoId { get; set; }
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
    }

    private class ProcesoSeleccionVm
    {
        public List<ProcesoRefVm> Procesos { get; set; } = new();
        public int? UnidadNegocioId { get; set; }
        public string? UnidadCodigo { get; set; }
        public string? UnidadNombre { get; set; }
        public bool Seleccionado { get; set; } = true;

        public string AuditadoId { get; set; } = "";
        public string AuditadoBusqueda { get; set; } = "";
        public bool MostrarAuditadoOpciones { get; set; }

        public List<LineaVm> Lineas { get; set; } = new() { new LineaVm() };

        public bool EsProduccion => UnidadNegocioId.HasValue;

        public string? ReclamosAuditoriasPasadas { get; set; }
        public string? ResultadosAuditoriasInternasPrevias { get; set; }
        public string? SeguimientoAccionesCorrectivasIatf { get; set; }
        public string? ClausulasIatfTop3NcmMayoresPasadas { get; set; }
        public string? ClausulasIatfTop3NcmMenoresPasadas { get; set; }

        public string Codigo => string.Join(" / ", Procesos.Select(x => x.Codigo));
        public string Nombre => string.Join(" / ", Procesos.Select(x => x.Nombre));

        public string Llave => $"{string.Join("-", Procesos.Select(x => x.ProcesoId))}_{UnidadNegocioId?.ToString() ?? "0"}";
    }

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            await CargarAuditores();
            await CargarMeaxUsers();
            await CargarProcesosDisponibles();
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarAuditores()
    {
        auditoresDisponibles = await Db.Auditores
            .Where(a => a.Activo && (a.Tipo == "Auditor" || a.Tipo == "Entrenamiento"))
            .OrderBy(a => a.Nombre)
            .ToListAsync();
    }

    private async Task CargarMeaxUsers()
    {
        meaxUsers = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(u => !string.IsNullOrEmpty(u.pc_login_id))
            .OrderBy(u => u.username ?? u.pc_login_id)
            .ToListAsync();
    }

    private async Task CargarProcesosDisponibles()
    {
        procesosDisponibles.Clear();

        var procesos = await Db.Procesos
            .Where(p => p.Activo)
            .OrderBy(p => p.Codigo)
            .ToListAsync();

        var unidades = await Db.UnidadesNegocio
            .Where(u => u.Activo)
            .OrderBy(u => u.Codigo)
            .ToListAsync();

        // Un proceso se expande por unidad de negocio si el catálogo tiene unidades
        // capturadas contra él (p.ej. "MX-7000-D1 / MX-6000-D1 - PRODUCCIÓN / CALIDAD PROCESO").
        // El resto son procesos generales de un solo registro.
        var idsPorUnidad = unidades.Select(u => u.ProcesoId).ToHashSet();

        foreach (var p in procesos)
        {
            if (idsPorUnidad.Contains(p.ProcesoId))
                continue;

            procesosDisponibles.Add(new ProcesoSeleccionVm
            {
                Procesos = new List<ProcesoRefVm>
                {
                    new() { ProcesoId = p.ProcesoId, Codigo = p.Codigo, Nombre = p.Nombre }
                },
                UnidadNegocioId = null,
                UnidadCodigo = null,
                UnidadNombre = null,
                Seleccionado = true
            });
        }

        foreach (var procesoUnidad in procesos.Where(p => idsPorUnidad.Contains(p.ProcesoId)))
        {
            var refs = new List<ProcesoRefVm>
            {
                new() { ProcesoId = procesoUnidad.ProcesoId, Codigo = procesoUnidad.Codigo, Nombre = procesoUnidad.Nombre }
            };

            foreach (var u in unidades.Where(u => u.ProcesoId == procesoUnidad.ProcesoId))
            {
                procesosDisponibles.Add(new ProcesoSeleccionVm
                {
                    Procesos = refs,
                    UnidadNegocioId = u.UnidadNegocioId,
                    UnidadCodigo = u.Codigo,
                    UnidadNombre = u.Nombre,
                    Seleccionado = true
                });
            }
        }
    }

    private void AgregarLinea(ProcesoSeleccionVm p) =>
        p.Lineas.Add(new LineaVm());

    private void RemoverLinea(ProcesoSeleccionVm p, LineaVm linea)
    {
        if (p.Lineas.Count > 1)
            p.Lineas.Remove(linea);
    }

    private string GetAuditorKey(Auditor a) =>
        string.IsNullOrWhiteSpace(a.PcLoginId) ? a.Nombre : a.PcLoginId;

    private string GetAuditorDisplay(Auditor a)
    {
        var login = string.IsNullOrWhiteSpace(a.PcLoginId) ? "sin PC" : a.PcLoginId;
        return $"{a.Nombre} ({login}) - {a.Tipo}";
    }

    private string GetMeaxUserDisplay(MeaxAllUser u)
    {
        var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username;
        var depto = string.IsNullOrWhiteSpace(u.department) ? "" : $" - {u.department}";
        return $"{nombre} ({u.pc_login_id}){depto}";
    }

    private bool EstaExpandido(ProcesoSeleccionVm p) =>
        procesosExpandidos.Contains(p.Llave);

    private void ToggleExpandido(ProcesoSeleccionVm p)
    {
        if (!procesosExpandidos.Add(p.Llave))
            procesosExpandidos.Remove(p.Llave);
    }

    private void ExpandirSeleccionados()
    {
        procesosExpandidos.Clear();

        foreach (var p in procesosDisponibles.Where(x => x.Seleccionado))
            procesosExpandidos.Add(p.Llave);
    }

    private void ColapsarTodos() =>
        procesosExpandidos.Clear();

    private void ExpandirGrupo(bool esProduccion)
    {
        foreach (var p in procesosDisponibles.Where(x => x.EsProduccion == esProduccion && x.Seleccionado))
            procesosExpandidos.Add(p.Llave);
    }

    private void ColapsarGrupo(bool esProduccion)
    {
        foreach (var p in procesosDisponibles.Where(x => x.EsProduccion == esProduccion))
            procesosExpandidos.Remove(p.Llave);
    }

    private void CambiarSeleccion(ProcesoSeleccionVm p, ChangeEventArgs e)
    {
        var seleccionado = false;

        if (e.Value is bool b)
            seleccionado = b;
        else
            bool.TryParse(e.Value?.ToString(), out seleccionado);

        p.Seleccionado = seleccionado;

        if (seleccionado)
            procesosExpandidos.Add(p.Llave);
        else
            procesosExpandidos.Remove(p.Llave);
    }

    private void SeleccionarGrupo(bool esProduccion, bool seleccionado)
    {
        foreach (var p in procesosDisponibles.Where(x => x.EsProduccion == esProduccion))
        {
            p.Seleccionado = seleccionado;

            if (seleccionado)
                procesosExpandidos.Add(p.Llave);
            else
                procesosExpandidos.Remove(p.Llave);
        }
    }

    private int GetLineasValidas(ProcesoSeleccionVm p) =>
        p.Lineas.Count(l => !string.IsNullOrWhiteSpace(l.Nombre));

    private int GetTotalRegistros(ProcesoSeleccionVm p) =>
        (p.EsProduccion ? Math.Max(1, GetLineasValidas(p)) : 1) * p.Procesos.Count;

    private MeaxAllUser? BuscarAuditado(string? valor) =>
        string.IsNullOrWhiteSpace(valor)
            ? null
            : meaxUsers.FirstOrDefault(x =>
                string.Equals(x.pc_login_id, valor, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.username, valor, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MeaxAllUser> ObtenerAuditadosFiltrados(ProcesoSeleccionVm p)
    {
        var texto = (p.AuditadoBusqueda ?? "").Trim();

        IEnumerable<MeaxAllUser> query = meaxUsers;

        if (!string.IsNullOrWhiteSpace(texto))
        {
            query = query.Where(u =>
                (!string.IsNullOrWhiteSpace(u.pc_login_id) && u.pc_login_id.Contains(texto, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(u.username) && u.username.Contains(texto, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(u.email) && u.email.Contains(texto, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(u.department) && u.department.Contains(texto, StringComparison.OrdinalIgnoreCase)));
        }

        return query.Take(8);
    }

    private void MostrarOpcionesAuditado(ProcesoSeleccionVm p)
    {
        foreach (var item in procesosDisponibles)
            item.MostrarAuditadoOpciones = false;

        p.MostrarAuditadoOpciones = true;
    }

    private void ToggleOpcionesAuditado(ProcesoSeleccionVm p)
    {
        var abrir = !p.MostrarAuditadoOpciones;

        foreach (var item in procesosDisponibles)
            item.MostrarAuditadoOpciones = false;

        p.MostrarAuditadoOpciones = abrir;
    }

    private void BuscarAuditadoEnProceso(ProcesoSeleccionVm p, ChangeEventArgs e)
    {
        p.AuditadoBusqueda = e.Value?.ToString() ?? "";
        MostrarOpcionesAuditado(p);
    }

    private static List<string> ObtenerAuditadoIds(ProcesoSeleccionVm p) =>
        (p.AuditadoId ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private MeaxAllUser? BuscarAuditadoExacto(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return null;

        var texto = valor.Trim();

        return meaxUsers.FirstOrDefault(x =>
            string.Equals(x.pc_login_id, texto, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.username, texto, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.email, texto, StringComparison.OrdinalIgnoreCase));
    }

    private void SeleccionarAuditado(ProcesoSeleccionVm p, MeaxAllUser u)
    {
        if (string.IsNullOrWhiteSpace(u.pc_login_id))
            return;

        var actuales = ObtenerAuditadoIds(p);

        if (!actuales.Contains(u.pc_login_id, StringComparer.OrdinalIgnoreCase))
        {
            actuales.Add(u.pc_login_id);
            p.AuditadoId = string.Join(",", actuales);
        }

        p.AuditadoBusqueda = "";
        p.MostrarAuditadoOpciones = false;
    }

    private void QuitarAuditado(ProcesoSeleccionVm p, string loginId)
    {
        var actuales = ObtenerAuditadoIds(p);
        actuales.RemoveAll(x => string.Equals(x, loginId, StringComparison.OrdinalIgnoreCase));
        p.AuditadoId = string.Join(",", actuales);
    }

    private void LimpiarAuditado(ProcesoSeleccionVm p)
    {
        p.AuditadoId = "";
        p.AuditadoBusqueda = "";
        p.MostrarAuditadoOpciones = false;
    }

    private string GetAuditadoOptionTitle(MeaxAllUser u) =>
        string.IsNullOrWhiteSpace(u.username) ? (u.pc_login_id ?? "") : u.username!;

    private string GetAuditadoOptionMeta(MeaxAllUser u)
    {
        var login = string.IsNullOrWhiteSpace(u.pc_login_id) ? "" : u.pc_login_id;
        var depto = string.IsNullOrWhiteSpace(u.department) ? "" : $" - {u.department}";
        var puesto = string.IsNullOrWhiteSpace(u.position) ? "" : $" | {u.position}";
        return $"{login}{depto}{puesto}";
    }

    private string GetNombreAuditado(string loginId)
    {
        var usuario = BuscarAuditado(loginId);

        if (usuario is null)
            return loginId;

        var nombre = string.IsNullOrWhiteSpace(usuario.username)
            ? usuario.pc_login_id
            : usuario.username;

        if (!string.IsNullOrWhiteSpace(usuario.pc_login_id) &&
            !string.Equals(nombre, usuario.pc_login_id, StringComparison.OrdinalIgnoreCase))
        {
            return $"{nombre} ({usuario.pc_login_id})";
        }

        return nombre ?? loginId;
    }

    private string GetAuditadoTexto(ProcesoSeleccionVm p)
    {
        var ids = ObtenerAuditadoIds(p);

        return ids.Count == 0
            ? "Sin capturar"
            : string.Join(", ", ids.Select(GetNombreAuditado));
    }

    private string? ResolverAuditadoId(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return null;

        // Ya vienen como logins resueltos (separados por coma) desde la selección en pantalla.
        return valor.Trim();
    }

    private void SeleccionarTodos()
    {
        foreach (var item in procesosDisponibles)
        {
            item.Seleccionado = true;
            procesosExpandidos.Add(item.Llave);
        }
    }

    private void DeseleccionarTodos()
    {
        foreach (var item in procesosDisponibles)
            item.Seleccionado = false;

        procesosExpandidos.Clear();
    }

    private static string? LimpiarTexto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private async Task Guardar()
    {
        if (guardando) return;
        errorMsg = null;

        if (model.FechaFin.Date < model.FechaInicio.Date)
        {
            errorMsg = "La fecha fin no puede ser menor que la fecha inicio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.AuditorLiderId))
        {
            errorMsg = "Debes seleccionar un auditor líder.";
            return;
        }

        var seleccionados = procesosDisponibles
            .Where(x => x.Seleccionado)
            .ToList();

        if (seleccionados.Count == 0)
        {
            errorMsg = "Debes seleccionar al menos un proceso para crear la auditoría.";
            return;
        }

        guardando = true;

        try
        {
            model.Objetivo = model.Objetivo?.Trim() ?? "";
            model.Alcance = model.Alcance?.Trim() ?? "";
            model.Criterios = model.Criterios?.Trim() ?? "";
            model.Metodos = model.Metodos?.Trim() ?? "";
            model.AuditorLiderId = model.AuditorLiderId?.Trim() ?? "";

            Db.Auditorias.Add(model);
            await Db.SaveChangesAsync();

            var auditoriaId = model.AuditoriaId;
            var auditoriaProcesos = new List<AuditoriaProceso>();

            foreach (var p in seleccionados)
            {
                var auditadoId = ResolverAuditadoId(p.AuditadoId);

                if (p.EsProduccion)
                {
                    var lineasValidas = p.Lineas
                        .Where(l => !string.IsNullOrWhiteSpace(l.Nombre))
                        .ToList();

                    var lineasAProcesar = lineasValidas.Count == 0
                        ? new List<LineaVm> { p.Lineas.FirstOrDefault() ?? new LineaVm() }
                        : lineasValidas;

                    foreach (var procesoRef in p.Procesos)
                    {
                        foreach (var linea in lineasAProcesar)
                        {
                            auditoriaProcesos.Add(new AuditoriaProceso
                            {
                                AuditoriaId = auditoriaId,
                                ProcesoId = procesoRef.ProcesoId,
                                UnidadNegocioId = p.UnidadNegocioId,
                                AuditorAsignadoId = "",
                                AuditadoId = auditadoId,
                                LineaNombre = lineasValidas.Count == 0 ? "" : linea.Nombre.Trim(),
                                FechaProgramada = null,
                                ReclamosAuditoriasPasadas = LimpiarTexto(linea.ReclamosAuditoriasPasadas),
                                ResultadosAuditoriasInternasPrevias = LimpiarTexto(linea.ResultadosAuditoriasInternasPrevias),
                                SeguimientoAccionesCorrectivasIatf = LimpiarTexto(linea.SeguimientoAccionesCorrectivasIatf),
                                ClausulasIatfTop3NcmMayoresPasadas = LimpiarTexto(linea.ClausulasIatfTop3NcmMayoresPasadas),
                                ClausulasIatfTop3NcmMenoresPasadas = LimpiarTexto(linea.ClausulasIatfTop3NcmMenoresPasadas)
                            });
                        }
                    }
                }
                else
                {
                    auditoriaProcesos.Add(new AuditoriaProceso
                    {
                        AuditoriaId = auditoriaId,
                        ProcesoId = p.Procesos[0].ProcesoId,
                        UnidadNegocioId = null,
                        AuditorAsignadoId = "",
                        AuditadoId = auditadoId,
                        LineaNombre = null,
                        FechaProgramada = null,
                        ReclamosAuditoriasPasadas = LimpiarTexto(p.ReclamosAuditoriasPasadas),
                        ResultadosAuditoriasInternasPrevias = LimpiarTexto(p.ResultadosAuditoriasInternasPrevias),
                        SeguimientoAccionesCorrectivasIatf = LimpiarTexto(p.SeguimientoAccionesCorrectivasIatf),
                        ClausulasIatfTop3NcmMayoresPasadas = LimpiarTexto(p.ClausulasIatfTop3NcmMayoresPasadas),
                        ClausulasIatfTop3NcmMenoresPasadas = LimpiarTexto(p.ClausulasIatfTop3NcmMenoresPasadas)
                    });
                }
            }

            if (auditoriaProcesos.Count > 0)
            {
                Db.AuditoriaProcesos.AddRange(auditoriaProcesos);
                await Db.SaveChangesAsync();
            }

            Nav.NavigateTo($"auditorias/{auditoriaId}");
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar() => Nav.NavigateTo("auditorias");
}