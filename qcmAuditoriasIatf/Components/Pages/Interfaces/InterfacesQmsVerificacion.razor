@page "/interfaces/qms/verificacion-hallazgos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Evidencias
@using qcmAuditoriasIatf.Models.Hallazgos
@using qcmAuditoriasIatf.Services
@using System.Security.Claims
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject EmailService EmailSvc

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="interfaces-loading">
        <div class="interfaces-skeleton interfaces-skeleton-hero"></div>
        <div class="interfaces-metrics">
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
        </div>
        <div class="interfaces-skeleton interfaces-skeleton-table"></div>
    </div>
}
else if (!usuarioEsSgc)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">Acceso restringido</div>
            <div class="empty-text">
                Esta bandeja es exclusiva para usuarios del equipo QMS/SGC.
            </div>

            <button type="button" class="hero-btn primary mt-3" @onclick="IrInicio">
                Volver al inicio
            </button>
        </div>
    </section>
}
else
{
    <div class="interfaces-page">
        <section class="interfaces-hero">
            <div>
                <span class="interfaces-kicker">Interfaces · Verificación QMS</span>
                <h1>Verificación de hallazgos</h1>

                <div class="interfaces-meta">
                    <span class="meta-chip">
                        Usuario:
                        <strong>@usuarioActualId</strong>
                    </span>

                    <span class="meta-chip">
                        Pendientes de decisión:
                        <strong>@pendientes.Count</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Revisa la evidencia que subió el responsable de cierre y decide si el hallazgo se cierra o se rechaza para que suba evidencia nueva.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn" @onclick="IrInicio">
                    Volver
                </button>
            </div>
        </section>

        <section class="interfaces-metrics">
            <div class="metric-card">
                <div class="metric-label">Pendientes de decisión</div>
                <div class="metric-value">@pendientes.Count</div>
                <div class="metric-note">Con evidencia subida, esperando a QMS</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Cerrados por QMS</div>
                <div class="metric-value">@totalVerificados</div>
                <div class="metric-note">Total histórico</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Recientes</div>
                <div class="metric-value">@verificados.Count</div>
                <div class="metric-note">Últimos cerrados por QMS</div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Hallazgos con evidencia pendientes de decisión</h2>
                    <p class="panel-subtitle">Cierra el hallazgo si la evidencia es satisfactoria, o recházala para que el responsable suba una nueva.</p>
                </div>

                <span class="panel-badge">@pendientes.Count pendiente(s)</span>
            </div>

            @if (pendientes.Count == 0)
            {
                <div class="empty-state compact">
                    No hay hallazgos con evidencia pendiente de decisión.
                </div>
            }
            else
            {
                <div class="reviewed-list">
                    @foreach (var row in pendientes)
                    {
                        <div class="reviewed-item" @key="row.HallazgoId">
                            <div class="reviewed-head">
                                <div>
                                    <div class="reviewed-title">Hallazgo #@row.HallazgoId · Auditoría #@row.AuditoriaId</div>
                                    <div class="reviewed-subtitle">@row.ProcesoTexto</div>
                                </div>

                                <span class="validacion-pill pending">Pendiente de decisión</span>
                            </div>

                            <div class="reviewed-body">
                                <div class="reviewed-text">@row.Descripcion</div>

                                <div class="reviewed-meta">
                                    <span>Responsable: <strong>@MostrarPersona(row.ResponsableId, row.ResponsableId)</strong></span>
                                    <span>Responsable de cierre: <strong>@MostrarPersona(row.ResponsableCierreId, "Sin asignar")</strong></span>
                                    <span>Creado por: <strong>@MostrarPersona(row.CreadoPorId, "No registrado")</strong></span>
                                </div>

                                <div class="verificacion-evidencia">
                                    <div class="mini-label">Evidencia subida por el responsable</div>

                                    @if (row.EvidenciasResponsable.Count == 0)
                                    {
                                        <div class="empty-state compact">
                                            El responsable aún no ha adjuntado evidencia.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="evidencia-list">
                                            @foreach (var ev in row.EvidenciasResponsable)
                                            {
                                                <div class="evidencia-item" @key="ev.EvidenciaId">
                                                    <a href="@($"evidencias/{ev.EvidenciaId}")" target="_blank" class="evidencia-link">
                                                        @ev.NombreOriginal
                                                    </a>
                                                    <span class="evidencia-meta">
                                                        @ev.FechaCarga.ToString("yyyy-MM-dd HH:mm")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="verificacion-evidencia mt-2">
                                    <div class="mini-label">Evidencia adicional de QMS (opcional)</div>

                                    @if (row.EvidenciasQms.Count > 0)
                                    {
                                        <div class="evidencia-list mb-2">
                                            @foreach (var ev in row.EvidenciasQms)
                                            {
                                                <div class="evidencia-item" @key="ev.EvidenciaId">
                                                    <a href="@($"evidencias/{ev.EvidenciaId}")" target="_blank" class="evidencia-link">
                                                        @ev.NombreOriginal
                                                    </a>
                                                    <span class="evidencia-meta">
                                                        @ev.FechaCarga.ToString("yyyy-MM-dd HH:mm")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <InputFile OnChange="e => SubirEvidenciaQms(row, e)" multiple disabled="@row.SubiendoArchivo" />
                                    <div class="field-help">No es obligatorio. Tamaño máximo por archivo: 20 MB.</div>

                                    @if (row.SubiendoArchivo)
                                    {
                                        <div class="field-help">Subiendo...</div>
                                    }
                                </div>

                                <div class="comment-box mt-3">
                                    <div class="mini-label">Comentario (obligatorio solo si rechazas)</div>
                                    <InputTextArea class="mo-form-control review-textarea"
                                                   @bind-Value="row.ComentarioDecision"
                                                   rows="3"
                                                   disabled="@(guardandoHallazgoId == row.HallazgoId)" />
                                </div>
                            </div>

                            <div class="reviewed-actions">
                                <button type="button" class="table-btn" @onclick="() => VerDetalle(row.AuditoriaId, row.HallazgoId)">
                                    Ver detalle
                                </button>

                                <button type="button"
                                        class="table-btn table-btn-success"
                                        @onclick="() => ResolverHallazgo(row, true)"
                                        disabled="@(guardandoHallazgoId == row.HallazgoId)">
                                    @(guardandoHallazgoId == row.HallazgoId ? "Guardando..." : "Cerrar hallazgo")
                                </button>

                                <button type="button"
                                        class="table-btn table-btn-danger"
                                        @onclick="() => ResolverHallazgo(row, false)"
                                        disabled="@(guardandoHallazgoId == row.HallazgoId)">
                                    @(guardandoHallazgoId == row.HallazgoId ? "Guardando..." : "Rechazar")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Últimos hallazgos cerrados por QMS</h2>
                    <p class="panel-subtitle">Historial reciente de cierres.</p>
                </div>

                <span class="panel-badge">@verificados.Count reciente(s)</span>
            </div>

            @if (verificados.Count == 0)
            {
                <div class="empty-state compact">
                    Aún no hay hallazgos cerrados por QMS.
                </div>
            }
            else
            {
                <div class="reviewed-list">
                    @foreach (var row in verificados)
                    {
                        <div class="reviewed-item" @key="row.HallazgoId">
                            <div class="reviewed-head">
                                <div>
                                    <div class="reviewed-title">Hallazgo #@row.HallazgoId · Auditoría #@row.AuditoriaId</div>
                                    <div class="reviewed-subtitle">@row.ProcesoTexto</div>
                                </div>

                                <span class="validacion-pill approved">Cerrado</span>
                            </div>

                            <div class="reviewed-body">
                                <div class="reviewed-text">@row.Descripcion</div>

                                <div class="reviewed-meta">
                                    <span>Responsable de cierre: <strong>@MostrarPersona(row.ResponsableCierreId, "Sin asignar")</strong></span>
                                    <span>Cerró: <strong>@MostrarPersona(row.VerificadoPorId, "—")</strong></span>
                                    @if (row.FechaVerificacionQms.HasValue)
                                    {
                                        <span>Fecha: <strong>@row.FechaVerificacionQms.Value.ToString("yyyy-MM-dd HH:mm")</strong></span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(row.ComentarioVerificacionQms))
                                {
                                    <div class="comment-box">
                                        <div class="mini-label">Comentario</div>
                                        <div>@row.ComentarioVerificacionQms</div>
                                    </div>
                                }
                            </div>

                            <div class="reviewed-actions">
                                <button type="button" class="table-btn" @onclick="() => VerDetalle(row.AuditoriaId, row.HallazgoId)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly Dictionary<string, string> personasDisplay = new(StringComparer.OrdinalIgnoreCase);

    private bool cargando = true;
    private string? errorMsg;
    private int? guardandoHallazgoId;

    private string usuarioActualId = "sistema";
    private bool usuarioEsSgc;

    private int totalVerificados;

    private List<VerificacionRowVm> pendientes = new();
    private List<VerificacionRowVm> verificados = new();

    private class VerificacionRowVm
    {
        public int HallazgoId { get; set; }
        public int AuditoriaId { get; set; }
        public string ProcesoTexto { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string ResponsableId { get; set; } = "";
        public string? ResponsableCierreId { get; set; }
        public string? CreadoPorId { get; set; }
        public string? VerificadoPorId { get; set; }
        public DateTime? FechaVerificacionQms { get; set; }
        public string? ComentarioVerificacionQms { get; set; }
        public List<Evidencia> EvidenciasResponsable { get; set; } = new();
        public List<Evidencia> EvidenciasQms { get; set; } = new();
        public string? ComentarioDecision { get; set; }
        public bool SubiendoArchivo { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            await CargarUsuarioActual();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.ToString();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarUsuarioActual()
    {
        if (AuthenticationStateTask is null)
            return;

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            usuarioActualId =
                user.FindFirst("pc_login_id")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? "sistema";
        }

        var loginNormalizado = (usuarioActualId ?? "").Trim().ToUpper();

        usuarioEsSgc = await Db.UsuariosPerfil
            .AsNoTracking()
            .AnyAsync(x =>
                x.Activo &&
                x.PcLoginId.ToUpper() == loginNormalizado &&
                (x.Perfil == "SGC" || x.Perfil == "Administrador"));
    }

    private async Task CargarPantalla()
    {
        // El DbContext de Blazor Server vive por sesión: limpiamos el tracker para no
        // arrastrar entidades desactualizadas de otra pantalla u otra acción.
        Db.ChangeTracker.Clear();

        pendientes.Clear();
        verificados.Clear();
        personasDisplay.Clear();

        if (!usuarioEsSgc)
            return;

        totalVerificados = await Db.Hallazgos.CountAsync(h => h.VerificadoQms);

        var idsConEvidencia = await Db.Evidencias
            .AsNoTracking()
            .Where(e => e.ReferenciaTipo == "Hallazgo")
            .Select(e => e.ReferenciaId)
            .Distinct()
            .ToListAsync();

        var pendientesEntity = await Db.Hallazgos
            .AsNoTracking()
            .Include(h => h.Proceso)
            .Where(h => h.Estatus != "Cerrado" && idsConEvidencia.Contains(h.HallazgoId))
            .OrderBy(h => h.FechaCreacion)
            .ThenBy(h => h.HallazgoId)
            .ToListAsync();

        pendientes = pendientesEntity.Select(MapRow).ToList();

        var verificadosEntity = await Db.Hallazgos
            .AsNoTracking()
            .Include(h => h.Proceso)
            .Where(h => h.VerificadoQms)
            .OrderByDescending(h => h.FechaVerificacionQms)
            .ThenByDescending(h => h.HallazgoId)
            .Take(12)
            .ToListAsync();

        verificados = verificadosEntity.Select(MapRow).ToList();

        var idsHallazgos = pendientes.Select(x => x.HallazgoId)
            .Concat(verificados.Select(x => x.HallazgoId))
            .ToList();

        var evidencias = await Db.Evidencias
            .AsNoTracking()
            .Where(e =>
                (e.ReferenciaTipo == "Hallazgo" || e.ReferenciaTipo == "VerificacionQms") &&
                idsHallazgos.Contains(e.ReferenciaId))
            .OrderByDescending(e => e.FechaCarga)
            .ToListAsync();

        foreach (var row in pendientes.Concat(verificados))
        {
            row.EvidenciasResponsable = evidencias
                .Where(e => e.ReferenciaTipo == "Hallazgo" && e.ReferenciaId == row.HallazgoId)
                .ToList();

            row.EvidenciasQms = evidencias
                .Where(e => e.ReferenciaTipo == "VerificacionQms" && e.ReferenciaId == row.HallazgoId)
                .ToList();
        }

        await CargarPersonasDisplay(
            pendientes.SelectMany(x => new string?[] { x.ResponsableId, x.ResponsableCierreId, x.CreadoPorId })
                .Concat(verificados.SelectMany(x => new string?[] { x.ResponsableCierreId, x.VerificadoPorId })));
    }

    private static VerificacionRowVm MapRow(Hallazgo h) => new()
    {
        HallazgoId = h.HallazgoId,
        AuditoriaId = h.AuditoriaId,
        ProcesoTexto = $"{h.Proceso?.Codigo} - {h.Proceso?.Nombre}",
        Descripcion = h.Descripcion,
        ResponsableId = h.ResponsableId,
        ResponsableCierreId = h.ResponsableCierreId,
        CreadoPorId = h.CreadoPorId,
        VerificadoPorId = h.VerificadoPorId,
        FechaVerificacionQms = h.FechaVerificacionQms,
        ComentarioVerificacionQms = h.ComentarioVerificacionQms
    };

    private async Task SubirEvidenciaQms(VerificacionRowVm row, InputFileChangeEventArgs e)
    {
        if (row.SubiendoArchivo)
            return;

        const long maxBytes = 20 * 1024 * 1024;
        row.SubiendoArchivo = true;
        errorMsg = null;

        try
        {
            var carpeta = Path.Combine(Env.ContentRootPath, "App_Data", "evidencias", "verificacion-qms", row.HallazgoId.ToString());
            Directory.CreateDirectory(carpeta);

            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > maxBytes)
                {
                    errorMsg = $"El archivo \"{file.Name}\" excede el límite de 20 MB y no se subió.";
                    continue;
                }

                var nombreArchivo = $"{Guid.NewGuid():N}{Path.GetExtension(file.Name)}";
                var rutaCompleta = Path.Combine(carpeta, nombreArchivo);

                await using (var origen = file.OpenReadStream(maxAllowedSize: maxBytes))
                await using (var destino = File.Create(rutaCompleta))
                {
                    await origen.CopyToAsync(destino);
                }

                Db.Evidencias.Add(new Evidencia
                {
                    ReferenciaTipo = "VerificacionQms",
                    ReferenciaId = row.HallazgoId,
                    RutaArchivo = Path.Combine("verificacion-qms", row.HallazgoId.ToString(), nombreArchivo),
                    NombreOriginal = file.Name,
                    TipoArchivo = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    FechaCarga = DateTime.Now,
                    UsuarioId = usuarioActualId
                });
            }

            await Db.SaveChangesAsync();

            row.EvidenciasQms = await Db.Evidencias
                .AsNoTracking()
                .Where(ev => ev.ReferenciaTipo == "VerificacionQms" && ev.ReferenciaId == row.HallazgoId)
                .OrderByDescending(ev => ev.FechaCarga)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            row.SubiendoArchivo = false;
        }
    }

    private async Task ResolverHallazgo(VerificacionRowVm row, bool cerrar)
    {
        if (guardandoHallazgoId.HasValue) return;
        errorMsg = null;

        if (!usuarioEsSgc)
        {
            errorMsg = "No tienes permisos para resolver hallazgos.";
            return;
        }

        var comentario = row.ComentarioDecision?.Trim();

        if (!cerrar && string.IsNullOrWhiteSpace(comentario))
        {
            errorMsg = "Debes capturar un comentario para rechazar la evidencia.";
            return;
        }

        guardandoHallazgoId = row.HallazgoId;

        try
        {
            var entity = await Db.Hallazgos
                .Include(h => h.AuditoriaProceso)
                .FirstOrDefaultAsync(h => h.HallazgoId == row.HallazgoId);

            if (entity is null)
            {
                errorMsg = "No se encontró el hallazgo.";
                return;
            }

            if (string.Equals(entity.Estatus, "Cerrado", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Este hallazgo ya está cerrado.";
                return;
            }

            if (cerrar)
            {
                entity.Estatus = "Cerrado";
                entity.VerificadoQms = true;
                entity.VerificadoPorId = usuarioActualId;
                entity.FechaVerificacionQms = DateTime.Now;
                entity.ComentarioVerificacionQms = string.IsNullOrWhiteSpace(comentario) ? null : comentario;

                Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
                {
                    HallazgoId = entity.HallazgoId,
                    UsuarioId = usuarioActualId,
                    Comentario = $"QMS cerró el hallazgo.{(string.IsNullOrWhiteSpace(comentario) ? "" : $" Comentario: {comentario}")}",
                    EstatusNuevo = "Cerrado"
                });
            }
            else
            {
                entity.Estatus = "En Proceso";

                Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
                {
                    HallazgoId = entity.HallazgoId,
                    UsuarioId = usuarioActualId,
                    Comentario = $"QMS rechazó la evidencia. Motivo: {comentario}",
                    EstatusNuevo = "En Proceso"
                });
            }

            await Db.SaveChangesAsync();
            await NotificarDecisionAsync(entity, cerrar);

            row.ComentarioDecision = null;
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardandoHallazgoId = null;
        }
    }

    private async Task NotificarDecisionAsync(Hallazgo entity, bool cerrar)
    {
        try
        {
            var auditores = await EmailSvc.ResolverAuditoresAsync(entity.AuditoriaProceso);
            var responsableCierre = await EmailSvc.ResolverEmailAsync(entity.ResponsableCierreId);

            var destinatarios = new List<string>(auditores);
            if (responsableCierre is not null)
                destinatarios.Add(responsableCierre);

            await EmailSvc.NotificarAsync(destinatarios, auditores);
        }
        catch
        {
            // El envío de correo no debe bloquear la decisión de QMS.
        }
    }

    private async Task CargarPersonasDisplay(IEnumerable<string?> valores)
    {
        var ids = valores
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (ids.Count == 0)
            return;

        var auditores = await Db.Auditores
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.PcLoginId) && ids.Contains(x.PcLoginId)) ||
                ids.Contains(x.Nombre))
            .ToListAsync();

        foreach (var a in auditores)
        {
            var display = !string.IsNullOrWhiteSpace(a.PcLoginId) &&
                          !string.Equals(a.Nombre.Trim(), a.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{a.Nombre} ({a.PcLoginId})"
                : a.Nombre;

            if (!string.IsNullOrWhiteSpace(a.PcLoginId))
                personasDisplay[a.PcLoginId.Trim()] = display;

            personasDisplay[a.Nombre.Trim()] = display;
        }

        var faltantes = ids
            .Where(x => !personasDisplay.ContainsKey(x))
            .ToList();

        if (faltantes.Count == 0)
            return;

        var usuarios = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.pc_login_id) && faltantes.Contains(x.pc_login_id)) ||
                (!string.IsNullOrWhiteSpace(x.username) && faltantes.Contains(x.username)))
            .ToListAsync();

        foreach (var u in usuarios)
        {
            var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username!;
            var display = !string.IsNullOrWhiteSpace(u.pc_login_id) &&
                          !string.Equals(nombre.Trim(), u.pc_login_id.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{nombre} ({u.pc_login_id})"
                : nombre;

            if (!string.IsNullOrWhiteSpace(u.pc_login_id))
                personasDisplay[u.pc_login_id.Trim()] = display;

            if (!string.IsNullOrWhiteSpace(u.username))
                personasDisplay[u.username.Trim()] = display;
        }

        foreach (var id in ids)
        {
            if (!personasDisplay.ContainsKey(id))
                personasDisplay[id] = id;
        }
    }

    private string MostrarPersona(string? valor, string fallback = "Sin asignar")
    {
        if (string.IsNullOrWhiteSpace(valor))
            return fallback;

        var clave = valor.Trim();
        return personasDisplay.TryGetValue(clave, out var nombre) ? nombre : clave;
    }

    private void VerDetalle(int auditoriaId, int hallazgoId) =>
        Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{hallazgoId}");

    private void IrInicio() => Nav.NavigateTo("");
}
