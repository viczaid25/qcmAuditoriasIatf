@page "/interfaces/sgc/cinco-porques"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Hallazgos
@using System.Security.Claims
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="interfaces-loading">
        <div class="interfaces-skeleton interfaces-skeleton-hero"></div>
        <div class="interfaces-metrics">
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
        </div>
        <div class="interfaces-skeleton interfaces-skeleton-table"></div>
    </div>
}
else if (!usuarioEsSgc)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">Acceso restringido</div>
            <div class="empty-text">
                Esta bandeja es exclusiva para usuarios del equipo SGC.
            </div>

            <button type="button" class="hero-btn primary mt-3" @onclick="IrInicio">
                Volver al inicio
            </button>
        </div>
    </section>
}
else
{
    <div class="interfaces-page">
        <section class="interfaces-hero">
            <div>
                <span class="interfaces-kicker">Interfaces · Validación SGC</span>
                <h1>Validación SGC de 5 porqués</h1>

                <div class="interfaces-meta">
                    <span class="meta-chip">
                        Usuario:
                        <strong>@usuarioActualId</strong>
                    </span>

                    @if (!string.IsNullOrWhiteSpace(usuarioActualNombre) && usuarioActualNombre != usuarioActualId)
                    {
                        <span class="meta-chip">
                            Nombre:
                            <strong>@usuarioActualNombre</strong>
                        </span>
                    }

                    <span class="meta-chip">
                        Pendientes:
                        <strong>@cincoPorQuesPendientes.Count</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Revisa y aprueba o rechaza el análisis de causa raíz (5 porqués) de los hallazgos NC Menor.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn" @onclick="IrInicio">
                    Volver
                </button>
            </div>
        </section>

        <section class="interfaces-metrics">
            <div class="metric-card">
                <div class="metric-label">Pendientes</div>
                <div class="metric-value">@cincoPorQuesPendientes.Count</div>
                <div class="metric-note">Análisis de causa esperando aprobación SGC</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Aprobados</div>
                <div class="metric-value">@totalAprobados</div>
                <div class="metric-note">5 porqués liberados</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Rechazados</div>
                <div class="metric-value">@totalRechazados</div>
                <div class="metric-note">Con observaciones de SGC</div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>5 porqués pendientes de aprobación</h2>
                    <p class="panel-subtitle">Análisis de causa raíz de hallazgos NC Menor, a la espera de decisión SGC.</p>
                </div>

                <span class="panel-badge">@cincoPorQuesPendientes.Count pendiente(s)</span>
            </div>

            @if (cincoPorQuesPendientes.Count == 0)
            {
                <div class="empty-state compact">
                    No hay análisis de 5 porqués pendientes de revisión SGC.
                </div>
            }
            else
            {
                <div class="mo-table-wrap" data-mo-table data-page-size="10">
                    <table class="mo-table">
                        <thead>
                            <tr>
                                <th>Hallazgo</th>
                                <th>Proceso</th>
                                <th>Tipo</th>
                                <th>Por qué 1</th>
                                <th>Por qué 2</th>
                                <th>Por qué 3</th>
                                <th>Capturó</th>
                                <th>Fecha</th>
                                <th></th>
                            </tr>
                            <tr class="mo-table-filter-row">
                                <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="4" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="5" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="6" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="7" placeholder="Filtrar…"></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cincoPorQuesPendientes)
                            {
                                <tr @key="row.HallazgoCincoPorQueId">
                                    <td>
                                        <span class="id-pill">#@row.HallazgoId</span>
                                    </td>

                                    <td>
                                        <div class="cell-title">@row.ProcesoTexto</div>
                                    </td>

                                    <td>
                                        <span class="tipo-pill @GetTipoClass(row.TipoHallazgoNombre)">
                                            @row.TipoHallazgoNombre
                                        </span>
                                    </td>

                                    <td>
                                        <div class="desc-cell">@row.PorQue1</div>
                                    </td>

                                    <td>
                                        <div class="desc-cell">@row.PorQue2</div>
                                    </td>

                                    <td>
                                        <div class="desc-cell">@row.PorQue3</div>
                                    </td>

                                    <td>
                                        <div class="cell-title">@MostrarPersona(row.UsuarioRegistroId, row.UsuarioRegistroId)</div>
                                    </td>

                                    <td>
                                        <div class="cell-title">@row.FechaRegistro.ToString("yyyy-MM-dd")</div>
                                        <div class="cell-subtitle">@row.FechaRegistro.ToString("HH:mm")</div>
                                    </td>

                                    <td>
                                        <div class="review-box">
                                            <label class="form-label small-label">Comentario SGC</label>
                                            <InputTextArea class="mo-form-control review-textarea"
                                                           @bind-Value="row.ComentarioSgc"
                                                           rows="3"
                                                           disabled="@(guardandoCincoPorQueId == row.HallazgoCincoPorQueId)" />

                                            <div class="review-actions">
                                                <button type="button"
                                                        class="table-btn"
                                                        @onclick="() => VerDetalleHallazgo(row.AuditoriaId, row.HallazgoId)"
                                                        disabled="@(guardandoCincoPorQueId == row.HallazgoCincoPorQueId)">
                                                    Ver detalle
                                                </button>

                                                <button type="button"
                                                        class="table-btn table-btn-success"
                                                        @onclick="() => ResolverCincoPorQue(row.HallazgoCincoPorQueId, true)"
                                                        disabled="@(guardandoCincoPorQueId == row.HallazgoCincoPorQueId)">
                                                    @(guardandoCincoPorQueId == row.HallazgoCincoPorQueId ? "Guardando..." : "Aprobar")
                                                </button>

                                                <button type="button"
                                                        class="table-btn table-btn-danger"
                                                        @onclick="() => ResolverCincoPorQue(row.HallazgoCincoPorQueId, false)"
                                                        disabled="@(guardandoCincoPorQueId == row.HallazgoCincoPorQueId)">
                                                    @(guardandoCincoPorQueId == row.HallazgoCincoPorQueId ? "Guardando..." : "Rechazar")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mo-table-pagination" data-mo-pagination></div>
            }
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Últimos revisados</h2>
                    <p class="panel-subtitle">Historial reciente de aprobaciones y rechazos SGC de 5 porqués.</p>
                </div>

                <span class="panel-badge">@revisados.Count reciente(s)</span>
            </div>

            @if (revisados.Count == 0)
            {
                <div class="empty-state compact">
                    Aún no hay análisis de 5 porqués revisados por SGC.
                </div>
            }
            else
            {
                <div class="reviewed-list">
                    @foreach (var row in revisados)
                    {
                        <div class="reviewed-item" @key="row.HallazgoCincoPorQueId">
                            <div class="reviewed-head">
                                <div>
                                    <div class="reviewed-title">Hallazgo #@row.HallazgoId</div>
                                    <div class="reviewed-subtitle">@row.ProcesoTexto · @row.TipoHallazgoNombre</div>
                                </div>

                                <span class="validacion-pill @GetValidacionClass(row.Estatus)">
                                    @row.Estatus
                                </span>
                            </div>

                            <div class="reviewed-body">
                                <div class="reviewed-meta">
                                    <span>Capturó: <strong>@MostrarPersona(row.UsuarioRegistroId, row.UsuarioRegistroId)</strong></span>
                                    <span>Revisó: <strong>@MostrarPersona(row.RevisadoPorSgcId, "—")</strong></span>
                                    @if (row.FechaRevisionSgc.HasValue)
                                    {
                                        <span>Fecha: <strong>@row.FechaRevisionSgc.Value.ToString("yyyy-MM-dd HH:mm")</strong></span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(row.ComentarioSgc))
                                {
                                    <div class="comment-box">
                                        <div class="mini-label">Comentario SGC</div>
                                        <div>@row.ComentarioSgc</div>
                                    </div>
                                }
                            </div>

                            <div class="reviewed-actions">
                                <button type="button" class="table-btn" @onclick="() => VerDetalleHallazgo(row.AuditoriaId, row.HallazgoId)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly Dictionary<string, string> personasDisplay = new(StringComparer.OrdinalIgnoreCase);

    private bool cargando = true;
    private string? errorMsg;
    private int? guardandoCincoPorQueId;

    private string usuarioActualId = "sistema";
    private string usuarioActualNombre = "sistema";
    private bool usuarioEsSgc;

    private int totalAprobados;
    private int totalRechazados;

    private List<CincoPorQueRowVm> cincoPorQuesPendientes = new();
    private List<CincoPorQueRowVm> revisados = new();

    private class CincoPorQueRowVm
    {
        public int HallazgoCincoPorQueId { get; set; }
        public int HallazgoId { get; set; }
        public int AuditoriaId { get; set; }
        public string ProcesoTexto { get; set; } = "";
        public string TipoHallazgoNombre { get; set; } = "";
        public string PorQue1 { get; set; } = "";
        public string PorQue2 { get; set; } = "";
        public string PorQue3 { get; set; } = "";
        public string UsuarioRegistroId { get; set; } = "";
        public DateTime FechaRegistro { get; set; }
        public string Estatus { get; set; } = "";
        public string? RevisadoPorSgcId { get; set; }
        public DateTime? FechaRevisionSgc { get; set; }
        public string? ComentarioSgc { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            await CargarUsuarioActual();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.ToString();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarUsuarioActual()
    {
        if (AuthenticationStateTask is null)
            return;

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            usuarioActualId =
                user.FindFirst("pc_login_id")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? "sistema";

            usuarioActualNombre =
                user.Identity?.Name
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? usuarioActualId;
        }

        var loginNormalizado = (usuarioActualId ?? "").Trim().ToUpper();

        usuarioEsSgc = await Db.UsuariosPerfil
            .AsNoTracking()
            .AnyAsync(x =>
                x.Activo &&
                x.PcLoginId.ToUpper() == loginNormalizado &&
                (x.Perfil == "SGC" || x.Perfil == "Administrador"));
    }

    private async Task CargarPantalla()
    {
        cincoPorQuesPendientes.Clear();
        revisados.Clear();
        personasDisplay.Clear();

        if (!usuarioEsSgc)
            return;

        totalAprobados = await Db.HallazgosCincoPorQue.CountAsync(x => x.Estatus == "Aprobado");
        totalRechazados = await Db.HallazgosCincoPorQue.CountAsync(x => x.Estatus == "Rechazado");

        var pendientesEntity = await Db.HallazgosCincoPorQue
            .AsNoTracking()
            .Include(x => x.Hallazgo!).ThenInclude(h => h.Proceso)
            .Include(x => x.Hallazgo!).ThenInclude(h => h.TipoHallazgo)
            .Where(x => x.Estatus == "Pendiente")
            .OrderBy(x => x.FechaRegistro)
            .ToListAsync();

        cincoPorQuesPendientes = pendientesEntity
            .Where(x => x.Hallazgo is not null)
            .Select(MapRow)
            .ToList();

        var revisadosEntity = await Db.HallazgosCincoPorQue
            .AsNoTracking()
            .Include(x => x.Hallazgo!).ThenInclude(h => h.Proceso)
            .Include(x => x.Hallazgo!).ThenInclude(h => h.TipoHallazgo)
            .Where(x => x.Estatus == "Aprobado" || x.Estatus == "Rechazado")
            .OrderByDescending(x => x.FechaRevisionSgc ?? x.FechaRegistro)
            .ThenByDescending(x => x.HallazgoCincoPorQueId)
            .Take(12)
            .ToListAsync();

        revisados = revisadosEntity
            .Where(x => x.Hallazgo is not null)
            .Select(MapRow)
            .ToList();

        await CargarPersonasDisplay(
            cincoPorQuesPendientes.Select(x => (string?)x.UsuarioRegistroId)
                .Concat(revisados.SelectMany(x => new string?[] { x.UsuarioRegistroId, x.RevisadoPorSgcId })));
    }

    private static CincoPorQueRowVm MapRow(HallazgoCincoPorQue x) => new()
    {
        HallazgoCincoPorQueId = x.HallazgoCincoPorQueId,
        HallazgoId = x.HallazgoId,
        AuditoriaId = x.Hallazgo!.AuditoriaId,
        ProcesoTexto = $"{x.Hallazgo.Proceso?.Codigo} - {x.Hallazgo.Proceso?.Nombre}",
        TipoHallazgoNombre = x.Hallazgo.TipoHallazgo?.Nombre ?? "Sin tipo",
        PorQue1 = x.PorQue1,
        PorQue2 = x.PorQue2,
        PorQue3 = x.PorQue3,
        UsuarioRegistroId = x.UsuarioRegistroId,
        FechaRegistro = x.FechaRegistro,
        Estatus = x.Estatus,
        RevisadoPorSgcId = x.RevisadoPorSgcId,
        FechaRevisionSgc = x.FechaRevisionSgc,
        ComentarioSgc = x.ComentarioSgc
    };

    private async Task ResolverCincoPorQue(int hallazgoCincoPorQueId, bool aprobado)
    {
        if (guardandoCincoPorQueId.HasValue) return;
        errorMsg = null;

        if (!usuarioEsSgc)
        {
            errorMsg = "No tienes permisos para revisar 5 porqués de SGC.";
            return;
        }

        var row = cincoPorQuesPendientes.FirstOrDefault(x => x.HallazgoCincoPorQueId == hallazgoCincoPorQueId);
        if (row is null)
        {
            errorMsg = "No se encontró el registro de 5 porqués pendiente.";
            return;
        }

        var comentario = row.ComentarioSgc?.Trim();

        if (!aprobado && string.IsNullOrWhiteSpace(comentario))
        {
            errorMsg = "Debes capturar un comentario cuando rechazas los 5 porqués.";
            return;
        }

        guardandoCincoPorQueId = hallazgoCincoPorQueId;

        try
        {
            var entity = await Db.HallazgosCincoPorQue
                .FirstOrDefaultAsync(x => x.HallazgoCincoPorQueId == hallazgoCincoPorQueId);

            if (entity is null)
            {
                errorMsg = "No se encontró el registro de 5 porqués.";
                return;
            }

            if (!string.Equals(entity.Estatus, "Pendiente", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Este análisis de 5 porqués ya no está pendiente de revisión.";
                return;
            }

            entity.Estatus = aprobado ? "Aprobado" : "Rechazado";
            entity.RevisadoPorSgcId = usuarioActualId;
            entity.FechaRevisionSgc = DateTime.Now;
            entity.ComentarioSgc = string.IsNullOrWhiteSpace(comentario) ? null : comentario;

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = entity.HallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = aprobado
                    ? $"SGC aprobó los 5 porqués.{(string.IsNullOrWhiteSpace(comentario) ? "" : $" Comentario: {comentario}")}"
                    : $"SGC rechazó los 5 porqués. Motivo: {comentario}"
            });

            await Db.SaveChangesAsync();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardandoCincoPorQueId = null;
        }
    }

    private async Task CargarPersonasDisplay(IEnumerable<string?> valores)
    {
        var ids = valores
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (ids.Count == 0)
            return;

        var auditores = await Db.Auditores
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.PcLoginId) && ids.Contains(x.PcLoginId)) ||
                ids.Contains(x.Nombre))
            .ToListAsync();

        foreach (var a in auditores)
        {
            var display = !string.IsNullOrWhiteSpace(a.PcLoginId) &&
                          !string.Equals(a.Nombre.Trim(), a.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{a.Nombre} ({a.PcLoginId})"
                : a.Nombre;

            if (!string.IsNullOrWhiteSpace(a.PcLoginId))
                personasDisplay[a.PcLoginId.Trim()] = display;

            personasDisplay[a.Nombre.Trim()] = display;
        }

        var faltantes = ids
            .Where(x => !personasDisplay.ContainsKey(x))
            .ToList();

        if (faltantes.Count == 0)
            return;

        var usuarios = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.pc_login_id) && faltantes.Contains(x.pc_login_id)) ||
                (!string.IsNullOrWhiteSpace(x.username) && faltantes.Contains(x.username)))
            .ToListAsync();

        foreach (var u in usuarios)
        {
            var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username!;
            var display = !string.IsNullOrWhiteSpace(u.pc_login_id) &&
                          !string.Equals(nombre.Trim(), u.pc_login_id.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{nombre} ({u.pc_login_id})"
                : nombre;

            if (!string.IsNullOrWhiteSpace(u.pc_login_id))
                personasDisplay[u.pc_login_id.Trim()] = display;

            if (!string.IsNullOrWhiteSpace(u.username))
                personasDisplay[u.username.Trim()] = display;
        }

        foreach (var id in ids)
        {
            if (!personasDisplay.ContainsKey(id))
                personasDisplay[id] = id;
        }
    }

    private string MostrarPersona(string? valor, string fallback = "Sin asignar")
    {
        if (string.IsNullOrWhiteSpace(valor))
            return fallback;

        var clave = valor.Trim();
        return personasDisplay.TryGetValue(clave, out var nombre) ? nombre : clave;
    }

    private static string GetTipoClass(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor.Contains("mayor"))
            return "major";

        if (valor.Contains("menor"))
            return "minor";

        return "neutral";
    }

    private static string GetValidacionClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "aprobado")
            return "approved";

        if (valor == "rechazado")
            return "rejected";

        return "pending";
    }

    private void VerDetalleHallazgo(int auditoriaId, int hallazgoId) =>
        Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{hallazgoId}");

    private void IrInicio() => Nav.NavigateTo("");
}
