@page "/interfaces/sgc/hallazgos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Catalogos
@using qcmAuditoriasIatf.Models.Hallazgos
@using System.Security.Claims
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="interfaces-loading">
        <div class="interfaces-skeleton interfaces-skeleton-hero"></div>
        <div class="interfaces-metrics">
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
        </div>
        <div class="interfaces-skeleton interfaces-skeleton-table"></div>
    </div>
}
else if (!usuarioEsSgc)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">Acceso restringido</div>
            <div class="empty-text">
                Esta bandeja es exclusiva para usuarios del equipo SGC.
            </div>

            <button type="button" class="hero-btn primary mt-3" @onclick="IrInicio">
                Volver al inicio
            </button>
        </div>
    </section>
}
else
{
    <div class="interfaces-page">
        <section class="interfaces-hero">
            <div>
                <span class="interfaces-kicker">Interfaces · Validación SGC</span>
                <h1>Validación SGC de hallazgos</h1>

                <div class="interfaces-meta">
                    <span class="meta-chip">
                        Usuario:
                        <strong>@usuarioActualId</strong>
                    </span>

                    @if (!string.IsNullOrWhiteSpace(usuarioActualNombre) && usuarioActualNombre != usuarioActualId)
                    {
                        <span class="meta-chip">
                            Nombre:
                            <strong>@usuarioActualNombre</strong>
                        </span>
                    }

                    <span class="meta-chip">
                        Pendientes:
                        <strong>@pendientes.Count</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Revisa los hallazgos generados desde checklist antes de que entren al flujo normal del responsable del hallazgo.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn" @onclick="IrInicio">
                    Volver
                </button>
            </div>
        </section>

        <section class="interfaces-metrics">
            <div class="metric-card">
                <div class="metric-label">Pendientes SGC</div>
                <div class="metric-value">@pendientes.Count</div>
                <div class="metric-note">Esperando revisión del equipo SGC</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Aprobados</div>
                <div class="metric-value">@totalAprobados</div>
                <div class="metric-note">Ya liberados al flujo operativo</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Rechazados</div>
                <div class="metric-value">@totalRechazados</div>
                <div class="metric-note">Con observaciones de SGC</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Recientes</div>
                <div class="metric-value">@revisados.Count</div>
                <div class="metric-note">Últimos revisados por SGC</div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Hallazgos pendientes de validación</h2>
                    <p class="panel-subtitle">Aprobación o rechazo previo a la liberación del hallazgo.</p>
                </div>

                <span class="panel-badge">@pendientes.Count pendiente(s)</span>
            </div>

            @if (pendientes.Count == 0)
            {
                <div class="empty-state compact">
                    No hay hallazgos pendientes de validación SGC.
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="sgc-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Auditoría</th>
                                <th>Proceso</th>
                                <th>Tipo</th>
                                <th>Descripción</th>
                                <th>Responsables</th>
                                <th>Creación</th>
                                <th>Revisión SGC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in pendientes)
                            {
                                <tr>
                                    <td>
                                        <span class="id-pill">#@row.HallazgoId</span>
                                    </td>

                                    <td>
                                        <div class="cell-title">#@row.AuditoriaId</div>
                                        <div class="cell-subtitle">@row.ClausulaTexto</div>
                                    </td>

                                    <td>
                                        <div class="cell-title">@row.ProcesoTexto</div>
                                    </td>

                                    <td>
                                        <span class="tipo-pill @GetTipoClass(row.TipoHallazgoNombre)">
                                            @row.TipoHallazgoNombre
                                        </span>
                                    </td>

                                    <td>
                                        <div class="desc-cell">@row.Descripcion</div>

                                        @if (!string.IsNullOrWhiteSpace(row.JustificacionNoConformidad))
                                        {
                                            <div class="evidencia-box">
                                                <div class="mini-label">Justificación de la NC</div>
                                                <div>@row.JustificacionNoConformidad</div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(row.Evidencia))
                                        {
                                            <div class="evidencia-box">
                                                <div class="mini-label">Evidencia inicial</div>
                                                <div>@row.Evidencia</div>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="team-stack">
                                            <div>
                                                <span class="team-label">Responsable:</span>
                                                <span class="team-value">@MostrarPersona(row.ResponsableId, row.ResponsableId)</span>
                                            </div>
                                            <div>
                                                <span class="team-label">Cierre:</span>
                                                <span class="team-value">@MostrarPersona(row.ResponsableCierreId, "Sin asignar")</span>
                                            </div>
                                            <div>
                                                <span class="team-label">Creado por:</span>
                                                <span class="team-value">@MostrarPersona(row.CreadoPorId, "No registrado")</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="cell-title">@row.FechaCreacion.ToString("yyyy-MM-dd")</div>
                                        <div class="cell-subtitle">@row.FechaCreacion.ToString("HH:mm")</div>
                                        <div class="cell-subtitle">Compromiso: @row.FechaCompromiso.ToString("yyyy-MM-dd")</div>
                                    </td>

                                    <td>
                                        <div class="review-box">
                                            <label class="form-label small-label">Comentario SGC</label>
                                            <InputTextArea class="form-control review-textarea"
                                                           @bind-Value="row.ComentarioSgc"
                                                           rows="3"
                                                           disabled="@(guardandoHallazgoId == row.HallazgoId)" />

                                            <div class="review-actions">
                                                <button type="button"
                                                        class="table-btn"
                                                        @onclick="() => VerDetalle(row)"
                                                        disabled="@(guardandoHallazgoId == row.HallazgoId)">
                                                    Ver detalle
                                                </button>

                                                <button type="button"
                                                        class="table-btn table-btn-success"
                                                        @onclick="() => ResolverHallazgo(row.HallazgoId, true)"
                                                        disabled="@(guardandoHallazgoId == row.HallazgoId)">
                                                    @(guardandoHallazgoId == row.HallazgoId ? "Guardando..." : "Aprobar")
                                                </button>

                                                <button type="button"
                                                        class="table-btn table-btn-danger"
                                                        @onclick="() => ResolverHallazgo(row.HallazgoId, false)"
                                                        disabled="@(guardandoHallazgoId == row.HallazgoId)">
                                                    @(guardandoHallazgoId == row.HallazgoId ? "Guardando..." : "Rechazar")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Últimos hallazgos revisados</h2>
                    <p class="panel-subtitle">Historial reciente de aprobaciones y rechazos SGC.</p>
                </div>

                <span class="panel-badge">@revisados.Count reciente(s)</span>
            </div>

            @if (revisados.Count == 0)
            {
                <div class="empty-state compact">
                    Aún no hay hallazgos revisados por SGC.
                </div>
            }
            else
            {
                <div class="reviewed-list">
                    @foreach (var row in revisados)
                    {
                        <div class="reviewed-item">
                            <div class="reviewed-head">
                                <div>
                                    <div class="reviewed-title">Hallazgo #@row.HallazgoId · Auditoría #@row.AuditoriaId</div>
                                    <div class="reviewed-subtitle">@row.ProcesoTexto · @row.TipoHallazgoNombre</div>
                                </div>

                                <span class="validacion-pill @GetValidacionClass(row.EstatusValidacionSgc)">
                                    @row.EstatusValidacionSgc
                                </span>
                            </div>

                            <div class="reviewed-body">
                                <div class="reviewed-text">@row.Descripcion</div>

                                @if (!string.IsNullOrWhiteSpace(row.JustificacionNoConformidad))
                                {
                                    <div class="comment-box mt-3">
                                        <div class="mini-label">Justificación de la NC</div>
                                        <div>@row.JustificacionNoConformidad</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(row.Evidencia))
                                {
                                    <div class="comment-box mt-3">
                                        <div class="mini-label">Evidencia inicial</div>
                                        <div>@row.Evidencia</div>
                                    </div>
                                }

                                <div class="reviewed-meta">
                                    <span>Responsable: <strong>@MostrarPersona(row.ResponsableId, row.ResponsableId)</strong></span>
                                    <span>Revisó: <strong>@MostrarPersona(row.RevisadoPorSgcId, "—")</strong></span>
                                    @if (row.FechaRevisionSgc.HasValue)
                                    {
                                        <span>Fecha: <strong>@row.FechaRevisionSgc.Value.ToString("yyyy-MM-dd HH:mm")</strong></span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(row.ComentarioRevisionSgc))
                                {
                                    <div class="comment-box">
                                        <div class="mini-label">Comentario SGC</div>
                                        <div>@row.ComentarioRevisionSgc</div>
                                    </div>
                                }
                            </div>

                            <div class="reviewed-actions">
                                <button type="button" class="table-btn" @onclick="() => VerDetalle(row)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly Dictionary<string, string> personasDisplay = new(StringComparer.OrdinalIgnoreCase);

    private bool cargando = true;
    private string? errorMsg;
    private int? guardandoHallazgoId;

    private string usuarioActualId = "sistema";
    private string usuarioActualNombre = "sistema";
    private bool usuarioEsSgc;

    private int totalAprobados;
    private int totalRechazados;

    private List<HallazgoRowVm> pendientes = new();
    private List<HallazgoRowVm> revisados = new();

    private class HallazgoRowVm
    {
        public int HallazgoId { get; set; }
        public int AuditoriaId { get; set; }
        public string ProcesoTexto { get; set; } = "";
        public string ClausulaTexto { get; set; } = "";
        public string TipoHallazgoNombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string? JustificacionNoConformidad { get; set; }
        public string? Evidencia { get; set; }
        public string ResponsableId { get; set; } = "";
        public string? ResponsableCierreId { get; set; }
        public string? CreadoPorId { get; set; }
        public DateTime FechaCreacion { get; set; }
        public DateTime FechaCompromiso { get; set; }
        public string Estatus { get; set; } = "";
        public string EstatusValidacionSgc { get; set; } = "";
        public string? RevisadoPorSgcId { get; set; }
        public DateTime? FechaRevisionSgc { get; set; }
        public string? ComentarioRevisionSgc { get; set; }
        public string? ComentarioSgc { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            await CargarUsuarioActual();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.ToString();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarUsuarioActual()
    {
        if (AuthenticationStateTask is null)
            return;

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            usuarioActualId =
                user.FindFirst("pc_login_id")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? "sistema";

            usuarioActualNombre =
                user.Identity?.Name
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? usuarioActualId;
        }

        var loginNormalizado = (usuarioActualId ?? "").Trim().ToUpper();

        usuarioEsSgc = await Db.UsuariosPerfil
            .AsNoTracking()
            .AnyAsync(x =>
                x.Activo &&
                x.PcLoginId.ToUpper() == loginNormalizado &&
                (x.Perfil == "SGC" || x.Perfil == "Administrador"));
    }

    private async Task CargarPantalla()
    {
        pendientes.Clear();
        revisados.Clear();
        personasDisplay.Clear();

        if (!usuarioEsSgc)
            return;

        totalAprobados = await Db.Hallazgos.CountAsync(h => h.EstatusValidacionSgc == "Aprobado");
        totalRechazados = await Db.Hallazgos.CountAsync(h => h.EstatusValidacionSgc == "Rechazado");

        var pendientesEntity = await Db.Hallazgos
            .AsNoTracking()
            .Include(h => h.Proceso)
            .Include(h => h.Clausula)
            .Include(h => h.TipoHallazgo)
            .Where(h => h.EstatusValidacionSgc == "Pendiente")
            .OrderBy(h => h.FechaCreacion)
            .ThenBy(h => h.HallazgoId)
            .ToListAsync();

        pendientes = pendientesEntity
            .Select(MapRow)
            .ToList();

        var revisadosEntity = await Db.Hallazgos
            .AsNoTracking()
            .Include(h => h.Proceso)
            .Include(h => h.Clausula)
            .Include(h => h.TipoHallazgo)
            .Where(h => h.EstatusValidacionSgc == "Aprobado" || h.EstatusValidacionSgc == "Rechazado")
            .OrderByDescending(h => h.FechaRevisionSgc ?? h.FechaCreacion)
            .ThenByDescending(h => h.HallazgoId)
            .Take(12)
            .ToListAsync();

        revisados = revisadosEntity
            .Select(MapRow)
            .ToList();

        await CargarPersonasDisplay(
            pendientes.SelectMany(x => new string?[]
            {
                x.ResponsableId,
                x.ResponsableCierreId,
                x.CreadoPorId,
                x.RevisadoPorSgcId
            })
            .Concat(revisados.SelectMany(x => new string?[]
            {
                x.ResponsableId,
                x.ResponsableCierreId,
                x.CreadoPorId,
                x.RevisadoPorSgcId
            })));
    }

    private static HallazgoRowVm MapRow(Hallazgo h) => new()
    {
        HallazgoId = h.HallazgoId,
        AuditoriaId = h.AuditoriaId,
        ProcesoTexto = $"{h.Proceso?.Codigo} - {h.Proceso?.Nombre}",
        ClausulaTexto = h.Clausula is null ? "Sin cláusula" : $"{h.Clausula.Codigo} - {h.Clausula.Descripcion}",
        TipoHallazgoNombre = h.TipoHallazgo?.Nombre ?? "Sin tipo",
        Descripcion = h.Descripcion,
        JustificacionNoConformidad = h.JustificacionNoConformidad,
        Evidencia = h.Evidencia,
        ResponsableId = h.ResponsableId,
        ResponsableCierreId = h.ResponsableCierreId,
        CreadoPorId = h.CreadoPorId,
        FechaCreacion = h.FechaCreacion,
        FechaCompromiso = h.FechaCompromiso,
        Estatus = h.Estatus,
        EstatusValidacionSgc = h.EstatusValidacionSgc,
        RevisadoPorSgcId = h.RevisadoPorSgcId,
        FechaRevisionSgc = h.FechaRevisionSgc,
        ComentarioRevisionSgc = h.ComentarioRevisionSgc
    };

    private async Task ResolverHallazgo(int hallazgoId, bool aprobado)
    {
        if (guardandoHallazgoId.HasValue) return;
        errorMsg = null;

        if (!usuarioEsSgc)
        {
            errorMsg = "No tienes permisos para revisar hallazgos de SGC.";
            return;
        }

        var row = pendientes.FirstOrDefault(x => x.HallazgoId == hallazgoId);
        if (row is null)
        {
            errorMsg = "No se encontró el hallazgo pendiente.";
            return;
        }

        var comentario = row.ComentarioSgc?.Trim();

        if (!aprobado && string.IsNullOrWhiteSpace(comentario))
        {
            errorMsg = "Debes capturar un comentario cuando rechazas un hallazgo.";
            return;
        }

        guardandoHallazgoId = hallazgoId;

        try
        {
            var entity = await Db.Hallazgos
                .FirstOrDefaultAsync(h => h.HallazgoId == hallazgoId);

            if (entity is null)
            {
                errorMsg = "No se encontró el hallazgo a revisar.";
                return;
            }

            if (!string.Equals(entity.EstatusValidacionSgc, "Pendiente", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Este hallazgo ya no está pendiente de validación.";
                return;
            }

            entity.EstatusValidacionSgc = aprobado ? "Aprobado" : "Rechazado";
            entity.RevisadoPorSgcId = usuarioActualId;
            entity.FechaRevisionSgc = DateTime.Now;
            entity.ComentarioRevisionSgc = string.IsNullOrWhiteSpace(comentario) ? null : comentario;

            if (aprobado)
            {
                entity.Estatus = "Abierto";
            }
            else
            {
                entity.Estatus = "Pendiente SGC";
            }

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = entity.HallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = aprobado
                    ? $"SGC aprobó el hallazgo.{(string.IsNullOrWhiteSpace(comentario) ? "" : $" Comentario: {comentario}")}"
                    : $"SGC rechazó el hallazgo. Motivo: {comentario}",
                EstatusNuevo = entity.Estatus
            });

            await Db.SaveChangesAsync();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardandoHallazgoId = null;
        }
    }

    private async Task CargarPersonasDisplay(IEnumerable<string?> valores)
    {
        var ids = valores
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (ids.Count == 0)
            return;

        var auditores = await Db.Auditores
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.PcLoginId) && ids.Contains(x.PcLoginId)) ||
                ids.Contains(x.Nombre))
            .ToListAsync();

        foreach (var a in auditores)
        {
            var display = !string.IsNullOrWhiteSpace(a.PcLoginId) &&
                          !string.Equals(a.Nombre.Trim(), a.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{a.Nombre} ({a.PcLoginId})"
                : a.Nombre;

            if (!string.IsNullOrWhiteSpace(a.PcLoginId))
                personasDisplay[a.PcLoginId.Trim()] = display;

            personasDisplay[a.Nombre.Trim()] = display;
        }

        var faltantes = ids
            .Where(x => !personasDisplay.ContainsKey(x))
            .ToList();

        if (faltantes.Count == 0)
            return;

        var usuarios = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.pc_login_id) && faltantes.Contains(x.pc_login_id)) ||
                (!string.IsNullOrWhiteSpace(x.username) && faltantes.Contains(x.username)))
            .ToListAsync();

        foreach (var u in usuarios)
        {
            var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username!;
            var display = !string.IsNullOrWhiteSpace(u.pc_login_id) &&
                          !string.Equals(nombre.Trim(), u.pc_login_id.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{nombre} ({u.pc_login_id})"
                : nombre;

            if (!string.IsNullOrWhiteSpace(u.pc_login_id))
                personasDisplay[u.pc_login_id.Trim()] = display;

            if (!string.IsNullOrWhiteSpace(u.username))
                personasDisplay[u.username.Trim()] = display;
        }

        foreach (var id in ids)
        {
            if (!personasDisplay.ContainsKey(id))
                personasDisplay[id] = id;
        }
    }

    private string MostrarPersona(string? valor, string fallback = "Sin asignar")
    {
        if (string.IsNullOrWhiteSpace(valor))
            return fallback;

        var clave = valor.Trim();
        return personasDisplay.TryGetValue(clave, out var nombre) ? nombre : clave;
    }

    private static string GetTipoClass(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor.Contains("mayor"))
            return "major";

        if (valor.Contains("menor"))
            return "minor";

        return "neutral";
    }

    private static string GetValidacionClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "aprobado")
            return "approved";

        if (valor == "rechazado")
            return "rejected";

        return "pending";
    }

    private void VerDetalle(HallazgoRowVm row) =>
        Nav.NavigateTo($"auditorias/{row.AuditoriaId}/hallazgos/{row.HallazgoId}");

    private void IrInicio() => Nav.NavigateTo("");
}