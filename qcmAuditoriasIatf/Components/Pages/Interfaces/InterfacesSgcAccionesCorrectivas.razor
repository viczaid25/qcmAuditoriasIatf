@page "/interfaces/sgc/acciones-correctivas"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Evidencias
@using qcmAuditoriasIatf.Models.Hallazgos
@using qcmAuditoriasIatf.Services
@using System.Security.Claims
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav
@inject EmailService EmailSvc

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="interfaces-loading">
        <div class="interfaces-skeleton interfaces-skeleton-hero"></div>
        <div class="interfaces-metrics">
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
            <div class="interfaces-skeleton interfaces-skeleton-card"></div>
        </div>
        <div class="interfaces-skeleton interfaces-skeleton-table"></div>
    </div>
}
else if (!usuarioEsSgc)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">Acceso restringido</div>
            <div class="empty-text">
                Esta bandeja es exclusiva para usuarios del equipo SGC.
            </div>

            <button type="button" class="hero-btn primary mt-3" @onclick="IrInicio">
                Volver al inicio
            </button>
        </div>
    </section>
}
else
{
    <div class="interfaces-page">
        <section class="interfaces-hero">
            <div>
                <span class="interfaces-kicker">Interfaces · Validación SGC</span>
                <h1>Validación SGC de acciones correctivas</h1>

                <div class="interfaces-meta">
                    <span class="meta-chip">
                        Usuario:
                        <strong>@usuarioActualId</strong>
                    </span>

                    <span class="meta-chip">
                        Pendientes:
                        <strong>@pendientes.Count</strong>
                    </span>
                </div>

                <p class="hero-text">
                    Revisa y aprueba o rechaza el archivo de acción correctiva de los hallazgos NC Mayor.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn" @onclick="IrInicio">
                    Volver
                </button>
            </div>
        </section>

        <section class="interfaces-metrics">
            <div class="metric-card">
                <div class="metric-label">Pendientes</div>
                <div class="metric-value">@pendientes.Count</div>
                <div class="metric-note">Acciones correctivas esperando aprobación SGC</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Aprobadas</div>
                <div class="metric-value">@totalAprobados</div>
                <div class="metric-note">Liberadas para subir evidencia</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Rechazadas</div>
                <div class="metric-value">@totalRechazados</div>
                <div class="metric-note">Con observaciones de SGC</div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Acciones correctivas pendientes de aprobación</h2>
                    <p class="panel-subtitle">Archivo de acción correctiva de hallazgos NC Mayor, a la espera de decisión SGC.</p>
                </div>

                <span class="panel-badge">@pendientes.Count pendiente(s)</span>
            </div>

            @if (pendientes.Count == 0)
            {
                <div class="empty-state compact">
                    No hay acciones correctivas pendientes de revisión SGC.
                </div>
            }
            else
            {
                <div class="reviewed-list">
                    @foreach (var row in pendientes)
                    {
                        <div class="reviewed-item" @key="row.AccionCorrectivaId">
                            <div class="reviewed-head">
                                <div>
                                    <div class="reviewed-title">Hallazgo #@row.HallazgoId · Auditoría #@row.AuditoriaId</div>
                                    <div class="reviewed-subtitle">@row.ProcesoTexto · @row.TipoHallazgoNombre</div>
                                </div>

                                <span class="validacion-pill pending">Pendiente</span>
                            </div>

                            <div class="reviewed-body">
                                <div class="reviewed-meta">
                                    <span>Subió: <strong>@MostrarPersona(row.ResponsableId, row.ResponsableId)</strong></span>
                                    <span>Fecha: <strong>@row.FechaImplementacion.ToString("yyyy-MM-dd")</strong></span>
                                </div>

                                <div class="mini-label mt-2">Archivo(s) de acción correctiva</div>

                                @if (row.Archivos.Count == 0)
                                {
                                    <div class="empty-state compact">
                                        No hay archivos adjuntos.
                                    </div>
                                }
                                else
                                {
                                    <div class="evidencia-list">
                                        @foreach (var ev in row.Archivos)
                                        {
                                            <div class="evidencia-item" @key="ev.EvidenciaId">
                                                <a href="@($"evidencias/{ev.EvidenciaId}")" target="_blank" class="evidencia-link">
                                                    @ev.NombreOriginal
                                                </a>
                                                <span class="evidencia-meta">
                                                    @ev.FechaCarga.ToString("yyyy-MM-dd HH:mm")
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="comment-box mt-3">
                                    <div class="mini-label">Comentario SGC</div>
                                    <InputTextArea class="mo-form-control review-textarea"
                                                   @bind-Value="row.ComentarioSgc"
                                                   rows="3"
                                                   disabled="@(guardandoAccionId == row.AccionCorrectivaId)" />
                                </div>
                            </div>

                            <div class="reviewed-actions">
                                <button type="button" class="table-btn" @onclick="() => VerDetalleHallazgo(row.AuditoriaId, row.HallazgoId)">
                                    Ver detalle
                                </button>

                                <button type="button"
                                        class="table-btn table-btn-success"
                                        @onclick="() => ResolverAccion(row.AccionCorrectivaId, true)"
                                        disabled="@(guardandoAccionId == row.AccionCorrectivaId)">
                                    @(guardandoAccionId == row.AccionCorrectivaId ? "Guardando..." : "Aprobar")
                                </button>

                                <button type="button"
                                        class="table-btn table-btn-danger"
                                        @onclick="() => ResolverAccion(row.AccionCorrectivaId, false)"
                                        disabled="@(guardandoAccionId == row.AccionCorrectivaId)">
                                    @(guardandoAccionId == row.AccionCorrectivaId ? "Guardando..." : "Rechazar")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Últimas revisadas</h2>
                    <p class="panel-subtitle">Historial reciente de aprobaciones y rechazos SGC de acciones correctivas.</p>
                </div>

                <span class="panel-badge">@revisadas.Count reciente(s)</span>
            </div>

            @if (revisadas.Count == 0)
            {
                <div class="empty-state compact">
                    Aún no hay acciones correctivas revisadas por SGC.
                </div>
            }
            else
            {
                <div class="reviewed-list">
                    @foreach (var row in revisadas)
                    {
                        <div class="reviewed-item" @key="row.AccionCorrectivaId">
                            <div class="reviewed-head">
                                <div>
                                    <div class="reviewed-title">Hallazgo #@row.HallazgoId</div>
                                    <div class="reviewed-subtitle">@row.ProcesoTexto · @row.TipoHallazgoNombre</div>
                                </div>

                                <span class="validacion-pill @GetValidacionClass(row.EstatusValidacion)">
                                    @row.EstatusValidacion
                                </span>
                            </div>

                            <div class="reviewed-body">
                                <div class="reviewed-meta">
                                    <span>Subió: <strong>@MostrarPersona(row.ResponsableId, row.ResponsableId)</strong></span>
                                    <span>Revisó: <strong>@MostrarPersona(row.RevisadoPorSgcId, "—")</strong></span>
                                    @if (row.FechaRevisionSgc.HasValue)
                                    {
                                        <span>Fecha: <strong>@row.FechaRevisionSgc.Value.ToString("yyyy-MM-dd HH:mm")</strong></span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(row.ComentarioSgc))
                                {
                                    <div class="comment-box">
                                        <div class="mini-label">Comentario SGC</div>
                                        <div>@row.ComentarioSgc</div>
                                    </div>
                                }
                            </div>

                            <div class="reviewed-actions">
                                <button type="button" class="table-btn" @onclick="() => VerDetalleHallazgo(row.AuditoriaId, row.HallazgoId)">
                                    Ver detalle
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly Dictionary<string, string> personasDisplay = new(StringComparer.OrdinalIgnoreCase);

    private bool cargando = true;
    private string? errorMsg;
    private int? guardandoAccionId;

    private string usuarioActualId = "sistema";
    private bool usuarioEsSgc;

    private int totalAprobados;
    private int totalRechazados;

    private List<AccionRowVm> pendientes = new();
    private List<AccionRowVm> revisadas = new();

    private class AccionRowVm
    {
        public int AccionCorrectivaId { get; set; }
        public int HallazgoId { get; set; }
        public int AuditoriaId { get; set; }
        public string ProcesoTexto { get; set; } = "";
        public string TipoHallazgoNombre { get; set; } = "";
        public string ResponsableId { get; set; } = "";
        public DateTime FechaImplementacion { get; set; }
        public string EstatusValidacion { get; set; } = "";
        public string? RevisadoPorSgcId { get; set; }
        public DateTime? FechaRevisionSgc { get; set; }
        public string? ComentarioSgc { get; set; }
        public List<Evidencia> Archivos { get; set; } = new();
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            await CargarUsuarioActual();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.ToString();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarUsuarioActual()
    {
        if (AuthenticationStateTask is null)
            return;

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            usuarioActualId =
                user.FindFirst("pc_login_id")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                ?? "sistema";
        }

        var loginNormalizado = (usuarioActualId ?? "").Trim().ToUpper();

        usuarioEsSgc = await Db.UsuariosPerfil
            .AsNoTracking()
            .AnyAsync(x =>
                x.Activo &&
                x.PcLoginId.ToUpper() == loginNormalizado &&
                (x.Perfil == "SGC" || x.Perfil == "Administrador"));
    }

    private async Task CargarPantalla()
    {
        // El DbContext de Blazor Server vive por sesión: limpiamos el tracker para no
        // arrastrar entidades desactualizadas de otra pantalla u otra acción.
        Db.ChangeTracker.Clear();

        pendientes.Clear();
        revisadas.Clear();
        personasDisplay.Clear();

        if (!usuarioEsSgc)
            return;

        totalAprobados = await Db.AccionesCorrectivas.CountAsync(x => x.EstatusValidacion == "Aprobado");
        totalRechazados = await Db.AccionesCorrectivas.CountAsync(x => x.EstatusValidacion == "Rechazado");

        var pendientesEntity = await Db.AccionesCorrectivas
            .AsNoTracking()
            .Include(x => x.Hallazgo!).ThenInclude(h => h.Proceso)
            .Include(x => x.Hallazgo!).ThenInclude(h => h.TipoHallazgo)
            .Where(x => x.EstatusValidacion == "Pendiente")
            .OrderBy(x => x.FechaImplementacion)
            .ToListAsync();

        pendientes = pendientesEntity
            .Where(x => x.Hallazgo is not null)
            .Select(MapRow)
            .ToList();

        var revisadasEntity = await Db.AccionesCorrectivas
            .AsNoTracking()
            .Include(x => x.Hallazgo!).ThenInclude(h => h.Proceso)
            .Include(x => x.Hallazgo!).ThenInclude(h => h.TipoHallazgo)
            .Where(x => x.EstatusValidacion == "Aprobado" || x.EstatusValidacion == "Rechazado")
            .OrderByDescending(x => x.FechaRevisionSgc ?? x.FechaImplementacion)
            .ThenByDescending(x => x.AccionCorrectivaId)
            .Take(12)
            .ToListAsync();

        revisadas = revisadasEntity
            .Where(x => x.Hallazgo is not null)
            .Select(MapRow)
            .ToList();

        var idsHallazgos = pendientes.Select(x => x.HallazgoId)
            .Concat(revisadas.Select(x => x.HallazgoId))
            .ToList();

        var archivos = await Db.Evidencias
            .AsNoTracking()
            .Where(e => e.ReferenciaTipo == "ValidacionAccion" && idsHallazgos.Contains(e.ReferenciaId))
            .OrderByDescending(e => e.FechaCarga)
            .ToListAsync();

        foreach (var row in pendientes)
            row.Archivos = archivos.Where(e => e.ReferenciaId == row.HallazgoId).ToList();

        await CargarPersonasDisplay(
            pendientes.Select(x => (string?)x.ResponsableId)
                .Concat(revisadas.SelectMany(x => new string?[] { x.ResponsableId, x.RevisadoPorSgcId })));
    }

    private static AccionRowVm MapRow(AccionCorrectiva x) => new()
    {
        AccionCorrectivaId = x.AccionCorrectivaId,
        HallazgoId = x.HallazgoId,
        AuditoriaId = x.Hallazgo!.AuditoriaId,
        ProcesoTexto = $"{x.Hallazgo.Proceso?.Codigo} - {x.Hallazgo.Proceso?.Nombre}",
        TipoHallazgoNombre = x.Hallazgo.TipoHallazgo?.Nombre ?? "Sin tipo",
        ResponsableId = x.ResponsableId,
        FechaImplementacion = x.FechaImplementacion,
        EstatusValidacion = x.EstatusValidacion,
        RevisadoPorSgcId = x.RevisadoPorSgcId,
        FechaRevisionSgc = x.FechaRevisionSgc,
        ComentarioSgc = x.ComentarioSgc
    };

    private async Task ResolverAccion(int accionCorrectivaId, bool aprobado)
    {
        if (guardandoAccionId.HasValue) return;
        errorMsg = null;

        if (!usuarioEsSgc)
        {
            errorMsg = "No tienes permisos para revisar acciones correctivas.";
            return;
        }

        var row = pendientes.FirstOrDefault(x => x.AccionCorrectivaId == accionCorrectivaId);
        if (row is null)
        {
            errorMsg = "No se encontró la acción correctiva pendiente.";
            return;
        }

        var comentario = row.ComentarioSgc?.Trim();

        if (!aprobado && string.IsNullOrWhiteSpace(comentario))
        {
            errorMsg = "Debes capturar un comentario cuando rechazas la acción correctiva.";
            return;
        }

        guardandoAccionId = accionCorrectivaId;

        try
        {
            var entity = await Db.AccionesCorrectivas
                .Include(x => x.Hallazgo!).ThenInclude(h => h.AuditoriaProceso)
                .FirstOrDefaultAsync(x => x.AccionCorrectivaId == accionCorrectivaId);

            if (entity is null)
            {
                errorMsg = "No se encontró la acción correctiva.";
                return;
            }

            if (!string.Equals(entity.EstatusValidacion, "Pendiente", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Esta acción correctiva ya no está pendiente de revisión.";
                return;
            }

            entity.EstatusValidacion = aprobado ? "Aprobado" : "Rechazado";
            entity.RevisadoPorSgcId = usuarioActualId;
            entity.FechaRevisionSgc = DateTime.Now;
            entity.ComentarioSgc = string.IsNullOrWhiteSpace(comentario) ? null : comentario;

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = entity.HallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = aprobado
                    ? $"SGC aprobó la acción correctiva.{(string.IsNullOrWhiteSpace(comentario) ? "" : $" Comentario: {comentario}")}"
                    : $"SGC rechazó la acción correctiva. Motivo: {comentario}"
            });

            await Db.SaveChangesAsync();
            await NotificarResolucionAsync(entity);
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardandoAccionId = null;
        }
    }

    private async Task NotificarResolucionAsync(AccionCorrectiva entity)
    {
        try
        {
            if (entity.Hallazgo is null)
                return;

            var responsableCierre = await EmailSvc.ResolverEmailAsync(entity.Hallazgo.ResponsableCierreId);
            if (responsableCierre is null)
                return;

            var auditores = await EmailSvc.ResolverAuditoresAsync(entity.Hallazgo.AuditoriaProceso);

            await EmailSvc.NotificarAsync(new[] { responsableCierre }, auditores);
        }
        catch
        {
            // El envío de correo no debe bloquear la resolución de la acción correctiva.
        }
    }

    private async Task CargarPersonasDisplay(IEnumerable<string?> valores)
    {
        var ids = valores
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (ids.Count == 0)
            return;

        var auditores = await Db.Auditores
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.PcLoginId) && ids.Contains(x.PcLoginId)) ||
                ids.Contains(x.Nombre))
            .ToListAsync();

        foreach (var a in auditores)
        {
            var display = !string.IsNullOrWhiteSpace(a.PcLoginId) &&
                          !string.Equals(a.Nombre.Trim(), a.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{a.Nombre} ({a.PcLoginId})"
                : a.Nombre;

            if (!string.IsNullOrWhiteSpace(a.PcLoginId))
                personasDisplay[a.PcLoginId.Trim()] = display;

            personasDisplay[a.Nombre.Trim()] = display;
        }

        var faltantes = ids
            .Where(x => !personasDisplay.ContainsKey(x))
            .ToList();

        if (faltantes.Count == 0)
            return;

        var usuarios = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.pc_login_id) && faltantes.Contains(x.pc_login_id)) ||
                (!string.IsNullOrWhiteSpace(x.username) && faltantes.Contains(x.username)))
            .ToListAsync();

        foreach (var u in usuarios)
        {
            var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username!;
            var display = !string.IsNullOrWhiteSpace(u.pc_login_id) &&
                          !string.Equals(nombre.Trim(), u.pc_login_id.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{nombre} ({u.pc_login_id})"
                : nombre;

            if (!string.IsNullOrWhiteSpace(u.pc_login_id))
                personasDisplay[u.pc_login_id.Trim()] = display;

            if (!string.IsNullOrWhiteSpace(u.username))
                personasDisplay[u.username.Trim()] = display;
        }

        foreach (var id in ids)
        {
            if (!personasDisplay.ContainsKey(id))
                personasDisplay[id] = id;
        }
    }

    private string MostrarPersona(string? valor, string fallback = "Sin asignar")
    {
        if (string.IsNullOrWhiteSpace(valor))
            return fallback;

        var clave = valor.Trim();
        return personasDisplay.TryGetValue(clave, out var nombre) ? nombre : clave;
    }

    private static string GetValidacionClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "aprobado")
            return "approved";

        if (valor == "rechazado")
            return "rejected";

        return "pending";
    }

    private void VerDetalleHallazgo(int auditoriaId, int hallazgoId) =>
        Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{hallazgoId}");

    private void IrInicio() => Nav.NavigateTo("");
}
