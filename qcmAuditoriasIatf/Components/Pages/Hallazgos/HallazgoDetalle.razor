    private async Task CargarPantalla()
    {
        hallazgo = await Db.Hallazgos
            .Include(h => h.TipoHallazgo)
            .Include(h => h.AuditoriaProceso)
            .FirstOrDefaultAsync(h => h.HallazgoId == hallazgoId && h.AuditoriaId == auditoriaId);

        cincoPorQue = await Db.HallazgosCincoPorQue
            .FirstOrDefaultAsync(x => x.HallazgoId == hallazgoId);

        accionCorrectiva = await Db.AccionesCorrectivas
            .Where(a => a.HallazgoId == hallazgoId)
            .OrderByDescending(a => a.AccionCorrectivaId)
            .FirstOrDefaultAsync();

        await CargarEvidencias();

        if (cincoPorQue is not null)
        {
            vm5 = new CincoPorQueVm
            {
                PorQue1 = cincoPorQue.PorQue1,
                PorQue2 = cincoPorQue.PorQue2,
                PorQue3 = cincoPorQue.PorQue3,
                PorQue4 = cincoPorQue.PorQue4,
                PorQue5 = cincoPorQue.PorQue5,
                Acciones = DeserializarAcciones(cincoPorQue.Acciones)
            };
        }
        else
        {
            vm5 = new CincoPorQueVm();
        }

        usuariosDisponibles = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x => !string.IsNullOrWhiteSpace(x.pc_login_id))
            .OrderBy(x => x.username ?? x.pc_login_id)
            .ToListAsync();

        await CargarPersonasDisplay(
            vm5.Acciones.Select(x => x.Responsable)
                .Concat(new string?[]
                {
                    hallazgo?.ResponsableId,
                    hallazgo?.ResponsableCierreId,
                    hallazgo?.CreadoPorId,
                    hallazgo?.RevisadoPorSgcId,
                    AuditorPrincipalId,
                    SegundoAuditorId
                }));
    }

    private string ConstruirAnalisisCausa(HallazgoCincoPorQue entity)
    {
        var partes = new List<string>
        {
            $"1. {entity.PorQue1}",
            $"2. {entity.PorQue2}",
            $"3. {entity.PorQue3}"
        };

        if (!string.IsNullOrWhiteSpace(entity.PorQue4))
            partes.Add($"4. {entity.PorQue4}");

        if (!string.IsNullOrWhiteSpace(entity.PorQue5))
            partes.Add($"5. {entity.PorQue5}");

        return string.Join("\n", partes);
    }

    private async Task GuardarCincoPorQue()
    {
        msg5 = null;
        errorMsg = null;

        if (guardando)
            return;

        guardando = true;

        try
        {
            if (hallazgo is null || !EsNcMenor)
            {
                msg5 = "El hallazgo no es NC Menor o no está cargado.";
                return;
            }

            if (!HallazgoLiberadoPorSgc)
            {
                msg5 = "El hallazgo debe ser aprobado por SGC antes de capturar los 5 porqués.";
                return;
            }

            if (CincoPorQueAprobado)
            {
                msg5 = "Los 5 porqués ya fueron aprobados y ya no se pueden editar.";
                return;
            }

            if (string.IsNullOrWhiteSpace(hallazgo.ResponsableCierreId))
            {
                msg5 = "El hallazgo no tiene responsable de cierre asignado.";
                return;
            }

            if (!UsuarioActualEsResponsableCierre)
            {
                msg5 = "Solo el responsable de cierre puede capturar los 5 porqués.";
                return;
            }

            if (string.IsNullOrWhiteSpace(vm5.PorQue1) ||
                string.IsNullOrWhiteSpace(vm5.PorQue2) ||
                string.IsNullOrWhiteSpace(vm5.PorQue3))
            {
                msg5 = "Debes capturar al menos los primeros 3 porqués.";
                return;
            }

            var accionesLimpias = vm5.Acciones
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.Accion) ||
                    !string.IsNullOrWhiteSpace(x.Responsable) ||
                    x.Fecha.HasValue)
                .Select(x => new AccionCincoPorQueVm
                {
                    Accion = string.IsNullOrWhiteSpace(x.Accion) ? null : x.Accion.Trim(),
                    Responsable = string.IsNullOrWhiteSpace(x.Responsable) ? null : x.Responsable.Trim(),
                    Fecha = x.Fecha
                })
                .ToList();

            var esNuevo = cincoPorQue is null;

            if (cincoPorQue is null)
            {
                cincoPorQue = new HallazgoCincoPorQue
                {
                    HallazgoId = hallazgoId
                };

                Db.HallazgosCincoPorQue.Add(cincoPorQue);
            }

            cincoPorQue.UsuarioRegistroId = usuarioActualId;
            cincoPorQue.FechaRegistro = DateTime.Now;
            cincoPorQue.PorQue1 = vm5.PorQue1!.Trim();
            cincoPorQue.PorQue2 = vm5.PorQue2!.Trim();
            cincoPorQue.PorQue3 = vm5.PorQue3!.Trim();
            cincoPorQue.PorQue4 = string.IsNullOrWhiteSpace(vm5.PorQue4) ? "" : vm5.PorQue4.Trim();
            cincoPorQue.PorQue5 = string.IsNullOrWhiteSpace(vm5.PorQue5) ? "" : vm5.PorQue5.Trim();
            cincoPorQue.Acciones = accionesLimpias.Count == 0
                ? null
                : JsonSerializer.Serialize(accionesLimpias, JsonOptions);

            cincoPorQue.Estatus = "Pendiente";
            cincoPorQue.RevisadoPorSgcId = null;
            cincoPorQue.FechaRevisionSgc = null;
            cincoPorQue.ComentarioSgc = null;

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = hallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = esNuevo
                    ? "Capturó los 5 porqués."
                    : "Actualizó los 5 porqués."
            });

            await Db.SaveChangesAsync();
            await CargarPantalla();

            msg5 = "Los 5 porqués se guardaron correctamente.";
        }
        catch (Exception ex)
        {
            msg5 = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CargarEvidencias()
    {
        evidenciasHallazgo = await Db.Evidencias
            .AsNoTracking()
            .Where(e => e.ReferenciaTipo == "Hallazgo" && e.ReferenciaId == hallazgoId)
            .OrderByDescending(e => e.FechaCarga)
            .ToListAsync();
    }

    private async Task SubirEvidencias(InputFileChangeEventArgs e)
    {
        if (subiendoEvidencia || hallazgo is null || !UsuarioActualEsResponsableCierre)
            return;

        const long maxBytes = 20 * 1024 * 1024;

        subiendoEvidencia = true;
        evidenciaErrorMsg = null;

        try
        {
            var carpeta = Path.Combine(Env.ContentRootPath, "App_Data", "evidencias", "hallazgos", hallazgoId.ToString());
            Directory.CreateDirectory(carpeta);

            var archivosSubidos = 0;

            foreach (var file in e.GetMultipleFiles(10))
            {
                if (file.Size > maxBytes)
                {
                    evidenciaErrorMsg = $"El archivo \"{file.Name}\" excede el límite de 20 MB y no se subió.";
                    continue;
                }

                var nombreArchivo = $"{Guid.NewGuid():N}{Path.GetExtension(file.Name)}";
                var rutaCompleta = Path.Combine(carpeta, nombreArchivo);

                await using (var origen = file.OpenReadStream(maxAllowedSize: maxBytes))
                await using (var destino = File.Create(rutaCompleta))
                {
                    await origen.CopyToAsync(destino);
                }

                Db.Evidencias.Add(new Evidencia
                {
                    ReferenciaTipo = "Hallazgo",
                    ReferenciaId = hallazgoId,
                    RutaArchivo = Path.Combine("hallazgos", hallazgoId.ToString(), nombreArchivo),
                    NombreOriginal = file.Name,
                    TipoArchivo = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    FechaCarga = DateTime.Now,
                    UsuarioId = usuarioActualId
                });

                archivosSubidos++;
            }

            if (archivosSubidos == 0)
                return;

            if (accionCorrectiva is null)
            {
                accionCorrectiva = new AccionCorrectiva
                {
                    HallazgoId = hallazgoId,
                    AnalisisCausa = cincoPorQue is not null ? ConstruirAnalisisCausa(cincoPorQue) : null,
                    ResponsableId = usuarioActualId,
                    FechaImplementacion = DateTime.Today,
                    Estatus = "En Verificación"
                };

                Db.AccionesCorrectivas.Add(accionCorrectiva);
            }

            if (string.Equals(hallazgo.Estatus, "Abierto", StringComparison.OrdinalIgnoreCase))
                hallazgo.Estatus = "En Proceso";

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = hallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = $"Adjuntó {archivosSubidos} archivo(s) de evidencia de la solución.",
                EstatusNuevo = hallazgo.Estatus
            });

            await Db.SaveChangesAsync();
            await CargarEvidencias();
        }
        catch (Exception ex)
        {
            evidenciaErrorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            subiendoEvidencia = false;
        }
    }

    private async Task EliminarEvidencia(int evidenciaId)
    {
        if (subiendoEvidencia || !UsuarioActualEsResponsableCierre || HallazgoCerrado)
            return;

        evidenciaErrorMsg = null;

        try
        {
            var entity = await Db.Evidencias.FirstOrDefaultAsync(x => x.EvidenciaId == evidenciaId);
            if (entity is null)
                return;

            var rutaCompleta = Path.Combine(Env.ContentRootPath, "App_Data", "evidencias", entity.RutaArchivo);

            Db.Evidencias.Remove(entity);
            await Db.SaveChangesAsync();

            if (File.Exists(rutaCompleta))
                File.Delete(rutaCompleta);

            await CargarEvidencias();
        }
        catch (Exception ex)
        {
            evidenciaErrorMsg = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task CerrarHallazgo()
    {
        if (guardando) return;
        guardando = true;
        errorMsg = null;

        try
        {
            if (hallazgo is null) return;

            if (!UsuarioActualEsResponsableCierre)
            {
                errorMsg = "Solo el responsable de cierre puede cerrar el hallazgo.";
                return;
            }

            if (EsNcMenor && !CincoPorQueAprobado)
            {
                errorMsg = "No puedes cerrar una NC Menor hasta que los 5 porqués estén aprobados por SGC.";
                return;
            }

            hallazgo.Estatus = "Cerrado";

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = hallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = "Cerró el hallazgo.",
                EstatusNuevo = "Cerrado"
            });

            await Db.SaveChangesAsync();
            await CargarPantalla();
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private string GetStatusClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor is "cerrado" or "cerrada" or "finalizado" or "finalizada")
            return "closed";

        if (valor is "en proceso" or "en revisión" or "en revision")
            return "progress";

        return "open";
    }

    private string GetTipoClass(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor.Contains("mayor"))
            return "major";

        if (valor.Contains("menor"))
            return "minor";

        return "neutral";
    }

    private string GetFlowClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "aprobado")
            return "approved";

        if (valor == "rechazado")
            return "rejected";

        if (valor == "bloqueada")
            return "blocked";

        return "pending";
    }

