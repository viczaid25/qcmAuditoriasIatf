    private async Task CargarUsuarioActual()
    {
        usuarioActualId = "sistema";
        usuarioActualNombre = "sistema";

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var login =
                    user.FindFirst("pc_login_id")?.Value
                    ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                    ?? user.Identity?.Name
                    ?? "sistema";

                usuarioActualId = NormalizarLogin(login);

                usuarioActualNombre =
                    user.FindFirst(ClaimTypes.Name)?.Value
                    ?? user.Identity?.Name
                    ?? usuarioActualId;
            }
        }
        catch
        {
            usuarioActualId = "sistema";
            usuarioActualNombre = "sistema";
        }
    }

    private static string NormalizarLogin(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return string.Empty;

        var v = valor.Trim();

        if (v.Contains("\\"))
            v = v[(v.LastIndexOf('\\') + 1)..];

        if (v.Contains("@"))
            v = v[..v.IndexOf('@')];

        return v.Trim().ToUpperInvariant();
    }

    private List<AccionCincoPorQueVm> DeserializarAcciones(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return new List<AccionCincoPorQueVm> { new() };

        try
        {
            var lista = JsonSerializer.Deserialize<List<AccionCincoPorQueVm>>(valor, JsonOptions);
            if (lista is not null && lista.Count > 0)
                return lista;
        }
        catch
        {
        }

        return new List<AccionCincoPorQueVm>
        {
            new() { Accion = valor }
        };
    }

    private List<AccionCincoPorQueVm> ObtenerAccionesGuardadas(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return new();

        try
        {
            var lista = JsonSerializer.Deserialize<List<AccionCincoPorQueVm>>(valor, JsonOptions);
            if (lista is not null)
            {
                return lista
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.Accion) ||
                        !string.IsNullOrWhiteSpace(x.Responsable) ||
                        x.Fecha.HasValue)
                    .ToList();
            }
        }
        catch
        {
        }

        return new List<AccionCincoPorQueVm>
        {
            new() { Accion = valor }
        };
    }

