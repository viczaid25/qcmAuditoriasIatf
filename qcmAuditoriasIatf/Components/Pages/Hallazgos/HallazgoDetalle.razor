@page "/auditorias/{auditoriaId:int}/hallazgos/{hallazgoId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Evidencias
@using qcmAuditoriasIatf.Models.Hallazgos
@using qcmAuditoriasIatf.Models.External
@using System.Security.Claims
@using System.Text.Json
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Env

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (cargando)
{
    <div class="hallazgo-loading">
        <div class="hallazgo-skeleton hallazgo-skeleton-hero"></div>
        <div class="hallazgo-grid hallazgo-grid-top">
            <div class="hallazgo-skeleton hallazgo-skeleton-card"></div>
            <div class="hallazgo-skeleton hallazgo-skeleton-card"></div>
        </div>
        <div class="hallazgo-skeleton hallazgo-skeleton-table"></div>
    </div>
}
else if (hallazgo is null)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">No se encontró el hallazgo</div>
            <div class="empty-text">Verifica el identificador o vuelve a la bandeja de hallazgos.</div>

            <button type="button" class="hero-btn primary mt-3" @onclick="VolverAuditoria">
                Volver a hallazgos
            </button>
        </div>
    </section>
}
else
{
    <div class="hallazgo-page">
        <section class="hallazgo-hero">
            <div>
                <span class="hallazgo-kicker">Gestión de hallazgo</span>
                <h1>Hallazgo #@hallazgoId</h1>

                <div class="hallazgo-meta">
                    <span class="status-pill @GetStatusClass(hallazgo.Estatus)">@hallazgo.Estatus</span>
                    <span class="tipo-pill @GetTipoClass(hallazgo.TipoHallazgo?.Nombre)">
                        @(hallazgo.TipoHallazgo?.Nombre ?? "Sin tipo")
                    </span>
                    <span class="meta-chip">
                        Validación SGC:
                        <strong>@TextoValidacionSgc</strong>
                    </span>
                    <span class="meta-chip">
                        Compromiso: <strong>@hallazgo.FechaCompromiso.ToString("yyyy-MM-dd")</strong>
                    </span>
                    @if (EsNcMenor)
                    {
                        <span class="meta-chip">Flujo 5 porqués activo</span>
                    }
                </div>

                <p class="hero-text">
                    Consulta el detalle del hallazgo, registra seguimiento y controla el flujo de análisis, aprobación y cierre.
                </p>
            </div>

            <div class="hallazgo-hero-actions">
                <div class="user-card">
                    <div class="user-card-label">Usuario actual</div>
                    <div class="user-card-value">@usuarioActualId</div>
                    @if (!string.IsNullOrWhiteSpace(usuarioActualNombre) && usuarioActualNombre != usuarioActualId)
                    {
                        <div class="user-card-name">@usuarioActualNombre</div>
                    }
                </div>

                <button type="button" class="hero-btn primary" @onclick="VolverAuditoria">
                    Volver a hallazgos
                </button>
            </div>
        </section>

        @if (!HallazgoLiberadoPorSgc)
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Validación SGC pendiente</h2>
                        <p class="panel-subtitle">El flujo operativo del hallazgo está bloqueado hasta la liberación por SGC.</p>
                    </div>

                    <span class="flow-pill @GetFlowClass(hallazgo.EstatusValidacionSgc)">
                        @TextoValidacionSgc
                    </span>
                </div>

                @if (HallazgoPendienteSgc)
                {
                    <div class="alert alert-warning mb-0">
                        Este hallazgo todavía no ha sido aprobado por el equipo SGC. Mientras tanto, no se pueden capturar 5 porqués, solución ni seguimiento operativo.
                    </div>
                }
                else if (HallazgoRechazadoSgc)
                {
                    <div class="alert alert-danger mb-0">
                        Este hallazgo fue rechazado por SGC. Debe corregirse o reenviarse antes de continuar con el flujo.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(hallazgo.ComentarioRevisionSgc))
                {
                    <div class="comment-box mt-3">
                        <div class="comment-label">Comentario SGC</div>
                        <div>@hallazgo.ComentarioRevisionSgc</div>
                    </div>
                }
            </section>
        }

        <section class="hallazgo-grid hallazgo-grid-top">
            <div class="panel-card panel-wide">
                <div class="panel-head">
                    <div>
                        <h2>Descripción de la no conformidad</h2>
                        <p class="panel-subtitle">Detalle principal del hallazgo detectado.</p>
                    </div>
                </div>

                <div class="content-box">@hallazgo.Descripcion</div>

                @if (!string.IsNullOrWhiteSpace(hallazgo.JustificacionNoConformidad))
                {
                    <div class="section-divider"></div>

                    <div class="mini-section">
                        <div class="mini-section-label">Justificación de la no conformidad</div>
                        <div class="content-box subtle">@hallazgo.JustificacionNoConformidad</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(hallazgo.Evidencia))
                {
                    <div class="section-divider"></div>

                    <div class="mini-section">
                        <div class="mini-section-label">Evidencia inicial</div>
                        <div class="content-box subtle">@hallazgo.Evidencia</div>
                    </div>
                }
            </div>

            <div class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Participantes</h2>
                        <p class="panel-subtitle">Roles involucrados en el flujo del hallazgo.</p>
                    </div>
                </div>

                <div class="summary-stack">
                    <div class="summary-item">
                        <span>Responsable de cierre</span>
                        <strong>@MostrarPersona(hallazgo.ResponsableCierreId, "Sin asignar")</strong>
                    </div>

                    <div class="summary-item">
                        <span>Auditor principal</span>
                        <strong>@MostrarPersona(AuditorPrincipalId, "Sin asignar")</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SegundoAuditorId))
                    {
                        <div class="summary-item">
                            <span>Segundo auditor</span>
                            <strong>@MostrarPersona(SegundoAuditorId, "Sin asignar")</strong>
                        </div>
                    }

                    <div class="summary-item">
                        <span>Fecha creación</span>
                        <strong>@hallazgo.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</strong>
                    </div>

                    <div class="summary-item">
                        <span>Validación SGC</span>
                        <strong>@TextoValidacionSgc</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(hallazgo.RevisadoPorSgcId))
                    {
                        <div class="summary-item">
                            <span>Revisó SGC</span>
                            <strong>@MostrarPersona(hallazgo.RevisadoPorSgcId, "No registrado")</strong>
                        </div>
                    }

                    @if (hallazgo.FechaRevisionSgc.HasValue)
                    {
                        <div class="summary-item">
                            <span>Fecha revisión SGC</span>
                            <strong>@hallazgo.FechaRevisionSgc.Value.ToString("yyyy-MM-dd HH:mm")</strong>
                        </div>
                    }
                </div>

                @if (EsNcMenor)
                {
                    <div class="notice-box">
                        Para una NC Menor, primero debe capturarse y aprobarse el análisis de 5 porqués antes de subir la solución y evidencia.
                    </div>
                }
            </div>
        </section>

        @if (EsNcMenor && HallazgoLiberadoPorSgc)
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Estado del análisis 5 porqués</h2>
                        <p class="panel-subtitle">Seguimiento del flujo de análisis y aprobación.</p>
                    </div>

                    <span class="flow-pill @GetFlowClass(cincoPorQue?.Estatus)">
                        @(cincoPorQue?.Estatus ?? "Sin captura")
                    </span>
                </div>

                <div class="flow-grid">
                    <div class="flow-status-item">
                        <span>Captura responsable de cierre</span>
                        <strong>@(cincoPorQue is null ? "Pendiente" : "Registrada")</strong>
                    </div>

                    <div class="flow-status-item">
                        <span>Revisión SGC</span>
                        <strong>@(cincoPorQue is null ? "Pendiente" : cincoPorQue.Estatus)</strong>
                    </div>

                    <div class="flow-status-item">
                        <span>Solución / evidencia</span>
                        <strong>@(CincoPorQueAprobado ? "Habilitada" : "Bloqueada")</strong>
                    </div>
                </div>
            </section>

            <section class="hallazgo-grid hallazgo-grid-top">
                <div class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>5 Porqués</h2>
                            <p class="panel-subtitle">Captura o actualización del análisis causa raíz.</p>
                        </div>

                        <span class="flow-pill @GetFlowClass(cincoPorQue?.Estatus)">
                            @(cincoPorQue?.Estatus ?? "Pendiente")
                        </span>
                    </div>

                    @if (cincoPorQue is not null)
                    {
                        var accionesGuardadas = ObtenerAccionesGuardadas(cincoPorQue.Acciones);

                        <div class="why-list">
                            <div class="why-item"><span>1</span><div>@cincoPorQue.PorQue1</div></div>
                            <div class="why-item"><span>2</span><div>@cincoPorQue.PorQue2</div></div>
                            <div class="why-item"><span>3</span><div>@cincoPorQue.PorQue3</div></div>

                            @if (!string.IsNullOrWhiteSpace(cincoPorQue.PorQue4))
                            {
                                <div class="why-item"><span>4</span><div>@cincoPorQue.PorQue4</div></div>
                            }

                            @if (!string.IsNullOrWhiteSpace(cincoPorQue.PorQue5))
                            {
                                <div class="why-item"><span>5</span><div>@cincoPorQue.PorQue5</div></div>
                            }

                            @if (accionesGuardadas.Count > 0)
                            {
                                <div class="why-item why-item-acciones">
                                    <span>Acciones</span>
                                    <div class="acciones-registradas-list">
                                        @foreach (var accion in accionesGuardadas)
                                        {
                                            <div class="accion-registrada-card" @key="accion">
                                                <div><b>Acción:</b> @(string.IsNullOrWhiteSpace(accion.Accion) ? "—" : accion.Accion)</div>
                                                <div><b>Responsable:</b> @(string.IsNullOrWhiteSpace(accion.Responsable) ? "—" : MostrarPersona(accion.Responsable, "—"))</div>
                                                <div><b>Fecha:</b> @(accion.Fecha.HasValue? accion.Fecha.Value.ToString("yyyy-MM-dd") : "—")</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (!CincoPorQueAprobado)
                    {
                    @if (!UsuarioActualEsResponsableCierre)
                    {
                        <div class="alert alert-warning mt-3">
                            Solo el responsable de cierre puede capturar o actualizar los 5 porqués.
                        </div>
                    }

                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label">Usuario actual</label>
                            <input class="mo-form-control" value="@usuarioActualId" disabled />
                        </div>

                        <div class="col-12">
                            <label class="form-label">¿Por qué? 1</label>
                            <InputTextArea class="mo-form-control"
                                           rows="2"
                                           @bind-Value="vm5.PorQue1"
                                           disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">¿Por qué? 2</label>
                            <InputTextArea class="mo-form-control"
                                           rows="2"
                                           @bind-Value="vm5.PorQue2"
                                           disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">¿Por qué? 3</label>
                            <InputTextArea class="mo-form-control"
                                           rows="2"
                                           @bind-Value="vm5.PorQue3"
                                           disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">¿Por qué? 4 (opcional)</label>
                            <InputTextArea class="mo-form-control"
                                           rows="2"
                                           @bind-Value="vm5.PorQue4"
                                           disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">¿Por qué? 5 (opcional)</label>
                            <InputTextArea class="mo-form-control"
                                           rows="2"
                                           @bind-Value="vm5.PorQue5"
                                           disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                <label class="form-label mb-0">Acciones</label>

                                <button type="button"
                                        class="mo-btn mo-btn-primary-outline mo-btn-sm"
                                        @onclick="AgregarAccion5"
                                        disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)">
                                    Agregar acción
                                </button>
                            </div>

                            <div class="acciones-edit-list">
                                @foreach (var accion in vm5.Acciones)
                                {
                                    <div class="accion-edit-card" @key="accion">
                                        <div class="row g-3">
                                            <div class="col-12">
                                                <label class="form-label">Acción</label>
                                                <InputTextArea class="mo-form-control"
                                                               rows="2"
                                                               @bind-Value="accion.Accion"
                                                               disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Responsable</label>
                                                <input class="mo-form-control"
                                                       list="responsables-meax-list"
                                                       value="@GetResponsableDisplayTexto(accion)"
                                                       @oninput="e => OnResponsableInput(accion, e.Value?.ToString())"
                                                       placeholder="Buscar por nombre o usuario..."
                                                       disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Fecha</label>
                                                <InputDate TValue="DateTime?"
                                                           class="mo-form-control"
                                                           @bind-Value="accion.Fecha"
                                                           disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)" />
                                            </div>

                                            <div class="col-md-2 d-flex align-items-end">
                                                <button type="button"
                                                        class="mo-btn mo-btn-secondary-outline w-100"
                                                        @onclick="() => QuitarAccion5(accion)"
                                                        disabled="@(!UsuarioActualEsResponsableCierre || CincoPorQueAprobado)">
                                                    Quitar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <datalist id="responsables-meax-list">
                                @foreach (var u in usuariosDisponibles)
                                {
                                    <option value="@GetResponsableTexto(u)" />
                                }
                            </datalist>
                        </div>

                        <div class="col-12">
                            @if (!string.IsNullOrWhiteSpace(msg5))
                            {
                                <div class="alert alert-info mt-2">@msg5</div>
                            }

                            <button class="mo-btn mo-btn-primary"
                                    type="button"
                                    @onclick='@(async () => await GuardarCincoPorQue())'
                                    disabled="@(guardando || !UsuarioActualEsResponsableCierre || CincoPorQueAprobado)">
                                @(guardando ? "Guardando..." : (cincoPorQue is null ? "Guardar 5 porqués" : "Actualizar 5 porqués"))
                            </button>
                        </div>
                    </div>
                    }
                </div>

                <div class="panel-card">
                    <div class="panel-head">
                        <div>
                            <h2>Aprobación de 5 porqués</h2>
                            <p class="panel-subtitle">Revisión a cargo de SGC, desde la pantalla de Validación SGC.</p>
                        </div>
                    </div>

                    @if (cincoPorQue is null)
                    {
                        <div class="empty-state compact">
                            Primero debe capturarse el análisis de 5 porqués para habilitar la revisión.
                        </div>
                    }
                    else
                    {
                        <div class="review-summary">
                            <div class="summary-item">
                                <span>Estatus</span>
                                <strong>@cincoPorQue.Estatus</strong>
                            </div>

                            <div class="summary-item">
                                <span>Revisó SGC</span>
                                <strong>@MostrarPersona(cincoPorQue.RevisadoPorSgcId, "Pendiente")</strong>
                            </div>

                            @if (cincoPorQue.FechaRevisionSgc.HasValue)
                            {
                                <div class="summary-item">
                                    <span>Fecha de revisión</span>
                                    <strong>@cincoPorQue.FechaRevisionSgc.Value.ToString("yyyy-MM-dd HH:mm")</strong>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(cincoPorQue.ComentarioSgc))
                        {
                            <div class="comment-box">
                                <div class="comment-label">Comentario SGC</div>
                                <div>@cincoPorQue.ComentarioSgc</div>
                            </div>
                        }

                        @if (string.Equals(cincoPorQue.Estatus, "Pendiente", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="alert alert-info mt-3">
                                En espera de revisión por parte de SGC (pantalla Validación SGC).
                            </div>
                        }
                    }
                </div>
            </section>

        }
        else if (EsNcMenor)
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Flujo NC Menor bloqueado</h2>
                        <p class="panel-subtitle">El análisis de 5 porqués y la solución se habilitarán cuando SGC apruebe el hallazgo.</p>
                    </div>

                    <span class="flow-pill @GetFlowClass(hallazgo.EstatusValidacionSgc)">
                        @TextoValidacionSgc
                    </span>
                </div>

                <div class="empty-state compact">
                    Este hallazgo es NC Menor, pero todavía no ha sido liberado por SGC.
                </div>
            </section>
        }

        @if (HallazgoLiberadoPorSgc && (!EsNcMenor || CincoPorQueAprobado))
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Evidencia de la solución</h2>
                        <p class="panel-subtitle">Adjunta los archivos que respaldan la solución del hallazgo.</p>
                    </div>

                    <span class="flow-pill @(accionCorrectiva is not null ? "approved" : "blocked")">
                        @(accionCorrectiva is not null ? "Registrada" : "Pendiente")
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(evidenciaErrorMsg))
                {
                    <div class="alert alert-danger">@evidenciaErrorMsg</div>
                }

                @if (!UsuarioActualEsResponsableCierre)
                {
                    <div class="alert alert-warning mb-3">
                        Solo el responsable de cierre puede adjuntar evidencia de la solución.
                    </div>
                }

                @if (evidenciasHallazgo.Count == 0)
                {
                    <div class="empty-state compact">
                        Aún no se ha adjuntado evidencia.
                    </div>
                }
                else
                {
                    <div class="evidencia-list">
                        @foreach (var ev in evidenciasHallazgo)
                        {
                            <div class="evidencia-item" @key="ev.EvidenciaId">
                                <a href="@($"evidencias/{ev.EvidenciaId}")" target="_blank" class="evidencia-link">
                                    @ev.NombreOriginal
                                </a>
                                <span class="evidencia-meta">
                                    @ev.FechaCarga.ToString("yyyy-MM-dd HH:mm") · @MostrarPersona(ev.UsuarioId, ev.UsuarioId)
                                </span>

                                @if (UsuarioActualEsResponsableCierre && !HallazgoCerrado)
                                {
                                    <button type="button"
                                            class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                            @onclick="() => EliminarEvidencia(ev.EvidenciaId)"
                                            disabled="@subiendoEvidencia">
                                        Eliminar
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (UsuarioActualEsResponsableCierre)
                {
                    <div class="mt-3">
                        <label class="form-label">Adjuntar archivo(s)</label>
                        <InputFile OnChange="SubirEvidencias" multiple disabled="@subiendoEvidencia" />
                        <div class="field-help">Tamaño máximo por archivo: 20 MB.</div>

                        @if (subiendoEvidencia)
                        {
                            <div class="field-help">Subiendo...</div>
                        }
                    </div>
                }
            </section>
        }

        @if (string.Equals(hallazgo.Estatus, "Cerrado", StringComparison.OrdinalIgnoreCase))
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Hallazgo cerrado</h2>
                    </div>
                </div>

                <div class="empty-state compact">
                    Este hallazgo ya fue cerrado.
                </div>
            </section>
        }
        else if (HallazgoLiberadoPorSgc)
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Cerrar hallazgo</h2>
                        <p class="panel-subtitle">Marca el hallazgo como cerrado una vez implementada la solución.</p>
                    </div>
                </div>

                @if (!UsuarioActualEsResponsableCierre)
                {
                    <div class="alert alert-warning mb-0">
                        Solo el responsable de cierre puede cerrar el hallazgo.
                    </div>
                }
                else if (EsNcMenor && !CincoPorQueAprobado)
                {
                    <div class="empty-state compact">
                        No puedes cerrar una NC Menor hasta que los 5 porqués estén aprobados por SGC.
                    </div>
                }
                else
                {
                    <button class="mo-btn mo-btn-success"
                            type="button"
                            @onclick="CerrarHallazgo"
                            disabled="@guardando">
                        @(guardando ? "Guardando..." : "Cerrar hallazgo")
                    </button>
                }
            </section>
        }
    </div>
}

@code {
    [Parameter] public int auditoriaId { get; set; }
    [Parameter] public int hallazgoId { get; set; }

    private readonly Dictionary<string, string> personasDisplay = new(StringComparer.OrdinalIgnoreCase);

    private bool cargando = true;
    private bool guardando;
    private string? errorMsg;
    private string? msg5;

    private string usuarioActualId = "sistema";
    private string usuarioActualNombre = "sistema";

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    private Hallazgo? hallazgo;
    private HallazgoCincoPorQue? cincoPorQue;
    private AccionCorrectiva? accionCorrectiva;
    private List<MeaxAllUser> usuariosDisponibles = new();
    private List<Evidencia> evidenciasHallazgo = new();
    private bool subiendoEvidencia;
    private string? evidenciaErrorMsg;

    private CincoPorQueVm vm5 = new();

    private class AccionCincoPorQueVm
    {
        public string? Accion { get; set; }
        public string? Responsable { get; set; }
        public DateTime? Fecha { get; set; }
    }

    private class CincoPorQueVm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? PorQue1 { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? PorQue2 { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? PorQue3 { get; set; }

        public string? PorQue4 { get; set; }
        public string? PorQue5 { get; set; }

