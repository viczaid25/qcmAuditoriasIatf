@page "/auditorias/{auditoriaId:int}/hallazgos/{hallazgoId:int}/editar"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Catalogos
@using qcmAuditoriasIatf.Models.External
@using qcmAuditoriasIatf.Models.Hallazgos
@using qcmAuditoriasIatf.Services
@using System.Security.Claims
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject EmailService EmailSvc

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger">@errorMsg</div>
}

@if (!string.IsNullOrWhiteSpace(infoMsg))
{
    <div class="alert alert-info">@infoMsg</div>
}

@if (cargando)
{
    <div class="editar-loading">
        <div class="editar-skeleton"></div>
    </div>
}
else if (hallazgo is null)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">No se encontró el hallazgo</div>
            <button type="button" class="hero-btn primary mt-3" @onclick="Volver">
                Volver
            </button>
        </div>
    </section>
}
else if (!usuarioAutorizadoEditar)
{
    <section class="panel-card">
        <div class="empty-state">
            <div class="empty-title">Acceso restringido</div>
            <div class="empty-text">Solo el auditor principal o el segundo auditor del proceso pueden editar este hallazgo (cuando fue rechazado). SGC puede editar hallazgos ya aprobados.</div>
            <button type="button" class="hero-btn primary mt-3" @onclick="Volver">
                Volver
            </button>
        </div>
    </section>
}
else
{
    <div class="editar-page">
        <section class="editar-hero">
            <div>
                <span class="editar-kicker">@(modoSgc ? "Edición SGC de hallazgo aprobado" : "Editar hallazgo rechazado")</span>
                <h1>Hallazgo #@hallazgoId</h1>
                <p class="hero-text">
                    @(modoSgc
                        ? "Modifica los datos que necesites (por ejemplo, el responsable de cierre). La edición queda registrada en el historial del hallazgo con el detalle de lo que cambió."
                        : "Corrige la información y guarda los cambios. Cuando esté lista, reenvía el hallazgo a validación SGC.")
                </p>
            </div>

            <div class="hero-actions">
                <button type="button" class="hero-btn" @onclick="Volver" disabled="@guardando">
                    Volver
                </button>
            </div>
        </section>

        @if (!modoSgc && !string.IsNullOrWhiteSpace(hallazgo.ComentarioRevisionSgc))
        {
            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Motivo del rechazo</h2>
                    </div>
                </div>
                <div class="content-box">@hallazgo.ComentarioRevisionSgc</div>
            </section>
        }

        <EditForm Model="vm" OnValidSubmit="GuardarCambios">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <section class="panel-card">
                <div class="panel-head">
                    <div>
                        <h2>Datos del hallazgo</h2>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Cláusula de la norma aplicable</label>
                        <InputText class="mo-form-control" @bind-Value="vm.ClausulaAplicable" placeholder="Ej. 8.5.1.1, 9.1.1..." />
                        <div class="field-help">Opcional. Indica a qué cláusula de la norma está dirigido este hallazgo.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Fecha compromiso</label>
                        <InputDate class="mo-form-control" @bind-Value="vm.FechaCompromiso" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tipo de hallazgo</label>
                        <InputSelect class="mo-form-select" @bind-Value="vm.TipoHallazgoId">
                            <option value="0">-- Selecciona --</option>
                            @foreach (var t in tiposHallazgo)
                            {
                                <option value="@t.TipoHallazgoId">@t.Nombre</option>
                            }
                        </InputSelect>

                        @if (modoSgc)
                        {
                            <div class="field-help">Cambiar el tipo después de la aprobación puede afectar el flujo (por ejemplo, los 5 porqués de una NC Menor).</div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Responsable de finalizar el hallazgo</label>
                        <InputSelect class="mo-form-select" @bind-Value="vm.ResponsableCierreId">
                            <option value="">-- Selecciona --</option>
                            @foreach (var u in usuariosDisponibles)
                            {
                                <option value="@u.pc_login_id">@GetResponsableTexto(u)</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descripción de la No Conformidad</label>
                        <InputTextArea class="mo-form-control" @bind-Value="vm.Descripcion" rows="4" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Evidencia</label>
                        <InputTextArea class="mo-form-control" @bind-Value="vm.Evidencia" rows="4" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Justificación de la No Conformidad</label>
                        <InputTextArea class="mo-form-control" @bind-Value="vm.JustificacionNoConformidad" rows="4" />
                    </div>
                </div>
            </section>

            <section class="panel-card action-panel">
                <div class="action-panel-inner">
                    <div>
                        <h2>Acciones</h2>
                        <p class="panel-subtitle mb-0">
                            @(modoSgc
                                ? "Guarda los cambios. Quedarán registrados en el historial de ediciones del hallazgo."
                                : "Guarda los cambios y, cuando esté listo, reenvía el hallazgo a validación SGC.")
                        </p>
                    </div>

                    <div class="action-buttons">
                        <button class="mo-btn mo-btn-primary" type="submit" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar cambios")
                        </button>

                        @if (!modoSgc)
                        {
                            <button class="mo-btn mo-btn-success" type="button" @onclick="ReenviarAValidacion" disabled="@guardando">
                                @(guardando ? "Guardando..." : "Reenviar a validación")
                            </button>
                        }
                    </div>
                </div>
            </section>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int auditoriaId { get; set; }
    [Parameter] public int hallazgoId { get; set; }

    private bool cargando = true;
    private bool guardando;
    private string? errorMsg;
    private string? infoMsg;

    private string usuarioActualId = "sistema";
    private bool usuarioAutorizadoEditar;
    private bool usuarioEsSgc;
    private bool modoSgc;

    private Hallazgo? hallazgo;
    private List<TipoHallazgo> tiposHallazgo = new();
    private List<MeaxAllUser> usuariosDisponibles = new();

    private Vm vm = new();
    private Vm original = new();

    private class Vm
    {
        public int TipoHallazgoId { get; set; }
        public DateTime FechaCompromiso { get; set; } = DateTime.Today;
        public string? ResponsableCierreId { get; set; }
        public string? Descripcion { get; set; }
        public string? Evidencia { get; set; }
        public string? JustificacionNoConformidad { get; set; }
        public string? ClausulaAplicable { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        errorMsg = null;
        infoMsg = null;

        await CargarUsuarioActual();
        await CargarPantalla();

        cargando = false;
    }

    private async Task CargarUsuarioActual()
    {
        usuarioActualId = "sistema";

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                usuarioActualId =
                    user.FindFirst("pc_login_id")?.Value
                    ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                    ?? user.Identity?.Name
                    ?? "sistema";
            }
        }
        catch
        {
            usuarioActualId = "sistema";
        }

        var loginNormalizado = NormalizarLogin(usuarioActualId);

        usuarioEsSgc = await Db.UsuariosPerfil
            .AsNoTracking()
            .AnyAsync(x =>
                x.Activo &&
                x.PcLoginId.ToUpper() == loginNormalizado &&
                (x.Perfil == "SGC" || x.Perfil == "Administrador"));
    }

    private async Task CargarPantalla()
    {
        Db.ChangeTracker.Clear();

        hallazgo = await Db.Hallazgos
            .Include(h => h.AuditoriaProceso)
            .FirstOrDefaultAsync(h => h.HallazgoId == hallazgoId && h.AuditoriaId == auditoriaId);

        if (hallazgo is null)
            return;

        var esAuditorPrincipal =
            !string.IsNullOrWhiteSpace(hallazgo.AuditoriaProceso?.AuditorAsignadoId) &&
            NormalizarLogin(usuarioActualId) == NormalizarLogin(hallazgo.AuditoriaProceso.AuditorAsignadoId);

        var esSegundoAuditor =
            !string.IsNullOrWhiteSpace(hallazgo.AuditoriaProceso?.SegundoAuditorId) &&
            NormalizarLogin(usuarioActualId) == NormalizarLogin(hallazgo.AuditoriaProceso.SegundoAuditorId);

        // SGC puede editar un hallazgo ya aprobado (p. ej. cambiar al responsable de cierre);
        // el auditor principal/segundo solo lo corrige cuando fue rechazado.
        var hallazgoAprobado =
            string.IsNullOrWhiteSpace(hallazgo.EstatusValidacionSgc) ||
            string.Equals(hallazgo.EstatusValidacionSgc, "Aprobado", StringComparison.OrdinalIgnoreCase);

        modoSgc = usuarioEsSgc && hallazgoAprobado;
        usuarioAutorizadoEditar = modoSgc || esAuditorPrincipal || esSegundoAuditor;

        if (!usuarioAutorizadoEditar)
            return;

        vm = new Vm
        {
            TipoHallazgoId = hallazgo.TipoHallazgoId,
            FechaCompromiso = hallazgo.FechaCompromiso,
            ResponsableCierreId = hallazgo.ResponsableCierreId,
            Descripcion = hallazgo.Descripcion,
            Evidencia = hallazgo.Evidencia,
            JustificacionNoConformidad = hallazgo.JustificacionNoConformidad,
            ClausulaAplicable = hallazgo.ClausulaAplicable
        };

        original = new Vm
        {
            TipoHallazgoId = vm.TipoHallazgoId,
            FechaCompromiso = vm.FechaCompromiso,
            ResponsableCierreId = vm.ResponsableCierreId,
            Descripcion = vm.Descripcion,
            Evidencia = vm.Evidencia,
            JustificacionNoConformidad = vm.JustificacionNoConformidad,
            ClausulaAplicable = vm.ClausulaAplicable
        };

        tiposHallazgo = await Db.TiposHallazgo
            .OrderBy(x => x.Severidad)
            .ThenBy(x => x.Nombre)
            .ToListAsync();

        usuariosDisponibles = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x => !string.IsNullOrWhiteSpace(x.pc_login_id))
            .OrderBy(x => x.username ?? x.pc_login_id)
            .ToListAsync();
    }

    private static string NormalizarLogin(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return string.Empty;

        var v = valor.Trim();

        if (v.Contains("\\"))
            v = v[(v.LastIndexOf('\\') + 1)..];

        if (v.Contains("@"))
            v = v[..v.IndexOf('@')];

        return v.Trim().ToUpperInvariant();
    }

    private string GetResponsableTexto(MeaxAllUser u)
    {
        var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username;
        var depto = string.IsNullOrWhiteSpace(u.department) ? "" : $" - {u.department}";
        return $"{nombre} ({u.pc_login_id}){depto}";
    }

    private bool Validar()
    {
        if (vm.TipoHallazgoId == 0)
        {
            errorMsg = "Selecciona un tipo de hallazgo.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(vm.Descripcion))
        {
            errorMsg = "La descripción de la no conformidad es obligatoria.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(vm.Evidencia))
        {
            errorMsg = "La evidencia es obligatoria.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(vm.JustificacionNoConformidad))
        {
            errorMsg = "La justificación de la no conformidad es obligatoria.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(vm.ResponsableCierreId))
        {
            errorMsg = "El responsable de finalizar el hallazgo es obligatorio.";
            return false;
        }

        return true;
    }

    private async Task GuardarCambios()
    {
        if (guardando) return;
        errorMsg = null;
        infoMsg = null;

        if (!Validar())
            return;

        if (modoSgc)
        {
            await GuardarComoSgc();
            return;
        }

        guardando = true;

        try
        {
            var entity = await Db.Hallazgos.FirstOrDefaultAsync(h => h.HallazgoId == hallazgoId && h.AuditoriaId == auditoriaId);

            if (entity is null)
            {
                errorMsg = "No se encontró el hallazgo.";
                return;
            }

            entity.TipoHallazgoId = vm.TipoHallazgoId;
            entity.FechaCompromiso = vm.FechaCompromiso;
            entity.ResponsableCierreId = vm.ResponsableCierreId!.Trim();
            entity.Descripcion = vm.Descripcion!.Trim();
            entity.Evidencia = vm.Evidencia!.Trim();
            entity.JustificacionNoConformidad = string.IsNullOrWhiteSpace(vm.JustificacionNoConformidad) ? null : vm.JustificacionNoConformidad.Trim();
            entity.ClausulaAplicable = string.IsNullOrWhiteSpace(vm.ClausulaAplicable) ? null : vm.ClausulaAplicable.Trim();

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = entity.HallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = "El auditor principal o segundo auditor editó el hallazgo rechazado."
            });

            await Db.SaveChangesAsync();
            await CargarPantalla();

            errorMsg = null;
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarComoSgc()
    {
        guardando = true;

        try
        {
            var entity = await Db.Hallazgos.FirstOrDefaultAsync(h => h.HallazgoId == hallazgoId && h.AuditoriaId == auditoriaId);

            if (entity is null)
            {
                errorMsg = "No se encontró el hallazgo.";
                return;
            }

            if (string.Equals(entity.EstatusValidacionSgc, "Pendiente", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(entity.EstatusValidacionSgc, "Rechazado", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Este hallazgo ya no está aprobado.";
                return;
            }

            var cambios = CalcularCambios();

            if (cambios.Count == 0)
            {
                infoMsg = "No hay cambios por guardar.";
                return;
            }

            entity.TipoHallazgoId = vm.TipoHallazgoId;
            entity.FechaCompromiso = vm.FechaCompromiso;
            entity.ResponsableCierreId = vm.ResponsableCierreId!.Trim();
            entity.Descripcion = vm.Descripcion!.Trim();
            entity.Evidencia = vm.Evidencia!.Trim();
            entity.JustificacionNoConformidad = string.IsNullOrWhiteSpace(vm.JustificacionNoConformidad) ? null : vm.JustificacionNoConformidad.Trim();
            entity.ClausulaAplicable = string.IsNullOrWhiteSpace(vm.ClausulaAplicable) ? null : vm.ClausulaAplicable.Trim();

            var comentario = HallazgoSeguimiento.PrefijoEdicionSgc + "\n" + string.Join("\n", cambios);

            if (comentario.Length > 2000)
                comentario = comentario[..1999] + "…";

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = entity.HallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = comentario
            });

            await Db.SaveChangesAsync();

            Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{hallazgoId}");
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private List<string> CalcularCambios()
    {
        var cambios = new List<string>();

        void CompararTexto(string campo, string? antes, string? despues)
        {
            var a = antes?.Trim() ?? "";
            var d = despues?.Trim() ?? "";

            if (!string.Equals(a, d, StringComparison.Ordinal))
                cambios.Add($"{campo}: {ResumirTexto(a)} → {ResumirTexto(d)}");
        }

        if (original.TipoHallazgoId != vm.TipoHallazgoId)
            cambios.Add($"Tipo de hallazgo: {NombreTipo(original.TipoHallazgoId)} → {NombreTipo(vm.TipoHallazgoId)}");

        if (original.FechaCompromiso.Date != vm.FechaCompromiso.Date)
            cambios.Add($"Fecha compromiso: {original.FechaCompromiso:yyyy-MM-dd} → {vm.FechaCompromiso:yyyy-MM-dd}");

        if (!string.Equals(original.ResponsableCierreId?.Trim() ?? "", vm.ResponsableCierreId?.Trim() ?? "", StringComparison.OrdinalIgnoreCase))
            cambios.Add($"Responsable de cierre: {NombrePersona(original.ResponsableCierreId)} → {NombrePersona(vm.ResponsableCierreId)}");

        CompararTexto("Cláusula aplicable", original.ClausulaAplicable, vm.ClausulaAplicable);
        CompararTexto("Descripción", original.Descripcion, vm.Descripcion);
        CompararTexto("Evidencia", original.Evidencia, vm.Evidencia);
        CompararTexto("Justificación", original.JustificacionNoConformidad, vm.JustificacionNoConformidad);

        return cambios;
    }

    private string NombreTipo(int tipoId) =>
        tiposHallazgo.FirstOrDefault(t => t.TipoHallazgoId == tipoId)?.Nombre ?? "Sin tipo";

    private string NombrePersona(string? login)
    {
        if (string.IsNullOrWhiteSpace(login))
            return "Sin asignar";

        var u = usuariosDisponibles.FirstOrDefault(x =>
            string.Equals(x.pc_login_id, login.Trim(), StringComparison.OrdinalIgnoreCase));

        if (u is null)
            return login.Trim();

        var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username;
        return $"{nombre} ({u.pc_login_id})";
    }

    private static string ResumirTexto(string valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return "(vacío)";

        var limpio = string.Join(" ", valor.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return limpio.Length <= 150 ? $"«{limpio}»" : $"«{limpio[..150]}…»";
    }

    private async Task ReenviarAValidacion()
    {
        if (guardando) return;
        errorMsg = null;

        if (!Validar())
            return;

        guardando = true;

        try
        {
            var entity = await Db.Hallazgos
                .Include(h => h.AuditoriaProceso)
                .FirstOrDefaultAsync(h => h.HallazgoId == hallazgoId && h.AuditoriaId == auditoriaId);

            if (entity is null)
            {
                errorMsg = "No se encontró el hallazgo.";
                return;
            }

            if (!string.Equals(entity.EstatusValidacionSgc, "Rechazado", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Este hallazgo ya no está rechazado.";
                return;
            }

            entity.TipoHallazgoId = vm.TipoHallazgoId;
            entity.FechaCompromiso = vm.FechaCompromiso;
            entity.ResponsableCierreId = vm.ResponsableCierreId!.Trim();
            entity.Descripcion = vm.Descripcion!.Trim();
            entity.Evidencia = vm.Evidencia!.Trim();
            entity.JustificacionNoConformidad = string.IsNullOrWhiteSpace(vm.JustificacionNoConformidad) ? null : vm.JustificacionNoConformidad.Trim();
            entity.ClausulaAplicable = string.IsNullOrWhiteSpace(vm.ClausulaAplicable) ? null : vm.ClausulaAplicable.Trim();

            entity.EstatusValidacionSgc = "Pendiente";
            entity.Estatus = "Pendiente SGC";

            Db.HallazgoSeguimientos.Add(new HallazgoSeguimiento
            {
                HallazgoId = entity.HallazgoId,
                UsuarioId = usuarioActualId,
                Comentario = "El auditor principal o segundo auditor reenvió el hallazgo a validación SGC.",
                EstatusNuevo = entity.Estatus
            });

            await Db.SaveChangesAsync();
            await NotificarReenvioAsync();

            Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{hallazgoId}");
        }
        catch (Exception ex)
        {
            errorMsg = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task NotificarReenvioAsync()
    {
        try
        {
            await EmailSvc.NotificarAsync(new[] { EmailService.QmsEmail });
        }
        catch
        {
            // El envío de correo no debe bloquear el reenvío del hallazgo.
        }
    }

    private void Volver() => Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{hallazgoId}");
}
