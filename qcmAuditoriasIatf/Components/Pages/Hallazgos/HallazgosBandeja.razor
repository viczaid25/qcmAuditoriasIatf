@page "/auditorias/{auditoriaId:int}/hallazgos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using qcmAuditoriasIatf.Models.Auditorias
@using qcmAuditoriasIatf.Models.Catalogos
@using qcmAuditoriasIatf.Models.Hallazgos
@inject qcmAuditoriasIatf.Data.ApplicationDbContext Db
@inject NavigationManager Nav

@attribute [Authorize]

@if (!string.IsNullOrWhiteSpace(errorMsg))
{
    <div class="alert alert-danger" style="white-space:pre-wrap">@errorMsg</div>
}

@if (cargando)
{
    <div class="bandeja-loading">
        <div class="bandeja-skeleton bandeja-skeleton-hero"></div>
        <div class="bandeja-metrics">
            <div class="bandeja-skeleton bandeja-skeleton-card"></div>
            <div class="bandeja-skeleton bandeja-skeleton-card"></div>
            <div class="bandeja-skeleton bandeja-skeleton-card"></div>
            <div class="bandeja-skeleton bandeja-skeleton-card"></div>
            <div class="bandeja-skeleton bandeja-skeleton-card"></div>
            <div class="bandeja-skeleton bandeja-skeleton-card"></div>
        </div>
        <div class="bandeja-skeleton bandeja-skeleton-filters"></div>
        <div class="bandeja-skeleton bandeja-skeleton-table"></div>
    </div>
}
else
{
    <div class="bandeja-page">
        <section class="bandeja-hero">
            <div>
                <span class="bandeja-kicker">Hallazgos de auditoría</span>
                <h1>Hallazgos · Auditoría #@auditoriaId</h1>

                @if (!string.IsNullOrWhiteSpace(auditoriaTitulo))
                {
                    <div class="bandeja-meta">
                        <span class="meta-chip">@auditoriaTitulo</span>
                    </div>
                }

                <p class="hero-text">
                    Consulta el avance de validación SGC, responsables y estatus operativo de cada hallazgo registrado en la auditoría.
                </p>
            </div>

            <div class="hero-actions">
                <button type="button"
                        class="hero-btn primary"
                        @onclick='() => Nav.NavigateTo($"auditorias/{auditoriaId}")'>
                    Volver a auditoría
                </button>
            </div>
        </section>

        <section class="bandeja-metrics">
            <div class="metric-card">
                <div class="metric-label">Total</div>
                <div class="metric-value">@total</div>
                <div class="metric-note">Hallazgos de la auditoría</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Pendiente SGC</div>
                <div class="metric-value">@pendientesSgc</div>
                <div class="metric-note">Esperando validación</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Aprobados SGC</div>
                <div class="metric-value">@aprobadosSgc</div>
                <div class="metric-note">Liberados al flujo</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Rechazados SGC</div>
                <div class="metric-value">@rechazadosSgc</div>
                <div class="metric-note">Con observaciones</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Abiertos</div>
                <div class="metric-value">@abiertos</div>
                <div class="metric-note">En operación o seguimiento</div>
            </div>

            <div class="metric-card">
                <div class="metric-label">Cerrados</div>
                <div class="metric-value">@cerrados</div>
                <div class="metric-note">Ya finalizados</div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Filtros</h2>
                    <p class="panel-subtitle">Refina la vista por proceso, validación SGC, estatus o texto.</p>
                </div>

                <span class="panel-badge">Mostrando @hallazgos.Count</span>
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Proceso</label>
                    <InputSelect class="mo-form-select" @bind-Value="procesoIdSeleccionado">
                        <option value="0">-- Todos --</option>
                        @foreach (var p in procesosFiltro)
                        {
                            <option value="@p.ProcesoId">@p.Codigo - @p.Nombre</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Validación SGC</label>
                    <InputSelect class="mo-form-select" @bind-Value="validacionSeleccionada">
                        <option value="">-- Todas --</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Aprobado">Aprobado</option>
                        <option value="Rechazado">Rechazado</option>
                        <option value="__sin__">No registrada</option>
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Estatus operativo</label>
                    <InputSelect class="mo-form-select" @bind-Value="estatusSeleccionado">
                        <option value="">-- Todos --</option>
                        <option value="Pendiente SGC">Pendiente SGC</option>
                        <option value="Abierto">Abierto</option>
                        <option value="En Proceso">En Proceso</option>
                        <option value="Cerrado">Cerrado</option>
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Buscar</label>
                    <InputText class="mo-form-control" @bind-Value="textoBusqueda" />
                </div>

                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button type="button" class="mo-btn mo-btn-primary" @onclick="AplicarFiltros">
                        Aplicar filtros
                    </button>

                    <button type="button" class="mo-btn mo-btn-secondary-outline" @onclick="LimpiarFiltros">
                        Limpiar
                    </button>
                </div>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div>
                    <h2>Bandeja de hallazgos</h2>
                    <p class="panel-subtitle">Estado actual del flujo de validación SGC y seguimiento operativo.</p>
                </div>

                <span class="panel-badge">@hallazgos.Count registro(s)</span>
            </div>

            @if (hallazgos.Count == 0)
            {
                <div class="empty-state compact">
                    No hay hallazgos para los filtros seleccionados.
                </div>
            }
            else
            {
                <div class="mo-table-wrap" data-mo-table data-page-size="10">
                        <table class="mo-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Proceso</th>
                                <th>Tipo</th>
                                <th>Descripción</th>
                                <th>Responsables</th>
                                <th>Fechas</th>
                                <th>Estatus</th>
                                <th class="text-end">Acción</th>
                            </tr>
                            <tr class="mo-table-filter-row">
                                <th><input class="mo-th-filter" data-mo-filter-col="0" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="1" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="2" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="3" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="4" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="5" placeholder="Filtrar…"></th>
                                <th><input class="mo-th-filter" data-mo-filter-col="6" placeholder="Filtrar…"></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in hallazgos)
                            {
                                <tr @key="h.HallazgoId">
                                    <td>
                                        <div class="id-pill">#@h.HallazgoId</div>
                                        <div class="cell-subtitle">@TextoClausula(h)</div>
                                    </td>

                                    <td>
                                        <div class="cell-title">@TextoProceso(h)</div>
                                    </td>

                                    <td>
                                        <span class="tipo-pill @GetTipoClass(h.TipoHallazgo?.Nombre)">
                                            @(h.TipoHallazgo?.Nombre ?? "Sin tipo")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="desc-cell">@h.Descripcion</div>

                                        @if (!string.IsNullOrWhiteSpace(h.JustificacionNoConformidad))
                                        {
                                            <div class="evidencia-box">
                                                <div class="mini-label">Justificación de la NC</div>
                                                <div>@h.JustificacionNoConformidad</div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(h.Evidencia))
                                        {
                                            <div class="evidencia-box">
                                                <div class="mini-label">Evidencia inicial</div>
                                                <div>@h.Evidencia</div>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="team-stack">
                                            <div>
                                                <span class="team-label">Responsable:</span>
                                                <span class="team-value">@MostrarPersona(h.ResponsableId)</span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(h.ResponsableCierreId))
                                            {
                                                <div>
                                                    <span class="team-label">Cierre:</span>
                                                    <span class="team-value">@MostrarPersona(h.ResponsableCierreId)</span>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(h.CreadoPorId))
                                            {
                                                <div>
                                                    <span class="team-label">Creado por:</span>
                                                    <span class="team-value">@MostrarPersona(h.CreadoPorId, "No registrado")</span>
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <div class="cell-title">Compromiso: @h.FechaCompromiso.ToString("yyyy-MM-dd")</div>

                                        @if (h.FechaCreacion != default)
                                        {
                                            <div class="cell-subtitle">Creación: @h.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</div>
                                        }

                                        @if (h.FechaRevisionSgc.HasValue)
                                        {
                                            <div class="cell-subtitle">Revisión SGC: @h.FechaRevisionSgc.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                        }
                                    </td>

                                    <td>
                                        <div class="status-stack">
                                            <span class="validacion-pill @GetValidacionClass(h.EstatusValidacionSgc)">
                                                @TextoValidacion(h)
                                            </span>

                                            <span class="status-pill @GetStatusClass(h.Estatus)">
                                                @h.Estatus
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(h.ComentarioRevisionSgc))
                                        {
                                            <div class="comment-box-mini">
                                                <div class="mini-label">Comentario SGC</div>
                                                <div>@h.ComentarioRevisionSgc</div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(h.RevisadoPorSgcId))
                                        {
                                            <div class="cell-subtitle mt-1">
                                                Revisó SGC: @MostrarPersona(h.RevisadoPorSgcId, "No registrado")
                                            </div>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button type="button"
                                                class="table-btn"
                                                @onclick='() => Nav.NavigateTo($"auditorias/{auditoriaId}/hallazgos/{h.HallazgoId}")'>
                                            Ver detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        </table>
                </div>
                <div class="mo-table-pagination" data-mo-pagination></div>
            }
        </section>
    </div>
}

@code {
    [Parameter] public int auditoriaId { get; set; }

    private readonly Dictionary<string, string> personasDisplay = new(StringComparer.OrdinalIgnoreCase);

    private bool cargando = true;
    private string? errorMsg;

    private string? auditoriaTitulo;

    private int procesoIdSeleccionado = 0;
    private string validacionSeleccionada = "";
    private string estatusSeleccionado = "";
    private string textoBusqueda = "";

    private int total;
    private int abiertos;
    private int cerrados;
    private int pendientesSgc;
    private int aprobadosSgc;
    private int rechazadosSgc;

    private List<Proceso> procesosFiltro = new();
    private List<Hallazgo> hallazgos = new();

    protected override async Task OnParametersSetAsync()
    {
        await CargarTodo();
    }

    private async Task CargarTodo()
    {
        cargando = true;
        errorMsg = null;

        try
        {
            var aud = await Db.Auditorias
                .AsNoTracking()
                .FirstOrDefaultAsync(a => a.AuditoriaId == auditoriaId);

            auditoriaTitulo = aud is null
                ? null
                : $"{aud.TipoAuditoria} | {aud.FechaInicio:yyyy-MM-dd} a {aud.FechaFin:yyyy-MM-dd}";

            var procesoIds = await Db.AuditoriaProcesos
                .Where(ap => ap.AuditoriaId == auditoriaId)
                .Select(ap => ap.ProcesoId)
                .Distinct()
                .ToListAsync();

            procesosFiltro = await Db.Procesos
                .Where(p => procesoIds.Contains(p.ProcesoId))
                .OrderBy(p => p.Codigo)
                .ToListAsync();

            await CargarResumen();
            await CargarHallazgos();
        }
        catch (Exception ex)
        {
            errorMsg = ex.ToString();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarResumen()
    {
        var stats = await Db.Hallazgos
            .Where(h => h.AuditoriaId == auditoriaId)
            .GroupBy(h => 1)
            .Select(g => new
            {
                Total = g.Count(),
                PendientesSgc = g.Count(h => h.EstatusValidacionSgc == "Pendiente"),
                AprobadosSgc = g.Count(h => h.EstatusValidacionSgc == "Aprobado"),
                RechazadosSgc = g.Count(h => h.EstatusValidacionSgc == "Rechazado"),
                Cerrados = g.Count(h => h.Estatus == "Cerrado"),
                Abiertos = g.Count(h => h.Estatus == "Abierto" || h.Estatus == "En Proceso")
            })
            .FirstOrDefaultAsync();

        total = stats?.Total ?? 0;
        pendientesSgc = stats?.PendientesSgc ?? 0;
        aprobadosSgc = stats?.AprobadosSgc ?? 0;
        rechazadosSgc = stats?.RechazadosSgc ?? 0;
        cerrados = stats?.Cerrados ?? 0;
        abiertos = stats?.Abiertos ?? 0;
    }

    private async Task CargarHallazgos()
    {
        var q = Db.Hallazgos
            .Include(h => h.Proceso)
            .Include(h => h.Clausula)
            .Include(h => h.TipoHallazgo)
            .Where(h => h.AuditoriaId == auditoriaId);

        if (procesoIdSeleccionado > 0)
            q = q.Where(h => h.ProcesoId == procesoIdSeleccionado);

        if (!string.IsNullOrWhiteSpace(validacionSeleccionada))
        {
            if (validacionSeleccionada == "__sin__")
            {
                q = q.Where(h => string.IsNullOrEmpty(h.EstatusValidacionSgc));
            }
            else
            {
                q = q.Where(h => h.EstatusValidacionSgc == validacionSeleccionada);
            }
        }

        if (!string.IsNullOrWhiteSpace(estatusSeleccionado))
            q = q.Where(h => h.Estatus == estatusSeleccionado);

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var texto = textoBusqueda.Trim();

            q = q.Where(h =>
                h.Descripcion.Contains(texto) ||
                (h.JustificacionNoConformidad != null && h.JustificacionNoConformidad.Contains(texto)) ||
                (h.Evidencia != null && h.Evidencia.Contains(texto)) ||
                (h.ComentarioRevisionSgc != null && h.ComentarioRevisionSgc.Contains(texto)) ||
                h.ResponsableId.Contains(texto) ||
                (h.ResponsableCierreId != null && h.ResponsableCierreId.Contains(texto)) ||
                (h.CreadoPorId != null && h.CreadoPorId.Contains(texto)) ||
                (h.RevisadoPorSgcId != null && h.RevisadoPorSgcId.Contains(texto)));
        }

        hallazgos = await q
            .OrderBy(h => h.EstatusValidacionSgc == "Pendiente" ? 0 : h.EstatusValidacionSgc == "Rechazado" ? 1 : 2)
            .ThenByDescending(h => h.HallazgoId)
            .ToListAsync();

        await CargarPersonasDisplay(
            hallazgos.SelectMany(h => new string?[]
            {
                h.ResponsableId,
                h.ResponsableCierreId,
                h.CreadoPorId,
                h.RevisadoPorSgcId
            }));
    }

    private async Task AplicarFiltros()
    {
        await CargarHallazgos();
    }

    private async Task LimpiarFiltros()
    {
        procesoIdSeleccionado = 0;
        validacionSeleccionada = "";
        estatusSeleccionado = "";
        textoBusqueda = "";
        await CargarHallazgos();
    }

    private static string TextoProceso(Hallazgo h) =>
        h.Proceso is null
            ? "Sin proceso"
            : $"{h.Proceso.Codigo} - {h.Proceso.Nombre}";

    private static string TextoClausula(Hallazgo h) =>
        h.Clausula is null
            ? "Sin cláusula"
            : $"Cláusula: {h.Clausula.Codigo}";

    private static string TextoValidacion(Hallazgo h) =>
        string.IsNullOrWhiteSpace(h.EstatusValidacionSgc)
            ? "No registrada"
            : h.EstatusValidacionSgc;

    private static string GetTipoClass(string? tipo)
    {
        var valor = tipo?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor.Contains("mayor"))
            return "major";

        if (valor.Contains("menor"))
            return "minor";

        return "neutral";
    }

    private static string GetValidacionClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor == "aprobado")
            return "approved";

        if (valor == "rechazado")
            return "rejected";

        if (valor == "pendiente")
            return "pending";

        return "neutral";
    }

    private static string GetStatusClass(string? estatus)
    {
        var valor = estatus?.Trim().ToLowerInvariant() ?? string.Empty;

        if (valor is "cerrado" or "cerrada")
            return "closed";

        if (valor is "en proceso" or "en revisión" or "en revision")
            return "progress";

        if (valor is "pendiente sgc")
            return "blocked";

        return "open";
    }

    private async Task CargarPersonasDisplay(IEnumerable<string?> valores)
    {
        personasDisplay.Clear();

        var ids = valores
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (ids.Count == 0)
            return;

        var auditores = await Db.Auditores
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.PcLoginId) && ids.Contains(x.PcLoginId)) ||
                ids.Contains(x.Nombre))
            .ToListAsync();

        foreach (var a in auditores)
        {
            var display = !string.IsNullOrWhiteSpace(a.PcLoginId) &&
                          !string.Equals(a.Nombre.Trim(), a.PcLoginId.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{a.Nombre} ({a.PcLoginId})"
                : a.Nombre;

            if (!string.IsNullOrWhiteSpace(a.PcLoginId))
                personasDisplay[a.PcLoginId.Trim()] = display;

            personasDisplay[a.Nombre.Trim()] = display;
        }

        var faltantes = ids
            .Where(x => !personasDisplay.ContainsKey(x))
            .ToList();

        if (faltantes.Count == 0)
            return;

        var usuarios = await Db.MeaxAllUsers
            .AsNoTracking()
            .Where(x =>
                (!string.IsNullOrWhiteSpace(x.pc_login_id) && faltantes.Contains(x.pc_login_id)) ||
                (!string.IsNullOrWhiteSpace(x.username) && faltantes.Contains(x.username)))
            .ToListAsync();

        foreach (var u in usuarios)
        {
            var nombre = string.IsNullOrWhiteSpace(u.username) ? u.pc_login_id : u.username!;
            var display = !string.IsNullOrWhiteSpace(u.pc_login_id) &&
                          !string.Equals(nombre.Trim(), u.pc_login_id.Trim(), StringComparison.OrdinalIgnoreCase)
                ? $"{nombre} ({u.pc_login_id})"
                : nombre;

            if (!string.IsNullOrWhiteSpace(u.pc_login_id))
                personasDisplay[u.pc_login_id.Trim()] = display;

            if (!string.IsNullOrWhiteSpace(u.username))
                personasDisplay[u.username.Trim()] = display;
        }

        foreach (var id in ids)
        {
            if (!personasDisplay.ContainsKey(id))
                personasDisplay[id] = id;
        }
    }

    private string MostrarPersona(string? valor, string fallback = "Sin asignar")
    {
        if (string.IsNullOrWhiteSpace(valor))
            return fallback;

        var clave = valor.Trim();
        return personasDisplay.TryGetValue(clave, out var nombre) ? nombre : clave;
    }
}